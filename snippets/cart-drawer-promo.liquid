{%- doc -%}
  @param {object} section - the cart drawer section
  @param {number} tier_2_amount - the 5% threshold in cents, 0 when the customer
                                  is not eligible or the setting is unset
  @param {boolean} tier_2_reached
  @param {boolean} first_order_eligible

  Free shipping has no threshold, so it is not a milestone: it is a standing
  confirmation line above the bar. The bar itself has exactly one goal, the
  first-order discount, and is omitted entirely for returning customers.
{%- enddoc -%}

{%- if section.settings.show_promo_bar -%}
  <div class="cart-drawer-promo cart-drawer-promo--unlocked">
    {%- if section.settings.promo_always_text != blank -%}
      <p class="cart-drawer-promo__message">
        {%- if section.settings.promo_icon != blank -%}
          {{-
            section.settings.promo_icon
            | image_url: width: 96
            | image_tag: alt: '', widths: '24,48,96', class: 'cart-drawer-promo__logo', loading: 'lazy'
          -}}
        {%- else -%}
          {%- render 'icon' with 'success', width: 12, class: 'cart-drawer-promo__icon' -%}
        {%- endif -%}
        <span>{{ section.settings.promo_always_text }}</span>
      </p>
    {%- endif -%}

    {%- comment -%}
      The bar only appears for a customer who can actually receive the discount:
      a signed-in customer with no orders, or a guest, whose history is unknown.
    {%- endcomment -%}
    {%- if first_order_eligible and tier_2_amount > 0 -%}
      {%- liquid
        assign promo_progress = cart.total_price | times: 100 | divided_by: tier_2_amount
        if promo_progress > 100
          assign promo_progress = 100
        endif

        if tier_2_reached
          assign promo_message = section.settings.promo_unlocked_text | replace: '[reward]', section.settings.promo_tier_2_label
        else
          assign promo_remaining = tier_2_amount | minus: cart.total_price
          assign promo_remaining_money = promo_remaining | divided_by: 100.0 | round | times: 100 | money | replace: '.00', '' | replace: ',00', ''
          assign promo_message = section.settings.promo_locked_text | replace: '[amount]', promo_remaining_money | replace: '[reward]', section.settings.promo_tier_2_label
        endif
      -%}

      <p class="cart-drawer-promo__message">
        {%- if tier_2_reached -%}
          {%- render 'icon' with 'success', width: 12, class: 'cart-drawer-promo__icon' -%}
        {%- endif -%}
        <span>{{ promo_message }}</span>
      </p>

      <div class="cart-drawer-promo__meter">
        <div
          class="cart-drawer-promo__track"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{ promo_progress }}"
          aria-label="{{ promo_message | strip_html | escape }}"
          style="--cart-drawer-promo-progress: {{ promo_progress }}%;"
        >
          <span class="cart-drawer-promo__fill"></span>

          <span
            class="cart-drawer-promo__node {% if tier_2_reached %}is-reached{% endif %}"
            style="--cart-drawer-promo-node: 100%;"
          >
            {%- if tier_2_reached -%}
              {%- render 'icon' with 'success', width: 8, class: 'cart-drawer-promo__tick' -%}
            {%- endif -%}
          </span>
        </div>

        {%- if section.settings.promo_tier_2_label != blank -%}
          <div class="cart-drawer-promo__labels">
            <span class="cart-drawer-promo__label cart-drawer-promo__label--end">
              {{- section.settings.promo_tier_2_label -}}
            </span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}