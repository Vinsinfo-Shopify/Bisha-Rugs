{%- doc -%}
  Collection toolbar: the sticky mobile Filter / Sort bar of the new filter
  design, the filter and sort buttons, the results count and the grid mode
  switch.

  @param {object} results - either collection or search drop to extract filters and sort options from
  @param {boolean} show_filters - whether the calling section shows filters at all
  @param {string} [production_filters] - allow-list output by plp-filter-allowlist
  @param {number} products_count - number of products shown in the results count
  @param {string} [products_mobile_grid_mode] - active mobile grid mode
  @param {string} [products_desktop_grid_mode] - active desktop grid mode
  @param {object} [section]
{%- enddoc -%}

{%- liquid
  assign selected_sort_by_value = results.sort_by | default: results.default_sort_by

  assign count_allow_list = ''

  if production_filters != blank
    assign count_allow_list = production_filters | downcase | replace: ', ', ',' | strip | split: ','
  endif

  assign active_values_count = 0

  for filter in results.filters
    # A filter that is not rendered must not be counted either, or the mobile
    # button would read "Filter (3)" with nothing in the drawer accounting for
    # it. Same matching as the snippets: label or param_name, case insensitive.
    assign count_filter = true

    if count_allow_list != ''
      assign count_filter = false
      assign count_label = filter.label | downcase | strip
      assign count_param = filter.param_name | downcase | strip

      for allowed in count_allow_list
        assign allowed_key = allowed | strip

        if count_label == allowed_key or count_param == allowed_key
          assign count_filter = true
          break
        endif
      endfor
    endif

    if count_filter
      if filter.type == 'price_range'
        if filter.max_value.value != blank or filter.min_value.value != blank
          assign active_values_count = active_values_count | plus: 1
        endif
      else
        assign active_values_count = active_values_count | plus: filter.active_values.size
      endif
    endif
  endfor
-%}

{%- if show_filters or section.settings.show_sort_by or section.settings.show_grid_mode_selector or section.settings.show_results_count -%}
  {%- if section.settings.enable_new_filters -%}
    {%- liquid
      assign pf_sort_label = ''
      for sort_option in results.sort_options
        if sort_option.value == selected_sort_by_value
          assign pf_sort_label = sort_option.name
        endif
      endfor

      # Counted across EVERY filter, Colour included. The shared
      # active_values_count is deliberately allow-listed and excludes
      # Colour, which would leave the bar reading "No Filter Applied"
      # after a swatch is chosen. That count is left untouched.
      assign pf_bar_count = 0

      for filter in results.filters
        if filter.type == 'price_range'
          if filter.min_value.value != blank or filter.max_value.value != blank
            assign pf_bar_count = pf_bar_count | plus: 1
          endif
        else
          assign pf_bar_count = pf_bar_count | plus: filter.active_values.size
        endif
      endfor

      if pf_bar_count == 0
        assign pf_filter_state = 'No Filter Applied'
      elsif pf_bar_count == 1
        assign pf_filter_state = '1 Filter Applied'
      else
        assign pf_filter_state = pf_bar_count | append: ' Filters Applied'
      endif
    -%}

    <pf-sticky-bar class="pf-mobilebar-shell">
      <div class="pf-mobilebar">
        <button type="button" aria-controls="facets-drawer" class="pf-mobilebar__half">
          <span class="pf-mobilebar__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M2 5.5h11M18 5.5h4M2 12h3M10 12h12M2 18.5h11M18 18.5h4"/>
              <circle cx="15.5" cy="5.5" r="2.5" fill="none"/>
              <circle cx="7.5" cy="12" r="2.5" fill="none"/>
              <circle cx="15.5" cy="18.5" r="2.5" fill="none"/>
            </svg>
          </span>
          <span class="pf-mobilebar__text">
            <span class="pf-mobilebar__label">Filter</span>
            <span class="pf-mobilebar__value">{{ pf_filter_state }}</span>
          </span>
        </button>

        <button type="button" aria-controls="sort-by-popover" class="pf-mobilebar__half">
          <span class="pf-mobilebar__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 3v18M7 21l-4-4M7 21l4-4M17 21V3M17 3l-4 4M17 3l4 4"/>
            </svg>
          </span>
          <span class="pf-mobilebar__text">
            <span class="pf-mobilebar__label">Sort By</span>
            <span class="pf-mobilebar__value">{{ pf_sort_label }}</span>
          </span>
        </button>
      </div>
    </pf-sticky-bar>
  {%- endif -%}

  <height-observer variable="collection-toolbar" class="collection-toolbar">
    <div class="collection-toolbar__button-list">
      {%- comment -%}
        Mobile Filter / Sort bar.

        Replaces Prestige's mobile buttons and grid-density switcher on
        small screens; the stock buttons below are kept for desktop and
        are untouched. Both halves reuse the existing aria-controls, so
        the drawer and the sort popover open exactly as before and no
        new JavaScript is involved.

        Both secondary lines are real state: the filter count comes from
        active_values_count, which is already resolved at the top of this
        file and respects the production allow-list, and the sort label
        comes from results.sort_options.
      {%- endcomment -%}


      {%- if show_filters -%}
        <div class="collection-toolbar__button-container {% if section.settings.filter_layout == 'sidebar' %}md:hidden{% endif %}">
          <button type="button" aria-controls="facets-drawer" class="collection-toolbar__button heading text-xs w-full">
            {{- 'collection.faceting.filter_button' | t }}
            {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
          </button>
        </div>
      {%- endif -%}

      {%- if section.settings.show_sort_by -%}
        <div class="collection-toolbar__button-container">
          <button type="button" aria-controls="sort-by-popover" class="collection-toolbar__button heading text-xs w-full">
            <span class="text-with-icon justify-center">
              {%- if section.settings.enable_new_filters -%}
                {%- liquid
                  assign pf_sort_value_label = ''
                  for sort_option in results.sort_options
                    if sort_option.value == selected_sort_by_value
                      assign pf_sort_value_label = sort_option.name
                    endif
                  endfor
                -%}
                <span class="pf-sort-label">{{- 'collection.faceting.sort_by' | t -}}</span>
                <span class="pf-sort-value">{{ pf_sort_value_label }}</span>
              {%- else -%}
                {{- 'collection.faceting.sort_by' | t -}}
              {%- endif -%}
              {%- render 'icon' with 'chevron-down' -%}
            </span>
          </button>

          <facets-sort-popover
            id="sort-by-popover"
            section-id="{{ section.id }}"
            class="popover popover--bottom-end color-scheme color-scheme--dialog"
            close-on-listbox-select
          >
            <p class="h4" slot="header">{{ 'collection.faceting.sort_by' | t }}</p>

            <x-listbox class="popover__value-list">
              {%- for sort_option in results.sort_options -%}
                {%- if sort_option.name != blank -%}
                  <button
                    type="button"
                    class="popover__value-option group"
                    role="option"
                    value="{{ sort_option.value }}"
                    {% if sort_option.value == selected_sort_by_value %}
                      aria-selected="true"
                    {% endif %}
                  >
                    <span class="reversed-link">{{ sort_option.name }}</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </x-listbox>
          </facets-sort-popover>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_results_count -%}
      <p class="collection-toolbar__products-count h6 text-subdued md-max:hidden">
        {{ 'collection.products_count' | t: count: products_count }}
      </p>
    {%- endif -%}

    {%- if section.settings.show_grid_mode_selector -%}
      <collection-layout-switch device="mobile" class="collection-toolbar__layout-switch-list sm:hidden" aria-controls="product-list-{{ section.id }}">
        <button
          type="button"
          value="large"
          class="collection-toolbar__button {% if products_mobile_grid_mode == 'large' %}is-active{% endif %}"
          aria-label="Switch to larger product images"
        >
          {%- render 'icon' with 'collection-layout-1' -%}
        </button>
        <button
          type="button"
          value="medium"
          class="collection-toolbar__button {% if products_mobile_grid_mode == 'medium' %}is-active{% endif %}"
          aria-label="Switch to smaller product images"
        >
          {%- render 'icon' with 'collection-layout-2' -%}
        </button>
      </collection-layout-switch>

      <collection-layout-switch device="desktop" class="collection-toolbar__layout-switch-list sm-max:hidden" aria-controls="product-list-{{ section.id }}">
        <button
          type="button"
          value="large"
          class="collection-toolbar__button {% if products_desktop_grid_mode == 'large' %}is-active{% endif %}"
          aria-label="Switch to larger product images"
        >
          {%- render 'icon' with 'collection-layout-2' -%}
        </button>
        <button
          type="button"
          value="medium"
          class="collection-toolbar__button {% if products_desktop_grid_mode == 'medium' %}is-active{% endif %}"
          aria-label="Switch to smaller product images"
        >
          {%- render 'icon' with 'collection-layout-3' -%}
        </button>
        <button
          type="button"
          value="compact"
          class="collection-toolbar__button {% if products_desktop_grid_mode == 'compact' %}is-active{% endif %}"
          aria-label="Switch to compact product images"
        >
          {%- render 'icon' with 'collection-layout-4' -%}
        </button>
      </collection-layout-switch>
    {%- endif -%}
  </height-observer>
{%- endif -%}
