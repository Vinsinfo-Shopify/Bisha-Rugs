{%- doc -%}
  Render the images for a mega-menu.
  @param {string} [context] - "menu" (desktop, overlay card) or "sidebar" (original)
  @param {object} block
{%- enddoc -%}

{%- for i in (1..2) -%}
  {%- assign image_setting = 'image_' | append: i -%}
  {%- assign heading_setting = 'image_' | append: i | append: '_heading' -%}
  {%- assign text_setting = 'image_' | append: i | append: '_text' -%}
  {%- assign link_setting = 'image_' | append: i | append: '_link' -%}

  {%- if block.settings[image_setting] -%}
    {%- if context == 'menu' -%}
      {%- capture card_inner -%}
        <div class="mega-menu__promo-media">
          {{- block.settings[image_setting] | image_url: width: block.settings[image_setting].width | image_tag: loading: 'lazy', sizes: '480px', widths: '480,720,960,1440', class: 'zoom-image group-hover:zoom' -}}
        </div>

        {%- if block.settings[heading_setting] != blank or block.settings[text_setting] != blank or block.settings[link_setting] != blank -%}
          <div class="mega-menu__promo-overlay">
            <div class="mega-menu__promo-text">
              {%- if block.settings[heading_setting] != blank -%}
                <span class="mega-menu__promo-title">{{ block.settings[heading_setting] }}</span>
              {%- endif -%}
              {%- if block.settings[text_setting] != blank -%}
                <span class="mega-menu__promo-count">{{ block.settings[text_setting] }}</span>
              {%- endif -%}
            </div>

            {%- if block.settings[link_setting] != blank -%}
              <span class="mega-menu__promo-arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 8h12M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endcapture -%}

      {%- if block.settings[link_setting] != blank -%}
        <a href="{{ block.settings[link_setting] }}" class="mega-menu__promo-card group">{{- card_inner -}}</a>
      {%- else -%}
        <div class="mega-menu__promo-card group">{{- card_inner -}}</div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} Original sidebar (mobile) style — unchanged {%- endcomment -%}
      {%- capture image_content -%}
        <div class="overflow-hidden">
          {{- block.settings[image_setting] | image_url: width: block.settings[image_setting].width | image_tag: loading: 'lazy', sizes: '315px', widths: '315,630,945', class: 'zoom-image group-hover:zoom' -}}
        </div>
        {%- if block.settings[heading_setting] != blank or block.settings[text_setting] != blank -%}
          <div class="v-stack text-center gap-0.5">
            {%- if block.settings[heading_setting] != blank -%}<p class="h6">{{ block.settings[heading_setting] }}</p>{%- endif -%}
            {%- if block.settings[text_setting] != blank -%}<p class="smallcaps text-xs text-subdued">{{ block.settings[text_setting] }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endcapture -%}
      {%- if block.settings[link_setting] != blank -%}
        <a href="{{ block.settings[link_setting] }}" class="v-stack justify-items-center gap-4 sm:gap-5 group">{{- image_content -}}</a>
      {%- else -%}
        <div class="v-stack justify-items-center gap-4 sm:gap-5 group">{{- image_content -}}</div>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%} 