{%- doc -%}
  @param {object} line_item - the cart line item to render
  @param {object} [section] - passed through for allow_discount_application
{%- enddoc -%}

{%- liquid
  assign variant = line_item.variant
  assign show_compare_at = false

  if variant.compare_at_price > variant.price
    assign show_compare_at = true
    assign line_compare_at_price = variant.compare_at_price | times: line_item.quantity
    assign saving_percentage = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
  endif
-%}

<line-item class="cart-drawer-line">
  {%- if line_item.image != blank -%}
    <a href="{{ line_item.url }}" class="cart-drawer-line__media" tabindex="-1" aria-hidden="true" data-no-instant>
      {{-
        line_item.image
        | image_url: width: line_item.image.width
        | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160,240', class: 'cart-drawer-line__image', alt: ''
      -}}
    </a>
  {%- endif -%}

  <div class="cart-drawer-line__info">
    {%- if line_item.url != blank -%}
      <a href="{{ line_item.url }}" class="cart-drawer-line__title">
        {{- line_item.product.title | default: line_item.title -}}
      </a>
    {%- else -%}
      <p class="cart-drawer-line__title">{{ line_item.product.title | default: line_item.title }}</p>
    {%- endif -%}

    {%- unless line_item.product.has_only_default_variant or line_item.gift_card -%}
      <div class="cart-drawer-line__options">
        {%- for option in line_item.options_with_values -%}
          <p class="cart-drawer-line__option">
            <span class="cart-drawer-line__option-name">{{ option.name }}:</span>
            <span class="cart-drawer-line__option-value">{{ option.value }}</span>
          </p>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    {%- if line_item.selling_plan_allocation -%}
      <p class="cart-drawer-line__option">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    {%- unless line_item.properties == empty -%}
      <ul class="cart-drawer-line__properties unstyled-list" role="list">
        {%- for property in line_item.properties -%}
          {%- assign first_character_in_key = property.first | truncate: 1, '' -%}

          {%- if property.last == blank or first_character_in_key == '_' -%}
            {%- continue -%}
          {%- endif -%}

          <li>
            {%- if property.last contains '/uploads/' or property.last contains '/files/' -%}
              <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
            {%- else -%}
              {{ property.first }}: {{ property.last }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endunless -%}

    {%- render 'cart-disclosures', product: line_item.product -%}

    <div class="cart-drawer-line__prices">
      <span class="cart-drawer-line__price">
        <span class="sr-only">{{ 'product.price.sale_price' | t }}</span>
        {%- if settings.currency_code_enabled -%}
          {{- line_item.final_line_price | money_with_currency -}}
        {%- else -%}
          {{- line_item.final_line_price | money -}}
        {%- endif -%}
      </span>

      {%- if show_compare_at -%}
        <s class="cart-drawer-line__compare-at">
          <span class="sr-only">{{ 'product.price.regular_price' | t }}</span>
          {%- if settings.currency_code_enabled -%}
            {{- line_compare_at_price | money_with_currency -}}
          {%- else -%}
            {{- line_compare_at_price | money -}}
          {%- endif -%}
        </s>

        <span class="cart-drawer-line__badge">{{ 'general.product.save' | t: percentage: saving_percentage }}</span>
      {%- endif -%}
    </div>

    <line-item-quantity class="cart-drawer-line__actions">
      {%- render 'quantity-selector', line_item: line_item, size: 'sm' -%}

      <a
        href="{{ line_item.url_to_remove }}"
        class="cart-drawer-line__remove"
        aria-label="{{ 'cart.order.remove_with_title' | t: title: line_item.title | escape }}"
      >
        {{- 'cart.order.remove' | t -}}
      </a>
    </line-item-quantity>

    {%- if line_item.line_level_discount_allocations != blank -%}
      <ul class="cart-drawer__discount-list unstyled-list" role="list">
        {%- for discount_allocation in line_item.line_level_discount_allocations -%}
          <li class="discount-badge cart-drawer__discount-badge">
            {%- render 'icon' with 'discount', width: 11 -%}
            {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})

            {%- if section.settings.allow_discount_application and discount_allocation.discount_application.type != '' -%}
              <cart-discount-remove-button
                discount-code="{{ discount_allocation.discount_application.title | escape }}"
                class="h-stack align-center"
              >
                <button type="button" aria-label="{{ 'cart.order.remove' | t | escape }}">
                  {%- render 'icon' with 'close', width: 7 -%}
                </button>
              </cart-discount-remove-button>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</line-item>