      #shopify-section-{{ section.id }} .facets-sidebar .accordion-list::-webkit-scrollbar {
        width: 4px;
      }

      #shopify-section-{{ section.id }} .facets-sidebar .accordion-list::-webkit-scrollbar-track {
        background: rgb(0 0 0 / 0.08);
        border-radius: 999px;
      }

      #shopify-section-{{ section.id }} .facets-sidebar .accordion-list::-webkit-scrollbar-thumb {
        background: {{ section.settings.pf_accent_color }};
        border-radius: 999px;
      }
    }

    #shopify-section-{{ section.id }} .facets .range-group,
