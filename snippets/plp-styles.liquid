    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .pf-colors {
        display: block;
        margin-block-start: {{ section.settings.color_strip_gap_top_mobile }}px;
      }

      /* No heading on mobile. */
      {%- if section.settings.color_hide_heading_mobile -%}
        #shopify-section-{{ section.id }} .pf-colors__heading {
          display: none;
        }
      {%- else -%}
        #shopify-section-{{ section.id }} .pf-colors__heading {
          margin-block-end: 10px;
        }
      {%- endif -%}

      /* Edge to edge scrolling.
         The track breaks out of the container with a negative margin, then puts
         the gutter back as padding. The result: at rest the first swatch sits
         on the normal left margin while the row runs off the right edge, and
         scrolled to the end the last swatch has the same margin on the right
         while the row runs off the left. The scroll surface itself is the full
         screen width the whole time.

         scroll-padding keeps the first item aligned to that margin rather than
         to the bleed when the row snaps or is scrolled back. */
      #shopify-section-{{ section.id }} .pf-colors__track {
        margin-inline: calc(var(--container-gutter) * -1);
        padding-inline: var(--container-gutter);
        scroll-padding-inline-start: var(--container-gutter);
      }

      #shopify-section-{{ section.id }} .pf-color {
        font-size: 12px;
