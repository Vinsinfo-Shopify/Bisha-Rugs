        row-gap: {{ section.settings.pf_value_row_gap }}px;
        {%- if section.settings.pf_value_columns > 1 -%}
          column-gap: max(
            0px,
            calc(
              {{ section.settings.pf_value_col_gap }}px - var(--pf-value-gutter) * 2 /
                {{ section.settings.pf_value_columns | minus: 1 }}
            )
          );
        {%- endif -%}
        padding-inline: var(--pf-value-gutter);
      }

      /* Photo on top, label centred below, same shape as the .pf-colors
