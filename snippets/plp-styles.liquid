        rgb(0 0 0 / 0.12) var(--range-min),
        {{ section.settings.pf_accent_color }} var(--range-min),
        {{ section.settings.pf_accent_color }} var(--range-max),
        rgb(0 0 0 / 0.12) var(--range-max)
      );
