           .collection-toolbar__layout-switch-list. My first attempt targeted
           .collection-toolbar__layout-switch and product-list-grid-switcher,
           neither of which exists in this theme, so the icons stayed visible. */
        #shopify-section-{{ section.id }} collection-layout-switch,
        #shopify-section-{{ section.id }} .collection-toolbar__layout-switch-list {
          display: none;
        }
      {%- endif -%}

      /* The toolbar in the design carries no rules. */
      {%- if section.settings.pf_hide_toolbar_rules -%}
        /* theme.css:4503 draws these rules with box-shadow, not border, so
           border-block: 0 had no effect. */
        #shopify-section-{{ section.id }} .collection-toolbar {
          box-shadow: none;
        }
      {%- endif -%}
      #shopify-section-{{ section.id }} .facets-sidebar {
        display: flex;
        flex-direction: column;
        max-height: calc(100vh - var(--sticky-area-height, 0px) - var(--collection-toolbar-height, 0px) - 40px);
