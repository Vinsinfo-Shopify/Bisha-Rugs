        width: min({{ section.settings.pf_value_media_size }}px, 100%);
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: var(--rounded-full);
        border: 1px solid rgb(0 0 0 / 0.12);
        transition: box-shadow 0.15s ease-in-out;
      }

      /* Active ring, inset like .pf-color__media so the tile never changes
         size or shifts the grid.

         :has(input:checked) never matched here: option-value.liquid emits
         the sr-only <input> as a PRECEDING sibling of the <label
         class="option-value">, not a descendant, and :has()'s default
         combinator only looks at descendants. There is no CSS combinator
         for "preceding sibling", so the checked state is read off the
         input itself with the ordinary adjacent-sibling combinator
         instead - input:checked + .option-value - which is what actually
         matches this markup. */
      #shopify-section-{{ section.id }} .facets .option-value:hover :is(img, svg),
      #shopify-section-{{ section.id }} .facets .option-value:focus-visible :is(img, svg),
      #shopify-section-{{ section.id }} .facets input:checked + .option-value :is(img, svg) {
        box-shadow:
          inset 0 0 0 1.5px rgb(var(--text-color)),
          inset 0 0 0 4px rgb(var(--background-without-opacity));
      }

      #shopify-section-{{ section.id }} .facets input:checked + .option-value {
        font-weight: 600;
        color: #000000;
      }

      /* The design has no grid-density or list-view controls. Hidden rather
         than removed, so the theme's own JS keeps its references. */
      {%- if section.settings.pf_hide_view_switcher -%}
