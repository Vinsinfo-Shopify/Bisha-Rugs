{%- doc -%}
  PDP Section 01 - breadcrumb.

  PDP-scoped. snippets/breadcrumbs.liquid is left untouched because the
  collection and page templates render it; this is a separate trail for the
  product template only.

    Shop All  >  [collection or product type]  >  [product title]

  Every value is dynamic:

    "Shop All"  the main menu entry - its own title AND its own url, so if the
                merchant renames or re-points it the breadcrumb follows. Falls
                back to the all-products route only if no such entry exists.
    middle      collection.url when the visitor arrived through a collection.
                A direct link, a Google result or a paid click has no
                collection, so it falls back to the product's own type and
                links to the matching collection when one exists. Rendered as
                plain text rather than a dead link when it does not.
    current     product.title, never a link.

  Nothing is hardcoded and nothing errors when a level is missing: each level
  is guarded, and a level with no value is skipped entirely rather than
  rendering an empty separator.

  Usage - a "Liquid" block at the very top of the product section:

    {% render 'pdp-breadcrumb' %}
{%- enddoc -%}

{%- liquid
  # --- First level: the real "Shop All" menu entry -------------------------
  # Title and URL both come from the menu, so the breadcrumb cannot drift from
  # the navigation. Searched case-insensitively and one level deep, which is
  # where a top-level entry lives.
  assign shop_all_url = ''
  assign shop_all_title = ''

  assign main_menu = linklists[settings.menu] | default: linklists['main-menu']

  for link in main_menu.links
    assign link_title = link.title | downcase | strip

    if link_title == 'shop all'
      assign shop_all_url = link.url
      assign shop_all_title = link.title
      break
    endif
  endfor

  # No such entry: fall back to the all-products route rather than guessing a
  # handle that may not exist.
  if shop_all_url == blank
    assign shop_all_url = routes.all_products_collection_url
    assign shop_all_title = 'Shop All'
  endif

  # --- Middle level: collection, else product type ------------------------
  assign mid_title = ''
  assign mid_url = ''

  if collection.url != blank
    assign mid_title = collection.title
    assign mid_url = collection.url
  elsif product.type != blank
    assign mid_title = product.type

    # Link it only if a collection with that handle genuinely exists.
    assign type_handle = product.type | handle
    assign type_collection = collections[type_handle]

    if type_collection != blank and type_collection.url != blank
      assign mid_url = type_collection.url
    endif
  endif
-%}

{%- if product != blank -%}
  <nav class="pdp-breadcrumb" aria-label="Breadcrumb">
    <ol class="pdp-breadcrumb__list">
      <li class="pdp-breadcrumb__item">
        <a class="pdp-breadcrumb__link" href="{{ shop_all_url }}">{{ shop_all_title }}</a>
      </li>

      {%- if mid_title != blank -%}
        <li class="pdp-breadcrumb__item">
          <span class="pdp-breadcrumb__sep" aria-hidden="true">&gt;</span>

          {%- if mid_url != blank -%}
            <a class="pdp-breadcrumb__link" href="{{ mid_url }}">{{ mid_title }}</a>
          {%- else -%}
            {%- comment -%}
              No destination, so it is text rather than a link that goes
              nowhere. Still shown, because it is a real level of the trail.
            {%- endcomment -%}
            <span class="pdp-breadcrumb__link pdp-breadcrumb__link--plain">{{ mid_title }}</span>
          {%- endif -%}
        </li>
      {%- endif -%}

      <li class="pdp-breadcrumb__item">
        <span class="pdp-breadcrumb__sep" aria-hidden="true">&gt;</span>
        <span class="pdp-breadcrumb__current" aria-current="page">{{ product.title }}</span>
      </li>
    </ol>
  </nav>

  <style>
    /* Scoped by .pdp-breadcrumb, which exists only in this snippet.
       theme.liquid writes template-{{ request.page_type }} on <body>, which
       resolves to "template-product" with no suffix - so a body.template-
       product-bisha-pdp selector would never match anything. The class is the
       reliable hook, and since this snippet is rendered only from the bisha-pdp
       template, snippets/breadcrumbs.liquid and every other template are
       untouched regardless. */
    .pdp-breadcrumb {
      margin-block-end: 16px;
    }

    .pdp-breadcrumb__list {
      display: flex;
      flex-wrap: wrap;      /* wraps instead of pushing the page wider */
      align-items: baseline;
      gap: 0 6px;
      margin: 0;
      padding: 0;
      list-style: none;
      min-width: 0;
    }

    .pdp-breadcrumb__item {
      display: flex;
      align-items: baseline;
      gap: 6px;
      min-width: 0;         /* lets a long title shrink rather than overflow */
    }

    .pdp-breadcrumb :is(a, span) {
      font-family: var(--text-font-family);
      font-size: 14px;
      line-height: 20px;
      font-weight: 400;
      /* A long product title wraps between words; an unbroken string breaks
         rather than forcing horizontal scroll. */
      overflow-wrap: break-word;
      word-break: break-word;
      min-width: 0;
    }

    .pdp-breadcrumb__link {
      color: #000000;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .pdp-breadcrumb__link--plain {
      text-decoration: none;
    }

    .pdp-breadcrumb__sep,
    .pdp-breadcrumb__current {
      color: #898989;
      text-decoration: none;
    }

    @media screen and (max-width: 699px) {
      .pdp-breadcrumb {
        margin-block-end: 12px;
      }

      .pdp-breadcrumb :is(a, span) {
        font-size: 12px;
        line-height: 17px;
      }
    }
  </style>
{%- endif -%}
