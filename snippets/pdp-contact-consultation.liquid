{%- doc -%}
  Renders the "Got Questions? Reach Out To Us" contact block for the product
  page: a heading, description, click-to-call phone number and mailto email,
  followed by a nested "Free Virtual Consultation" card with an image, copy
  and a Book Now button.

  @param {object} block - the "contact_consultation" block
{%- enddoc -%}

{%- liquid
  assign settings = block.settings
-%}

<div class="pdp-contact" {{ block.shopify_attributes }}>
  {%- if settings.heading != blank -%}
    <p class="pdp-contact__heading">{{- settings.heading -}}</p>
  {%- endif -%}

  {%- if settings.description != blank -%}
    <p class="pdp-contact__description">{{- settings.description -}}</p>
  {%- endif -%}

  {%- if settings.phone_label != blank or settings.email != blank -%}
    <div class="pdp-contact__methods">
      {%- if settings.phone_label != blank -%}
        <a href="{{ settings.phone_link | default: '#' }}" class="pdp-contact__method">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 19 19" fill="none">
            <path d="M5.52118 12.9451C3.60715 11.0274 2.13519 8.71466 1.20824 6.16869C0.698267 4.77673 1.16552 3.24771 2.21394 2.19929L2.86275 1.55136C3.03718 1.37658 3.24436 1.23792 3.47245 1.14331C3.70053 1.0487 3.94503 1 4.19196 1C4.43889 1 4.68339 1.0487 4.91148 1.14331C5.13956 1.23792 5.34675 1.37658 5.52118 1.55136L7.04041 3.0706C7.21519 3.24502 7.35385 3.45221 7.44846 3.68029C7.54307 3.90838 7.59177 4.15288 7.59177 4.39981C7.59177 4.64674 7.54307 4.89124 7.44846 5.11933C7.35385 5.34741 7.21519 5.5546 7.04041 5.72903L6.66661 6.10283C6.51698 6.25242 6.39829 6.43002 6.31732 6.62548C6.23634 6.82095 6.19466 7.03045 6.19466 7.24203C6.19466 7.4536 6.23634 7.6631 6.31732 7.85857C6.39829 8.05404 6.51698 8.23164 6.66661 8.38123L10.0842 11.7997C10.2338 11.9493 10.4114 12.068 10.6069 12.149C10.8023 12.23 11.0118 12.2717 11.2234 12.2717C11.435 12.2717 11.6445 12.23 11.84 12.149C12.0354 12.068 12.213 11.9493 12.3626 11.7997L12.7373 11.4259C12.9117 11.2511 13.1189 11.1125 13.347 11.0179C13.5751 10.9233 13.8196 10.8746 14.0665 10.8746C14.3134 10.8746 14.5579 10.9233 14.786 11.0179C15.0141 11.1125 15.2213 11.2511 15.3957 11.4259L16.915 12.9451C17.0897 13.1196 17.2284 13.3268 17.323 13.5548C17.4176 13.7829 17.4663 14.0274 17.4663 14.2744C17.4663 14.5213 17.4176 14.7658 17.323 14.9939C17.2284 15.222 17.0897 15.4291 16.915 15.6036L16.267 16.2515C15.2186 17.3008 13.6896 17.7681 12.2976 17.2581C9.75166 16.3311 7.43892 14.8592 5.52118 12.9451Z" stroke="black" stroke-width="2" stroke-linejoin="round"/>
          </svg>
          <span>{{- settings.phone_label -}}</span>
        </a>
      {%- endif -%}

      {%- if settings.email != blank -%}
        <a href="mailto:{{ settings.email }}" class="pdp-contact__method">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="15" viewBox="0 0 18 15" fill="none">
           <path d="M1.78 14.24C1.2905 14.24 0.871607 14.0659 0.52332 13.7176C0.175033 13.3693 0.000593333 12.9501 0 12.46V1.78C0 1.2905 0.17444 0.871607 0.52332 0.52332C0.8722 0.175033 1.29109 0.000593333 1.78 0H16.02C16.5095 0 16.9287 0.17444 17.2776 0.52332C17.6265 0.8722 17.8006 1.29109 17.8 1.78V12.46C17.8 12.9495 17.6259 13.3687 17.2776 13.7176C16.9293 14.0665 16.5101 14.2406 16.02 14.24H1.78ZM8.9 8.01L1.78 3.56V12.46H16.02V3.56L8.9 8.01ZM8.9 6.23L16.02 1.78H1.78L8.9 6.23ZM1.78 3.56V1.78V12.46V3.56Z" fill="black"/>
          </svg>
          <span>{{- settings.email -}}</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if settings.consultation_heading != blank or settings.consultation_text != blank or settings.consultation_image != blank -%}
    <div class="pdp-consultation">
      {%- if settings.consultation_image != blank -%}
        {{-
          settings.consultation_image
          | image_url: width: 160
          | image_tag: loading: 'lazy', sizes: '72px', widths: '72,144', class: 'pdp-consultation__image'
        -}}
      {%- endif -%}
      <div class="pdp-consultation__body_content">
        <div class="pdp-consultation__body">
          {%- if settings.consultation_heading != blank -%}
            <p class="pdp-consultation__heading">{{- settings.consultation_heading -}}</p>
          {%- endif -%}

          {%- if settings.consultation_text != blank -%}
            <p class="pdp-consultation__text">{{- settings.consultation_text -}}</p>
          {%- endif -%}
        </div>

        {%- if settings.consultation_button_label != blank -%}
          {%- render 'button', href: settings.consultation_button_link, content: settings.consultation_button_label, size: 'sm' -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>
