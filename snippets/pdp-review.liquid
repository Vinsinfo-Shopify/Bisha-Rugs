{%- doc -%}
  Renders a single static customer review block for the product page: a rectangular
  product image, name, an optional "Verified" badge, a manually-set star rating (with
  its numeric value) and a quote. Unlike product-rating.liquid, this is not driven by
  review-app metafields - the merchant enters every field directly in the block settings.

  @param {object} block - the "review" block
{%- enddoc -%}

{%- liquid
  assign settings = block.settings
  assign rating = settings.rating | default: 5
  assign filled_stars = rating | round
-%}

<div class="pdp-review" {{ block.shopify_attributes }}>
  <div class="pdp-review__header">
    {%- if settings.avatar != blank -%}
      {{-
        settings.avatar
        | image_url: width: 160
        | image_tag: loading: 'lazy', sizes: '56px', widths: '56,112,160', class: 'pdp-review__image'
      -}}
    {%- endif -%}

    <div class="pdp-review__body">
      <div class="pdp-review__top-row">
        {%- if settings.name != blank or settings.verified -%}
          <div class="pdp-review__name-row">
            {%- if settings.name != blank -%}
              <span class="pdp-review__name">{{- settings.name -}}</span>
            {%- endif -%}

            {%- if settings.verified -%}
              <span class="pdp-review__verified">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M5.0616 0.800182C4.89925 0.938535 4.81808 1.00772 4.73138 1.06583C4.53264 1.19903 4.30945 1.29148 4.07474 1.33782C3.97234 1.35804 3.86602 1.36652 3.65339 1.38348C3.11914 1.42612 2.852 1.44744 2.62914 1.52615C2.11368 1.70822 1.70822 2.11368 1.52615 2.62914C1.44744 2.852 1.42612 3.11914 1.38348 3.65339C1.36652 3.86602 1.35804 3.97234 1.33782 4.07474C1.29148 4.30945 1.19903 4.53264 1.06583 4.73138C1.00772 4.81808 0.938542 4.89925 0.800182 5.0616C0.452555 5.46953 0.278735 5.67347 0.176815 5.88673C-0.0589383 6.38 -0.0589383 6.95333 0.176815 7.4466C0.278742 7.65987 0.452555 7.8638 0.800182 8.27173C0.938522 8.43407 1.00772 8.51527 1.06583 8.60193C1.19903 8.80067 1.29148 9.02387 1.33782 9.2586C1.35804 9.361 1.36652 9.46733 1.38348 9.67993C1.42612 10.2142 1.44744 10.4813 1.52615 10.7042C1.70822 11.2197 2.11368 11.6251 2.62914 11.8072C2.852 11.8859 3.11914 11.9072 3.65339 11.9499C3.86602 11.9668 3.97234 11.9753 4.07474 11.9955C4.30945 12.0419 4.53264 12.1343 4.73138 12.2675C4.81808 12.3256 4.89925 12.3948 5.0616 12.5331C5.46953 12.8808 5.67347 13.0546 5.88673 13.1565C6.38 13.3923 6.95333 13.3923 7.4466 13.1565C7.65987 13.0546 7.8638 12.8808 8.27173 12.5331C8.43407 12.3948 8.51527 12.3256 8.60193 12.2675C8.80067 12.1343 9.02387 12.0419 9.2586 11.9955C9.361 11.9753 9.46733 11.9668 9.67993 11.9499C10.2142 11.9072 10.4813 11.8859 10.7042 11.8072C11.2197 11.6251 11.6251 11.2197 11.8072 10.7042C11.8859 10.4813 11.9072 10.2142 11.9499 9.67993C11.9668 9.46733 11.9753 9.361 11.9955 9.2586C12.0419 9.02387 12.1343 8.80067 12.2675 8.60193C12.3256 8.51527 12.3948 8.43407 12.5331 8.27173C12.8808 7.8638 13.0546 7.65987 13.1565 7.4466C13.3923 6.95333 13.3923 6.38 13.1565 5.88673C13.0546 5.67347 12.8808 5.46953 12.5331 5.0616C12.3948 4.89925 12.3256 4.81808 12.2675 4.73138C12.1343 4.53264 12.0419 4.30945 11.9955 4.07474C11.9753 3.97234 11.9668 3.86602 11.9499 3.65339C11.9072 3.11914 11.8859 2.852 11.8072 2.62914C11.6251 2.11368 11.2197 1.70822 10.7042 1.52615C10.4813 1.44744 10.2142 1.42612 9.67993 1.38348C9.46733 1.36652 9.361 1.35804 9.2586 1.33782C9.02387 1.29148 8.80067 1.19903 8.60193 1.06583C8.51527 1.00772 8.43407 0.938542 8.27173 0.800182C7.8638 0.452555 7.65987 0.278742 7.4466 0.176815C6.95333 -0.0589383 6.38 -0.0589383 5.88673 0.176815C5.67347 0.278735 5.46953 0.452555 5.0616 0.800182ZM9.58233 5.24209C9.7942 5.0302 9.7942 4.68667 9.58233 4.47478C9.37047 4.26289 9.02687 4.26289 8.815 4.47478L5.58153 7.70827L4.51831 6.64507C4.30642 6.4332 3.96288 6.4332 3.751 6.64507C3.53911 6.85694 3.53911 7.20047 3.751 7.4124L5.19785 8.85927C5.40974 9.07113 5.75327 9.07113 5.9652 8.85927L9.58233 5.24209Z" fill="#56583D"/>
                </svg>
                Verified
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="pdp-review__rating">
          <span class="pdp-review__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: rating, rating_max: 5 }}">
            {%- for i in (1..5) -%}
              {%- if i <= filled_stars -%}
                {%- render 'icon' with 'star-rating' -%}
              {%- else -%}
                {%- render 'icon' with 'star-rating-empty' -%}
              {%- endif -%}
            {%- endfor -%}
          </span>
          <span class="pdp-review__rating-value">({{ rating }})</span>
        </div>
      </div>

      {%- if settings.quote != blank -%}
        <p class="pdp-review__quote">&ldquo;{{ settings.quote }}&rdquo;</p>
      {%- endif -%}
    </div>
  </div>
</div>
