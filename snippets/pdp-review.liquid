{%- doc -%}
  Renders a single static customer review block for the product page: avatar,
  name, an optional "Verified" badge, a manually-set star rating and a quote.
  Unlike product-rating.liquid, this is not driven by review-app metafields -
  the merchant enters every field directly in the block settings.

  @param {object} block - the "review" block
{%- enddoc -%}

{%- liquid
  assign settings = block.settings
  assign rating = settings.rating | default: 5
-%}

<div class="pdp-review" {{ block.shopify_attributes }}>
  <div class="pdp-review__header">
    {%- if settings.avatar != blank -%}
      {{-
        settings.avatar
        | image_url: width: 80
        | image_tag: loading: 'lazy', sizes: '40px', widths: '40,80', class: 'pdp-review__avatar'
      -}}
    {%- endif -%}

    <div class="pdp-review__meta">
      {%- if settings.name != blank or settings.verified -%}
        <div class="pdp-review__name-row">
          {%- if settings.name != blank -%}
            <span class="pdp-review__name">{{- settings.name -}}</span>
          {%- endif -%}

          {%- if settings.verified -%}
            <span class="pdp-review__verified">
              <svg viewBox="0 0 20 20" aria-hidden="true" width="14" height="14">
                <path
                  fill="currentColor"
                  d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm-1.06 10.71L6.65 10.4a.75.75 0 1 1 1.06-1.06l1.23 1.23 3.35-3.35a.75.75 0 1 1 1.06 1.06l-3.9 3.9a.75.75 0 0 1-1.06 0Z"
                />
              </svg>
              Verified
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="pdp-review__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: rating, rating_max: 5 }}">
        {%- for i in (1..5) -%}
          {%- if i <= rating -%}
            {%- render 'icon' with 'star-rating' -%}
          {%- else -%}
            {%- render 'icon' with 'star-rating-empty' -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if settings.quote != blank -%}
    <p class="pdp-review__quote">&ldquo;{{ settings.quote }}&rdquo;</p>
  {%- endif -%}
</div>
