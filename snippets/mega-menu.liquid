{%- doc -%}
  Render the mega-menu with support for a colour-swatch column and a promo card.
  @param {object} link
  @param {object} block
{%- enddoc -%}

<div class="mega-menu {% if block.settings.images_position == 'left' %}mega-menu--reverse{% endif %}" {{ block.shopify_attributes }}>
  {%- if link.levels > 0 -%}
    <ul class="mega-menu__linklist unstyled-list">
      {%- for sub_link in link.links -%}
        {%- assign column_key = sub_link.title | downcase | strip -%}
        {%- assign is_color_column = false -%}
        {%- if column_key contains 'color' -%}
          {%- assign is_color_column = true -%}
        {%- endif -%}

        <li class="v-stack justify-items-start gap-5 mega-menu__column{% if is_color_column %} mega-menu__column--colors{% endif %}">
          <a href="{{ sub_link.url }}" class="h6">{{ sub_link.title }}</a>

          {%- if sub_link.links.size > 0 -%}
            {%- if is_color_column -%}
              <ul class="mega-menu__swatch-grid unstyled-list">
                {%- for sub_sub_link in sub_link.links -%}
                  {%- assign color_key = sub_sub_link.title | downcase | strip -%}
                  {%- assign swatch = '' -%}
                  {%- assign is_shop_all = false -%}
                  {%- if color_key contains 'shop all' -%}{%- assign is_shop_all = true -%}{%- endif -%}
                  {%- case color_key -%}
                    {%- when 'brown' -%}{%- assign swatch = '#6d4a3f' -%}
                    {%- when 'white' -%}{%- assign swatch = '#ffffff' -%}
                    {%- when 'grey', 'gray' -%}{%- assign swatch = '#b7b7b7' -%}
                    {%- when 'beige' -%}{%- assign swatch = '#d9cdb0' -%}
                    {%- when 'yellow' -%}{%- assign swatch = '#e9d18a' -%}
                    {%- when 'green' -%}{%- assign swatch = '#9aab77' -%}
                    {%- when 'pink' -%}{%- assign swatch = '#e6a0ad' -%}
                    {%- when 'baby blue' -%}{%- assign swatch = '#bcd6ec' -%}
                    {%- when 'blue' -%}{%- assign swatch = '#5a8fc2' -%}
                    {%- when 'teal' -%}{%- assign swatch = '#3f8b8b' -%}
                    {%- when 'indigo' -%}{%- assign swatch = '#173a5e' -%}
                    {%- when 'orange' -%}{%- assign swatch = '#d96a3f' -%}
                    {%- when 'red' -%}{%- assign swatch = '#c0413f' -%}
                    {%- when 'maroon' -%}{%- assign swatch = '#5e2b2b' -%}
                    {%- when 'mustard' -%}{%- assign swatch = '#c8901a' -%}
                    {%- when 'dust' -%}{%- assign swatch = '#a08d7d' -%}
                  {%- endcase -%}

                  <li class="{% if is_shop_all %}mega-menu__swatch-item--full{% endif %}">
                    <a href="{{ sub_sub_link.url }}" class="link-faded mega-menu__swatch-link" {% if sub_sub_link.current %}aria-current="page"{% endif %}>
                      {%- if swatch != '' -%}
                        <span class="mega-menu__swatch" style="--swatch: {{ swatch }};"></span>
                      {%- endif -%}
                      {{- sub_sub_link.title -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <ul class="v-stack gap-2.5 unstyled-list">
                {%- for sub_sub_link in sub_link.links -%}
                  <li>
                    <a href="{{ sub_sub_link.url }}" class="link-faded" {% if sub_sub_link.current %}aria-current="page"{% endif %}>{{ sub_sub_link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- capture mega_menu_content -%}
    {%- render 'mega-menu-images', context: 'menu', block: block -%}
  {%- endcapture -%}

  {%- if mega_menu_content != blank -%}
    <div class="mega-menu__promo">
      {{- mega_menu_content -}}
    </div>
  {%- endif -%}
</div>