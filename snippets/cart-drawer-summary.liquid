{%- doc -%}
  @param {object} section - the cart drawer section
  @param {string} item_word - already pluralised item label
  @param {number} standard_shipping - shipping amount in cents, 0 when unset
  @param {boolean} tier_1_reached
  @param {string} rows - "all", "shipping_total" or "total"
{%- enddoc -%}

<div class="cart-drawer-summary {% if rows != 'all' %}cart-drawer-summary--compact{% endif %}">
  {%- if rows == 'all' -%}
    <div class="cart-drawer-summary__row">
      <span>{{ 'cart.general.subtotal' | t }} ({{ cart.item_count }} {{ item_word }})</span>
      <span>{%- render 'cart-drawer-money', amount: cart.items_subtotal_price -%}</span>
    </div>
  {%- endif -%}

  {%- if rows == 'all' or rows == 'shipping_total' -%}
    <div class="cart-drawer-summary__row">
      <span>{{ section.settings.shipping_label }}</span>
      <span class="cart-drawer-summary__shipping">
        {%- if standard_shipping > 0 -%}
          {%- if tier_1_reached -%}
            <s>{%- render 'cart-drawer-money', amount: standard_shipping -%}</s>
            <strong>{%- render 'cart-drawer-money', amount: 0 -%}</strong>
          {%- else -%}
            {%- render 'cart-drawer-money', amount: standard_shipping -%}
          {%- endif -%}
        {%- else -%}
          <span class="cart-drawer-summary__note">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</span>
        {%- endif -%}
      </span>
    </div>
  {%- endif -%}

  <div class="cart-drawer-summary__row cart-drawer-summary__row--total">
    <span>{{ 'cart.general.total' | t }}</span>
    <span>{%- render 'cart-drawer-money', amount: cart.total_price -%}</span>
  </div>
</div>