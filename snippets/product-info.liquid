{%- doc -%}
  This snippet renders all the blocks of a given product. It uses the blocks of the section currently in use (there is no need to manually pass the section as it is globally available).

  @param {object} [product] - the product on which to render the information (if blank, it renders placeholder information)
  @param {string} [product_form_id] - the ID of the product form
  @param {boolean} [center_basic_info] - if true, the basic information (product title, vendor, price) are centered on mobile
  @param {boolean} [has_content_below_gallery] - if true, the product has extra information shown below the gallery
  @param {boolean} [has_product_page_disclosures] - if true, at least one disclosure targets the product_page surface
  @param {string} [context] - the context of the product info. Can be "main_product", "featured_product" or "quick_buy"
  @param {object} [section]
{%- enddoc -%}
<style>
  .shopify-section--main-product .product-info .product-title {
    font-family: Forum;
    font-weight: 400;
    font-size: 32px;
    line-height: 120%;
    vertical-align: middle;
    text-transform: capitalize;
  }
  .shopify-section--main-product .product-info .price-list .text-on-sale {
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 140%;
  }
  .shopify-section--main-product .product-info .price-list compare-at-price.text-subdued {
    font-weight: 500;
    font-size: var(--text-base);
    line-height: 140%;
    text-decoration: line-through;
  }
  .shopify-section--main-product .product-info .badge.badge--custom{
    padding: 2px 10px;
    font-size: var(--text-xs);
  }

  .shopify-section--main-product .color-pattern-picker__heading {
    font-family: var(--text-font-family);
    font-size: 16px;
    font-weight: 700;
    line-height: 140%;
    margin: 0;
    color: #202020;
  }

  .shopify-section--main-product color-pattern-picker {
    min-width: 0;
  }

  .shopify-section--main-product .color-pattern-picker__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    min-width: 0;
  }

  .shopify-section--main-product .color-pattern-picker__item {
    display: block;
    box-sizing: border-box;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(0 0 0 / 0.12);
    background-size: cover;
    background-position: center;
    cursor: pointer;
    transition: box-shadow 0.15s ease-in-out;
  }

  .shopify-section--main-product .color-pattern-picker__item:hover,
  .shopify-section--main-product input:focus-visible + .color-pattern-picker__item,
  .shopify-section--main-product input:checked + .color-pattern-picker__item {
    box-shadow:
      inset 0 0 0 2px rgb(var(--text-color)),
      inset 0 0 0 4px rgb(var(--background-without-opacity));
  }

  .shopify-section--main-product .color-pattern-picker__editor-hint {
    border: 1px dashed rgb(var(--text-color) / 0.3);
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 13px;
    font-style: italic;
  }

  .shopify-section--main-product .card-slider {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .shopify-section--main-product .card-slider__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(100%);
    gap: 10px;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .shopify-section--main-product .card-slider__track::-webkit-scrollbar {
    display: none;
  }

  .shopify-section--main-product .card-slider__track > * {
    min-width: 0;
    scroll-snap-align: start;
  }

  .shopify-section--main-product .card-slider__track .image-text-card {
    height: 100%;
  }

  .shopify-section--main-product .card-slider .page-dots {
    color: rgb(var(--text-color));
  }

  .shopify-section--main-product .swatch-card {
    flex-direction: column;
    row-gap: 10px;
  }

  .shopify-section--main-product .swatch-card__product {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .shopify-section--main-product .swatch-card__image {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: var(--input-border-radius);
  }

  .shopify-section--main-product .swatch-card__details {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 14px;
    line-height: 140%;
  }

  .shopify-section--main-product .swatch-card__title {
    margin: 0;
  }

  .shopify-section--main-product .swatch-card__price {
    margin: 4px 0 0;
    font-weight: 700;
  }

  .shopify-section--main-product .swatch-card__form {
    flex-shrink: 0;
  }

  .shopify-section--main-product .swatch-card__button.is-loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .shopify-section--main-product .swatch-card__error {
    margin: 0;
    font-size: 13px;
    color: rgb(var(--error-text, 222 42 42));
  }

  .shopify-section--main-product .swatch-card__button {
    flex-shrink: 0;
    font-weight: 700;
    font-size: 14px;
    line-height: 100%;
    text-transform: uppercase;
  }
</style>
<safe-sticky class="product-info {% if center_basic_info %}product-info--center{% endif %}">
  <div class="product-info__block-list">
    {%- liquid
      assign inside_block_group_context = false
      assign current_block_group_name = ''

      if context == 'quick_buy'
        assign allow_blocks = '@app vendor title price quantity_selector payment_terms variant_picker product_variations line_item_property buy_buttons' | split: ' '
      endif

      if allow_blocks != blank
        assign filtered_blocks = '' | split: ''

        for block in section.blocks
          if allow_blocks contains block.type
            assign block_as_arr = block | sort
            assign filtered_blocks = filtered_blocks | concat: block_as_arr
          endif
        endfor
      else
        assign filtered_blocks = section.blocks
      endif
    -%}

    {%- assign slider_card_types = 'image_text_card,swatch_card' | split: ',' -%}
    {%- assign inside_card_slider = false -%}

    {%- for block in filtered_blocks -%}
      {%- liquid
        # Filter the blocks (if allow_blocks is set)
        if allow_blocks
          unless allow_blocks contains block.type
            continue
          endunless
        endif

        assign next_block_index = forloop.index0 | plus: 1
        assign next_block = filtered_blocks[next_block_index]

        if block.settings.show_below_gallery
          continue
        endif

        comment
          You can use your own condition to create smart grouping. When two or more blocks match the condition, they are
          automatically grouped by a div that will take the desired class. This can even work for more than 2 elements
          (for instance if you specify accordion follow by an accordion). The theme takes care of properly opening and
          closing the group for proper HTML. In order to make it work, you need to create one condition explaining when
          to enter into the group, and you need to indicate a block_group_class and block_group_name. Most of the time,
          the two will be identical. However, the block_group_name must be unique. This means that as long as the block_group_name
          stays the same, then another group will not be created as long as the conditions match.
        endcomment

        assign allow_block_group = true

        if block.type == 'price' and block.settings.show_taxes_notice == false and next_block.type == 'rating'
          assign block_group_class = 'text-with-rating'
          assign block_group_name = 'text-with-rating'
        elsif block.type == 'rating' and next_block.type == 'price' and next_block.settings.show_taxes_notice == false
          assign block_group_class = 'text-with-rating'
          assign block_group_name = 'text-with-rating'
        elsif block.type == 'sku' and next_block.type == 'rating'
          assign block_group_class = 'text-with-rating'
          assign block_group_name = 'text-with-rating'
        elsif block.type == 'rating' and next_block.type == 'sku'
          assign block_group_class = 'text-with-rating'
          assign block_group_name = 'text-with-rating'
        elsif block.type == 'accordion' and next_block.type == 'accordion' and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'accordion' and next_block.type == 'product-faq'
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'product-faq' and next_block.type == 'accordion' and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'accordion' and next_block.type == 'description' and product.description != blank and next_block.settings.collapse_content and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'description' and product.description != blank and block.settings.collapse_content and next_block.type == 'accordion' and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'disclosures' and block.settings.collapse_content and has_product_page_disclosures and block.settings.show_below_gallery != true and next_block.type == 'accordion' and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'accordion' and block.settings.show_below_gallery != true and next_block.type == 'disclosures' and next_block.settings.collapse_content and has_product_page_disclosures and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'description' and product.description != blank and block.settings.collapse_content and block.settings.show_below_gallery != true and next_block.type == 'disclosures' and next_block.settings.collapse_content and has_product_page_disclosures and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'disclosures' and block.settings.collapse_content and has_product_page_disclosures and block.settings.show_below_gallery != true and next_block.type == 'description' and product.description != blank and next_block.settings.collapse_content and next_block.settings.show_below_gallery != true
          assign block_group_class = 'accordion-group'
          assign block_group_name = 'accordion-group'
        elsif block.type == 'feature_with_icon' and next_block.type == 'feature_with_icon'
          assign block_group_class = 'feature-badge-list'
          assign block_group_name = 'feature-badge-list'
        elsif block.type == 'checklist_item' and next_block.type == 'checklist_item'
          assign block_group_class = 'checklist'
          assign block_group_name = 'checklist'
        elsif block.settings.slider_group != blank and next_block.settings.slider_group == block.settings.slider_group and slider_card_types contains block.type and slider_card_types contains next_block.type
          assign block_group_class = 'card-slider'
          assign block_group_name = 'card-slider-' | append: block.settings.slider_group
        else
          assign allow_block_group = false
          assign block_group_class = ''
          assign current_block_group_name = ''
        endif

        if allow_block_group
          assign new_block_group_name = block_group_name

          if inside_block_group_context == true and new_block_group_name != current_block_group_name
            assign allow_block_group = false
          else
            assign current_block_group_name = new_block_group_name
          endif
        endif
      -%}

      {%- capture block_content -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {%- render block -%}

          {%- when 'vendor' -%}
            {%- if product != blank -%}
              {%- render 'vendor' with product.vendor, class: 'h6 link-faded' -%}
            {%- else -%}
              {%- assign placeholder_vendor = 'general.on_boarding.product_vendor' | t -%}
              {%- render 'vendor' with placeholder_vendor, class: 'h6 link-faded' -%}
            {%- endif -%}

          {%- when 'title' -%}
            {%- if product != blank -%}
              {%- assign product_title = product.title -%}
            {%- else -%}
              {%- assign product_title = 'general.on_boarding.product_title' | t -%}
            {%- endif -%}

            {%- if request.page_type == 'product' and context == 'main_product' -%}
              <h1 class="product-title {{ block.settings.heading_tag }}">
                {{- product_title | downcase-}}
              </h1>
            {%- else -%}
              <h2 class="product-title {{ block.settings.heading_tag }}">
                <a href="{{ product.url }}">{{ product_title }}</a>
              </h2>
            {%- endif -%}

          {%- when 'sku' -%}
            {% if product.selected_or_first_available_variant.sku != blank %}
              <variant-sku class="variant-sku text-sm text-subdued">
                {{- 'product.general.sku' | t }} {{ product.selected_or_first_available_variant.sku -}}
              </variant-sku>
            {%- endif -%}

          {%- when 'badges' -%}
            {%- if product != blank -%}
              {%- render 'product-badges', product: product, variant: product.selected_or_first_available_variant, types: 'custom,discount', context: 'product' -%}
            {%- endif -%}

          {%- when 'price' -%}
            {%- if product.selected_or_first_available_variant != nil -%}
              <div class="v-stack">
                {%- render 'price-list', product: product, variant: product.selected_or_first_available_variant, context: 'product' -%}

                {%- if block.settings.show_taxes_notice -%}
                  <p class="text-sm text-subdued">
                    {%- if cart.taxes_included -%}
                      {{ 'product.general.taxes_included' | t }}
                    {%- else -%}
                      {{ 'product.general.taxes_excluded' | t }}
                    {%- endif -%}

                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'product.general.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'payment_terms' -%}
            {%- if product != blank -%}
              <payment-terms class="payment-terms">
                {%- capture product_installment_form_id -%}{{ product_form_id }}-payment-installment{%- endcapture -%}

                {%- form 'product', product, id: product_installment_form_id -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{- form | payment_terms -}}
                {%- endform -%}
              </payment-terms>
            {%- endif -%}

          {%- when 'rating' -%}
            {%- if product != blank -%}
              {%- render 'product-rating', product: product, show_empty: block.settings.show_empty, display_mode: block.settings.rating_mode, show_placeholder: false -%}
            {%- else -%}
              {%- render 'product-rating', show_placeholder: true -%}
            {%- endif -%}

          {%- when 'separator' -%}
            <hr>

          {%- when 'description' -%}
            {%- if product == blank -%}
              {%- assign product_description = 'general.on_boarding.product_description' | t -%}
            {%- else -%}
              {%- assign product_description = product.description -%}
            {%- endif -%}

            {%- if product_description != blank -%}
              {%- if block.settings.collapse_content -%}
                {%- assign accordion_title = 'product.general.description' | t -%}
                {%- render 'accordion', title: accordion_title, content: product_description, plus_minus: true, prose_content: true, block: block -%}
              {%- else -%}
                <div class="prose">
                  {{- product_description -}}
                </div>
              {%- endif -%}
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- if product != blank -%}
              {%- render 'variant-picker',
                  product: product,
                  form_id: product_form_id,
                  context: context,
                  hide_sold_out_variants: block.settings.hide_sold_out_variants,
                  selector_style: block.settings.selector_style,
                  swatch_selector_style: block.settings.swatch_selector_style,
                  variant_image_options: block.settings.variant_image_options,
                  variant_image_underline: block.settings.variant_image_show_underline,
                  size_chart_page: block.settings.size_chart_page,
                  shape_heading: block.settings.shape_heading,
                  enter_size_heading: block.settings.enter_size_heading -%}
            {%- endif -%}

          {%- when 'product_variations' -%}
            {%- liquid
              assign contains_product = false

              for product_variation in block.settings.products
                if product_variation == product
                  assign contains_product = true
                endif
              endfor
            -%}

            {%- if contains_product -%}
              {%- comment -%}
                IMPLEMENTATION NOTE: this feature allows to connect different products on the same page. It is therefore
                visually similar to a variant picker, although it does not share the functionality
              {%- endcomment -%}

              <div class="variant-picker v-stack gap-4">
                <div class="variant-picker__option v-stack gap-2">
                  {%- assign metafield_parts = block.settings.option_value_metafield | split: '.' -%}
                  {%- assign metafield_namespace = metafield_parts | first -%}
                  {%- assign metafield_key = metafield_parts | last -%}

                  {%- if block.settings.option_name != blank -%}
                    {%- assign metafield = product.metafields[metafield_namespace][metafield_key] -%}

                    <div class="h-stack gap-1">
                      <p class="text-subdued">{{ block.settings.option_name | escape }}:</p>

                      {%- liquid
                        assign label = metafield.value

                        if metafield.type == 'metaobject_reference' and metafield.value.system.type == 'shopify--color-pattern'
                          assign label = metafield.value.label
                        elsif block.settings.option_value_metafield == 'shopify.color-pattern' and metafield.value.count == 1
                          assign label = metafield | metafield_text: field: 'label'
                        endif
                      -%}

                      <span>{{ label }}</span>
                    </div>
                  {%- endif -%}

                  <div class="variant-picker__option-values h-stack gap-2.5 wrap">
                    {%- liquid
                      for product_variation in block.settings.products
                        assign metafield = product_variation.metafields[metafield_namespace][metafield_key]
                        assign color_metaobject = nil
                        assign label = metafield.value

                        if product_variation == product
                          assign selected = true
                        else
                          assign selected = false
                        endif

                        if metafield.type == 'metaobject_reference' and metafield.value.system.type == 'shopify--color-pattern'
                          assign label = metafield.value.label
                          assign color_metaobject = metafield.value
                        elsif block.settings.option_value_metafield == 'shopify.color-pattern' and metafield.value.count == 1
                          assign color_metaobject = metafield.value | first
                          assign label = metafield | metafield_text: field: 'label'
                        endif

                        case block.settings.selector_style
                          when 'swatch'
                            render 'option-value', type: 'swatch', color_metaobject: color_metaobject, url: product_variation.url, label: label, selected: selected

                          when 'swatch_underline'
                            render 'option-value', type: 'swatch_underline', color_metaobject: color_metaobject, url: product_variation.url, label: label, selected: selected

                          when 'variant_image'
                            render 'option-value', type: 'thumbnail', url: product_variation.url, label: label, image: product_variation.featured_media, selected: selected

                          when 'variant_image_underline'
                            render 'option-value', type: 'thumbnail', underline: true, url: product_variation.url, label: label, image: product_variation.featured_media, selected: selected

                          when 'block'
                            render 'option-value', type: 'block', url: product_variation.url, label: label, selected: selected

                          when 'block_swatch'
                            render 'option-value', type: 'block', color_metaobject: color_metaobject, url: product_variation.url, label: label, selected: selected, show_swatch: true
                        endcase
                      endfor
                    -%}
                  </div>
                </div>
              </div>
            {%- endif -%}

          {%- when 'color_pattern_picker' -%}
            {%- liquid
              assign color_metafield_path = block.settings.option_value_metafield | default: 'shopify.color-pattern'
              assign label_parts = color_metafield_path | split: '.'
              assign label_namespace = label_parts | first
              assign label_key = label_parts | last
              assign color_metafield = product.metafields[label_namespace][label_key]
              assign property_name = block.settings.property_name | default: 'Color' | strip

              # Only the colors stored on THIS product's metafield are offered. A list metaobject
              # reference (shopify.color-pattern always is one) can hold several colors; a single
              # reference or a plain text metafield yields exactly one.
              if color_metafield.type == 'list.metaobject_reference'
                assign color_values = color_metafield.value
              elsif color_metafield.type == 'metaobject_reference'
                # Single reference: iterate once and read the metaobject directly in the loop.
                assign color_values = 'single' | split: ','
              else
                assign color_values = color_metafield.value | split: ','
              endif
            -%}

            {%- if color_metafield != blank and color_values.size > 0 -%}
              {%- capture property_input_name -%}properties[{{ property_name | escape }}]{%- endcapture -%}

              <color-pattern-picker class="color-pattern-picker v-stack gap-3">
                {%- if block.settings.heading != blank -%}
                  <p class="color-pattern-picker__heading">
                    {{ block.settings.heading | escape }}: <span class="color-pattern-picker__selected" data-placeholder="Choose a color" style="font-weight:400;">Choose a color</span>
                  </p>
                {%- endif -%}

                <div class="color-pattern-picker__grid" role="radiogroup" aria-label="{{ block.settings.heading | default: property_name | escape }}">
                  {%- assign color_default_checked = false -%}
                  {%- for color_value in color_values -%}
                    {%- liquid
                      assign swatch_image = blank
                      assign swatch_colors = blank

                      if color_metafield.type == 'metaobject_reference'
                        assign color_value = color_metafield.value
                      endif

                      if color_metafield.type contains 'metaobject_reference'
                        assign color_label = color_value.label | strip
                        assign swatch_image = color_value.image.value
                        assign swatch_colors = color_value.color.value
                      else
                        assign color_label = color_value | strip
                      endif

                      if color_label == blank
                        continue
                      endif

                      if swatch_image != blank
                        assign swatch_url = swatch_image | image_url: width: 112
                        assign swatch_style = 'background-image: url(' | append: swatch_url | append: ')'
                      elsif swatch_colors != blank
                        if swatch_colors.first
                          assign swatch_color_list = swatch_colors | join: ', '
                          if swatch_colors.size == 1
                            assign swatch_color_list = swatch_color_list | append: ', ' | append: swatch_colors.first
                          endif
                        else
                          assign swatch_color_list = swatch_colors | append: ', ' | append: swatch_colors
                        endif
                        assign swatch_style = 'background-image: linear-gradient(to right, ' | append: swatch_color_list | append: ')'
                      else
                        assign swatch_style = 'background-color: ' | append: color_label | downcase | remove: ' '
                      endif

                      assign input_id = 'color-' | append: block.id | append: '-' | append: forloop.index
                      assign is_default_color = false
                      unless color_default_checked
                        assign is_default_color = true
                        assign color_default_checked = true
                      endunless
                    -%}

                    <input
                      class="sr-only"
                      type="radio"
                      id="{{ input_id }}"
                      name="{{ property_input_name }}"
                      value="{{ color_label | escape }}"
                      form="{{ product_form_id }}"
                      {% if is_default_color %}checked{% endif %}
                      {% if block.settings.required %}required{% endif %}
                    >
                    <label for="{{ input_id }}" class="color-pattern-picker__item" title="{{ color_label | escape }}" style="{{ swatch_style | escape }}">
                      <span class="sr-only">{{ color_label | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </color-pattern-picker>

              <script>
                if (!customElements.get('color-pattern-picker')) {
                  customElements.define('color-pattern-picker', class extends HTMLElement {
                    connectedCallback() {
                      this.addEventListener('change', () => this.update());
                      this.update();
                    }

                    update() {
                      const selected = this.querySelector('input[type="radio"]:checked');
                      const output = this.querySelector('.color-pattern-picker__selected');

                      if (output) {
                        output.textContent = selected ? selected.value : output.dataset.placeholder;
                      }
                    }
                  });
                }
              </script>
            {%- elsif request.design_mode -%}
              {%- comment -%}
                Renders nothing on the live storefront - only a merchant editing the theme sees
                this, so a missing metafield doesn't fail silently.
              {%- endcomment -%}
              <p class="color-pattern-picker__editor-hint text-subdued">
                "{{ product.title }}" has no colors in its "{{ color_metafield_path }}" metafield, so this block is hidden.
              </p>
            {%- endif -%}

          {%- when 'line_item_property' -%}
            {%- if block.settings.label != blank -%}
              {%- capture name -%}properties[{{ block.settings.label | escape }}]{%- endcapture -%}

              <div class="line-item-property">
                {%- liquid
                  if block.settings.type == 'text'
                    if block.settings.allow_long_text
                      render 'input', label: block.settings.label, name: name, form: product_form_id, multiline: 4, required: block.settings.required, maxlength: block.settings.max_length
                    else
                      render 'input', type: 'text', label: block.settings.label, name: name, form: product_form_id, required: block.settings.required, maxlength: block.settings.max_length
                    endif
                  elsif block.settings.type == 'checkbox'
                    render 'checkbox', label: block.settings.label, name: name, form: product_form_id, value: block.settings.checkbox_value, required: block.settings.required
                  elsif block.settings.type == 'dropdown' and block.settings.select_values != blank
                    assign option_values = block.settings.select_values | split: ','
                    render 'select', label: block.settings.label, option_values: option_values, show_empty_value: true, name: name, form: product_form_id, required: block.settings.required
                  endif
                -%}
              </div>
            {%- endif -%}

          {%- when 'quantity_selector' -%}
            {%- if product.available -%}
              <div class="v-stack gap-1 justify-items-start">
                {%- liquid
                  assign variant = product.selected_or_first_available_variant
                  assign quantity_rules = ''

                  render 'quantity-selector', variant: variant, form: product_form_id

                  if variant.quantity_rule.min > 1
                    assign rule = 'product.quantity.minimum_of' | t: min: variant.quantity_rule.min
                    assign quantity_rules = quantity_rules | append: ' / ' | append: rule
                  endif

                  if variant.quantity_rule.max != nil
                    assign rule = 'product.quantity.maximum_of' | t: max: variant.quantity_rule.max
                    assign quantity_rules = quantity_rules | append: ' / ' | append: rule
                  endif

                  if variant.quantity_rule.increment > 1
                    assign rule = 'product.quantity.increment_of' | t: step: variant.quantity_rule.increment
                    assign quantity_rules = quantity_rules | append: ' / ' | append: rule
                  endif
                -%}

                {%- if quantity_rules != blank -%}
                  <p class="text-subdued text-sm">{{ quantity_rules | remove_first: ' / ' | capitalize }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'volume_pricing' -%}
            {%- render 'volume-pricing-table', variant: product.selected_or_first_available_variant -%}

          {%- when 'inventory' -%}
            {%- render 'inventory',
                variant: product.selected_or_first_available_variant,
                show_in_stock_quantity: block.settings.show_in_stock_quantity,
                show_progress_bar: block.settings.show_progress_bar,
                progress_bar_max_value: block.settings.progress_bar_max_value,
                low_threshold: block.settings.low_inventory_threshold
            -%}

          {%- when 'buy_buttons' -%}
            {%- render 'buy-buttons',
                product: product,
                form_id: product_form_id,
                show_payment_button: block.settings.show_payment_button,
                show_gift_card_recipient: block.settings.show_gift_card_recipient,
                atc_button_background: block.settings.atc_button_background,
                atc_button_text_color: block.settings.atc_button_text_color,
                payment_button_background: block.settings.payment_button_background,
                payment_button_text_color: block.settings.payment_button_text_color
            -%}

          {%- when 'pickup_availability' -%}
            {%- if product != blank -%}
              {%- render 'pickup-availability', product_variant: product.selected_or_first_available_variant -%}
            {%- endif -%}

          {%- when 'offers' -%}
            {%- assign offers_count = 0 -%}

            {%- capture offers_content -%}
              {%- for i in (1..3) -%}
                {%- assign title_setting = 'offer_' | append: i | append: '_title' -%}
                {%- assign content_setting = 'offer_' | append: i | append: '_content' -%}

                {%- if block.settings[title_setting] != blank or block.settings[content_setting] != blank -%}
                  <div class="product-offers__item {% unless block.settings.stack_offers %}text-center{% endunless %} snap-center">
                    <div class="v-stack gap-2.5">
                      {%- if block.settings[title_setting] != blank -%}
                        <p class="h6">{{ block.settings[title_setting] }}</p>
                      {%- endif -%}

                      {%- if block.settings[content_setting] != blank -%}
                        <div class="prose">
                          {{- block.settings[content_setting] -}}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>

                  {%- assign offers_count = offers_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- if offers_content != blank -%}
              {%- assign carousel_id = 'product-offers-' | append: block.id -%}

              <div class="product-offers border" style="{% render 'surface', background: block.settings.background, text_color: block.settings.text_color, border_color: block.settings.border_color %}">
                <scroll-carousel id="{{ carousel_id }}" class="product-offers__list {% if block.settings.stack_offers or offers_count == 1 %}product-offers__list--stack divide-y{% else %}product-offers__list--carousel scroll-area snap-x{% endif %}">
                  {{ offers_content }}
                </scroll-carousel>

                {%- if block.settings.stack_offers == false and offers_count > 1 -%}
                  <carousel-navigation aria-controls="{{ carousel_id }}" class="page-dots">
                    {%- for i in (1..offers_count) -%}
                      <button class="tap-area" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                        <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                      </button>
                    {%- endfor -%}
                  </carousel-navigation>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'complementary_products' -%}
            {%- unless block.settings.show_below_gallery -%}
              {%- render 'complementary-products', product: product, block: block -%}
            {%- endunless -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="prose">
                {{- block.settings.text -}}
              </div>
            {%- endif -%}

          {%- when 'notice_banner' -%}
            {%- if block.settings.text != blank -%}
              <div class="notice-banner {% if block.settings.border_color != blank and block.settings.border_color != 'rgba(0,0,0,0)' %}border{% endif %}" style="{% render 'surface', background: block.settings.background, text_color: block.settings.text_color, border_color: block.settings.border_color %}">
                <span class="notice-banner__dot" aria-hidden="true"></span>
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endif -%}

          {%- when 'checklist_item' -%}
            {%- if block.settings.text != blank -%}
              <div class="checklist-item">
                {%- render 'icon' with 'picto-success', width: 16, class: 'text-success' -%}
                <p>{{ block.settings.text }}</p>
              </div>
            {%- endif -%}

          {%- when 'image_text_card' -%}
            {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.image != blank -%}
              {%- liquid
                assign card_image_width = block.settings.image_width | default: 80
                assign card_image_height = block.settings.image_height | default: 80
                assign card_image_request_width = card_image_width | times: 2
                assign card_image_sizes = card_image_width | append: 'px'
                assign card_image_widths = card_image_width | append: ',' | append: card_image_request_width
              -%}
              {%- capture card_image_style -%}
                width: {{ card_image_width }}px;
                {%- unless block.settings.show_checklist_icons -%}
                  height: {{ card_image_height }}px;
                {%- endunless -%}
              {%- endcapture -%}
              <div class="image-text-card {% if block.settings.show_checklist_icons %}image-text-card--checklist{% endif %} {% if block.settings.border_color != blank and block.settings.border_color != 'rgba(0,0,0,0)' %}border{% endif %}" style="{% render 'surface', background: block.settings.background, text_color: block.settings.text_color, border_color: block.settings.border_color %}">
                {%- if block.settings.image != blank -%}
                  {{-
                    block.settings.image
                    | image_url: width: card_image_request_width
                    | image_tag: loading: 'lazy', sizes: card_image_sizes, widths: card_image_widths, class: 'image-text-card__image', style: card_image_style
                  -}}
                {%- endif -%}

                <div class="v-stack gap-2 image-text-card__info">
                  {%- if block.settings.heading != blank -%}
                    <p class="image-text-card__heading" style="font-style:{{ block.settings.italic }}">{{ block.settings.heading }}</p>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="prose image-text-card__content">
                      {{- block.settings.text -}}
                    </div>
                  {%- endif -%}

                                    {%- liquid
                    assign card_button_url = block.settings.button_link
                    if block.settings.use_cad_email
                      capture card_button_url
                        render 'custom-rug-inquiry-url', type: 'cad'
                      endcapture
                      assign card_button_url = card_button_url | strip
                    endif
                  -%}
                  {%- if block.settings.button_label != blank and card_button_url != blank -%}
                    {%- render 'button',
                      href: card_button_url,
                      content: block.settings.button_label,
                      size: 'sm',
                      style: block.settings.button_style,
                      background: block.settings.button_background,
                      text_color: block.settings.button_text_color,
                    -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'swatch_card' -%}
            {%- liquid
              # Lowest priced variant still in stock (eg. the rug swatch); fall back to the lowest priced overall.
              assign swatch_variant = product.variants | where: 'available' | sort: 'price' | first
              if swatch_variant == blank
                assign swatch_variant = product.variants | sort: 'price' | first
              endif
            -%}

            {%- if swatch_variant != blank -%}
              {%- assign swatch_form_id = 'swatch-card-form-' | append: section.id | append: '-' | append: block.id -%}
              {%- assign swatch_media = swatch_variant.featured_media | default: product.featured_media -%}

              <div class="image-text-card swatch-card {% if block.settings.border_color != blank and block.settings.border_color != 'rgba(0,0,0,0)' %}border{% endif %}" style="{% render 'surface', background: block.settings.background, text_color: block.settings.text_color, border_color: block.settings.border_color %}">
                {%- if block.settings.heading != blank -%}
                  <p class="image-text-card__heading">{{ block.settings.heading | escape }}</p>
                {%- endif -%}

                <div class="swatch-card__product">
                  {%- if swatch_media != blank -%}
                    {{- swatch_media | image_url: width: 128 | image_tag: loading: 'lazy', sizes: '64px', widths: '64,128', class: 'swatch-card__image' -}}
                  {%- endif -%}

                  <div class="swatch-card__details">
                    <p class="swatch-card__title">
                      {{- product.title -}}
                      {%- unless swatch_variant.title == 'Default Title' %} - {{ swatch_variant.title }}{% endunless -%}
                    </p>
                    <p class="swatch-card__price">{{ swatch_variant.price | money }}</p>
                  </div>

                  {%- liquid
                    assign swatch_quantity = swatch_variant.quantity_rule.min | default: 1
                    assign swatch_button_label = block.settings.button_label | default: 'Add'
                  -%}

                  <swatch-card-form class="swatch-card__form" form="{{ swatch_form_id }}">
                    <product-form>
                      {%- form 'product', product, id: swatch_form_id -%}
                        <input type="hidden" name="id" value="{{ swatch_variant.id }}">
                        <input type="hidden" name="quantity" value="{{ swatch_quantity }}">
                        <input type="hidden" name="on_success" value="force_open_drawer">
                        <input type="hidden" value="" disabled data-swatch-color-property>

                        {%- capture swatch_button_style -%}
                          {%- if block.settings.button_background != blank and block.settings.button_background != 'rgba(0,0,0,0)' -%}--button-background: {{ block.settings.button_background.rgb }};{%- endif -%}
                          {%- if block.settings.button_text_color != blank and block.settings.button_text_color != 'rgba(0,0,0,0)' -%}--button-text-color: {{ block.settings.button_text_color.rgb }};{%- endif -%}
                        {%- endcapture -%}

                        <button
                          type="submit"
                          class="button button--sm swatch-card__button"
                          style="{{ swatch_button_style }}"
                          data-label="{{ swatch_button_label | escape }}"
                          data-added-label="{{ 'product.general.added_to_cart' | t | escape }}"
                          {% unless swatch_variant.available %}disabled{% endunless %}
                        >
                          {%- if swatch_variant.available -%}
                            {{- swatch_button_label | escape -}}
                          {%- else -%}
                            {{- 'product.general.sold_out_button' | t -}}
                          {%- endif -%}
                        </button>
                      {%- endform -%}
                    </product-form>
                  </swatch-card-form>
                </div>

                <p class="swatch-card__error" role="alert" hidden></p>
              </div>
              <script>
                if (!customElements.get('swatch-card-form')) {
                  // Adds feedback around the theme's <product-form> (which does the actual AJAX add + cart drawer):
                  // busy state while adding, "Added" confirmation, and the cart error message (eg. out of stock).
                  customElements.define('swatch-card-form', class extends HTMLElement {
                    connectedCallback() {
                      this.abortController = new AbortController();
                      const signal = this.abortController.signal;
                      const form = document.getElementById(this.getAttribute('form'));

                      if (!form) return;
                      this.addEventListener('submit', () => this.syncSelectedColor(), { capture: true, signal });
                      form.addEventListener('submit', () => this.setBusy(true), { signal });
                      form.addEventListener('variant:add', () => this.onAdded(), { signal });
                      form.addEventListener('cart:error', (event) => this.onError(event.detail?.error), { signal });
                    }

                    disconnectedCallback() {
                      this.abortController?.abort();
                      clearTimeout(this.resetTimeout);
                      clearTimeout(this.busyTimeout);
                    }

                    get button() {
                      return this.querySelector('.swatch-card__button');
                    }
                    syncSelectedColor() {
                      const hiddenInput = this.querySelector('[data-swatch-color-property]');
                      const scope = this.closest('.product-info') || document;
                      const selectedColor = scope.querySelector('color-pattern-picker input[type="radio"]:checked');

                      if (!hiddenInput) return;

                      if (selectedColor) {
                        hiddenInput.name = selectedColor.name;
                        hiddenInput.value = selectedColor.value;
                        hiddenInput.disabled = false;
                      } else {
                        hiddenInput.removeAttribute('name');
                        hiddenInput.disabled = true;
                      }
                    }
                    get errorElement() {
                      return this.closest('.swatch-card')?.querySelector('.swatch-card__error');
                    }

                    setBusy(isBusy) {
                      this.button?.classList.toggle('is-loading', isBusy);
                      clearTimeout(this.busyTimeout);

                      // Safety net: never leave the button stuck if the request fails without a cart event (eg. offline).
                      if (isBusy) this.busyTimeout = setTimeout(() => this.setBusy(false), 10000);
                      if (this.errorElement) this.errorElement.hidden = true;
                    }

                    onAdded() {
                      this.setBusy(false);
                      this.showLabel(this.button?.dataset.addedLabel);
                    }

                    onError(message) {
                      this.setBusy(false);

                      if (this.errorElement && message) {
                        this.errorElement.textContent = message;
                        this.errorElement.hidden = false;
                      }
                    }

                    showLabel(label) {
                      const button = this.button;
                      if (!button || !label) return;

                      button.textContent = label;
                      clearTimeout(this.resetTimeout);
                      this.resetTimeout = setTimeout(() => (button.textContent = button.dataset.label), 2500);
                    }
                  });
                }
              </script>
            {%- endif -%}

          {%- when 'accordion' -%}
            {%- liquid
              assign accordion_title = block.settings.title | default: block.settings.page.title
              assign accordion_content = block.settings.page.content | default: block.settings.liquid | default: block.settings.content
            -%}
            {%- capture accordion_extras -%}{%- render 'accordion-extras', block: block -%}{%- endcapture -%}
            {%- assign accordion_content = accordion_content | append: accordion_extras -%}
            {%- if accordion_title != blank and accordion_content != blank -%}
              {%- render 'accordion', title: accordion_title, content: accordion_content, prose_content: true, plus_minus: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, block: block -%}
            {%- endif -%}

          {%- when 'review' -%}
            {%- render 'pdp-review', block: block -%}

          {%- when 'real_homes_reel' -%}
            {%- render 'pdp-real-homes', block: block -%}

          {%- when 'contact_consultation' -%}
            {%- render 'pdp-contact-consultation', block: block -%}

          {%- when 'disclosures' -%}
            {%- if product != blank -%}
                {%- render 'product-disclosures', product: product, collapse_content: block.settings.collapse_content -%}
            {%- endif -%}

          {%- when 'feature_with_icon' -%}
            {%- if block.settings.text != blank or block.settings.icon != 'none' or block.settings.custom_icon != blank -%}
              {%- capture feature_content -%}
                {%- if block.settings.custom_icon != blank -%}
                  {%- capture sizes -%}{{ block.settings.icon_width }}px{%- endcapture -%}
                  {%- capture widths -%}{{ block.settings.icon_width }}, {{ block.settings.icon_width | times: 2 | at_most: block.settings.custom_icon.width }}{%- endcapture -%}
                  {%- capture style -%}--image-max-width: {{ block.settings.icon_width }}px{%- endcapture -%}
                  {{- block.settings.custom_icon | image_url: width: block.settings.custom_icon.width | image_tag: sizes: sizes, widths: widths, class: 'constrained-image', style: style -}}
                {%- else -%}
                  {%- render 'icon' with block.settings.icon, width: block.settings.icon_width -%}
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text }}</p>
                {%- endif -%}
              {%- endcapture -%}

              {%- assign has_border = false -%}

              {%- if block.settings.border_color != blank and block.settings.border_color != 'rgba(0,0,0,0)' -%}
                {%- assign has_border = true -%}
              {%- endif -%}

              {%- if block.settings.link -%}
                <a href="{{ block.settings.link }}" class="feature-badge {% if has_border %}border{% endif %}" style="{% render 'surface', background: block.settings.background, text_color: block.settings.text_color, border_color: block.settings.border_color %}">
                  {{- feature_content -}}
                </a>
              {%- else -%}
                <div class="feature-badge {% if has_border %}border{% endif %}" style="{% render 'surface', background: block.settings.background, text_color: block.settings.text_color, border_color: block.settings.border_color %}">
                  {{- feature_content -}}
                </div>
              {%- endif -%}
            {%- endif -%}

          {%- when 'liquid' -%}
            {%- if block.settings.liquid != blank -%}
              <div class="liquid">
                {{- block.settings.liquid -}}
              </div>
            {%- endif -%}

          {%- when 'modal' -%}
            {%- if block.settings.button_title != blank and block.settings.modal_content != blank -%}
              {%- assign modal_id = product_form_id | append: block.id -%}

              {%- render 'button', content: block.settings.button_title, aria_controls: modal_id, style: block.settings.button_style, stretch: block.settings.stretch_button, background: block.settings.button_background, text_color: block.settings.button_text_color -%}

              <x-modal id="{{ modal_id | escape }}" class="modal modal--lg color-scheme color-scheme--dialog">
                <span class="h5" slot="header">{{ block.settings.modal_title }}</span>

                <div class="prose">
                  {{- block.settings.modal_content -}}
                </div>
              </x-modal>
            {%- endif -%}

          {%- when 'image' -%}
            {%- if block.settings.image != blank -%}
              {%- capture image_style_attribute -%}{% if block.settings.alignment == 'center' %}margin-inline: auto;{% elsif block.settings.alignment == 'end' %}margin-inline-start: auto;{% endif %}{%- endcapture -%}

              {%- if block.settings.width_mode == 'custom' -%}
                {%- capture image_style_attribute -%}{{ image_style_attribute }} --image-max-width: {{ block.settings.max_width }}px; --image-mobile-max-width: {{ block.settings.mobile_max_width }}px{%- endcapture -%}
                {%- capture image_sizes_attribute -%}(max-width: 699px) min({{ block.settings.mobile_max_width }}px, 100vw), min({{ block.settings.max_width }}px, 100vw){%- endcapture -%}
              {%- else -%}
                {%- capture image_sizes_attribute -%}min(600px, 100vw){%- endcapture -%}
                {%- capture image_style_attribute -%}width: 100%;{%- endcapture -%}
              {%- endif -%}

              {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: sizes: image_sizes_attribute, widths: '200,300,400,500,600,800,1000,1200,1400', class: 'constrained-image', style: image_style_attribute -}}
            {%- endif -%}

          {%- when 'button' -%}
            {%- if block.settings.text != blank -%}
              {%- liquid
                assign button_icon = block.settings.icon
                if button_icon == 'none'
                  assign button_icon = blank
                endif
              -%}
              {%- render 'button', href: block.settings.link, external: block.settings.open_new_tab, content: block.settings.text, stretch: block.settings.stretch, style: block.settings.style, icon: button_icon, background: block.settings.background, text_color: block.settings.text_color, border_color: block.settings.border_color -%}
            {%- endif -%}

          {%- when 'share_buttons' -%}
            <share-button>
              <button class="share-buttons share-buttons--native link-faded" hidden>
                <span class="smallcaps text-xxs">{{- 'general.social.share' | t -}}</span>
                {%- render 'icon' with 'share' -%}
              </button>

              <div class="share-buttons">
                <span class="smallcaps text-xxs text-subdued">{{- 'general.social.share' | t -}}</span>
                {%- render 'share-buttons', url: product.url, title: product.title, description: product.description, layout: 'list' -%}
              </div>
            </share-button>

          {%- when 'more_information' -%}
            {%- comment -%}We need at least one block compatible with below gallery information{%- endcomment -%}
            {%- if block.settings.text != blank and has_content_below_gallery -%}
              <a href="#product-extra-information" class="product-info__more-info md-max:hidden">
                <span class="smallcaps text-xxs">{{- block.settings.text -}}</span>
                {%- render 'icon' with 'chevron-right' -%}
              </a>
            {%- endif -%}

          {%- when 'product-faq' -%}
            {%- render 'product-faq', block: block -%}
        {%- endcase -%}
      {%- endcapture -%}

      {%- if allow_block_group and inside_block_group_context == false -%}
        {%- assign inside_block_group_context = true -%}
        <div class="product-info__block-group {{ block_group_class }}" data-group-type="{{ block_group_name }}">

        {%- if block_group_class == 'card-slider' -%}
          {%- liquid
            assign inside_card_slider = true
            assign any_card_slider = true
            assign card_slider_id = 'card-slider-' | append: section.id | append: '-' | append: block.id
            assign card_slider_group = block.settings.slider_group
            assign card_slider_count = 0

            for slider_block in filtered_blocks offset: forloop.index0
              if slider_block.settings.slider_group == card_slider_group and slider_card_types contains slider_block.type
                assign card_slider_count = card_slider_count | plus: 1
              else
                break
              endif
            endfor
          -%}
          <scroll-carousel id="{{ card_slider_id }}" class="card-slider__track">
        {%- endif -%}
      {%- endif -%}

      {%- liquid
        assign is_mobile_hero = false
        if block.type == 'title' or block.type == 'price'
          assign is_mobile_hero = true
        elsif block.type == 'liquid' and block.settings.liquid contains 'pdp-rating'
          assign is_mobile_hero = true
        elsif block.type == 'liquid' and block.settings.liquid contains 'pdp-short-description'
          assign is_mobile_hero = true
        elsif block.type == 'liquid' and block.settings.liquid contains 'pdp-product-pill'
          assign is_mobile_hero = true
        elsif block.type == 'liquid' and block.settings.liquid contains 'pdp-price-savings'
          assign is_mobile_hero = true
        endif
      -%}

      <div
        class="product-info__block-item"
        data-block-id="{{ block.id }}"
        data-block-type="{{ block.type | replace: '_', '-' }}"
        {% if is_mobile_hero %}data-mobile-hero="true"{% endif %}
        {% unless block.type == '@app' or block.type == 'accordion' or block.type == 'product-faq' %}
          {{- block.shopify_attributes -}}
        {% endunless %}
      >
        {{- block_content -}}
      </div>

      {%- if inside_block_group_context and allow_block_group == false -%}
        {%- assign inside_block_group_context = false -%}

        {%- if inside_card_slider -%}
          {%- assign inside_card_slider = false -%}
          </scroll-carousel>

          <carousel-navigation aria-controls="{{ card_slider_id }}" class="page-dots page-dots--narrow">
            {%- for i in (1..card_slider_count) -%}
              <button type="button" class="relative" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
              </button>
            {%- endfor -%}
          </carousel-navigation>
                    {%- if card_slider_count > 1 -%}
            <card-slider-autoplay aria-controls="{{ card_slider_id }}" data-interval="5000" hidden></card-slider-autoplay>
          {%- endif -%}
        {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
      {%- if any_card_slider -%}
      <script>
        if (!customElements.get('card-slider-autoplay')) {
          customElements.define('card-slider-autoplay', class extends HTMLElement {
            connectedCallback() {
              this.carousel = document.getElementById(this.getAttribute('aria-controls'));

              if (!this.carousel || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

              this.abortController = new AbortController();
              const signal = this.abortController.signal;
              const slider = this.carousel.closest('.card-slider') || this.carousel;

              this.isHovered = false;
              this.isInView = false;

              slider.addEventListener('mouseenter', () => { this.isHovered = true; }, { signal });
              slider.addEventListener('mouseleave', () => { this.isHovered = false; this.restart(); }, { signal });
              slider.addEventListener('focusin', () => { this.isHovered = true; }, { signal });
              slider.addEventListener('focusout', () => { this.isHovered = false; this.restart(); }, { signal });
              slider.addEventListener('touchstart', () => this.restart(), { passive: true, signal });
              slider.addEventListener('click', () => this.restart(), { signal });

              this.observer = new IntersectionObserver(([entry]) => {
                this.isInView = entry.isIntersecting;
              }, { threshold: 0.5 });
              this.observer.observe(this.carousel);

              this.restart();
            }

            disconnectedCallback() {
              this.abortController?.abort();
              this.observer?.disconnect();
              clearInterval(this.timer);
            }

            get interval() {
              return Math.max(parseInt(this.dataset.interval, 10) || 2000, 2000);
            }

            restart() {
              clearInterval(this.timer);
              this.timer = setInterval(() => this.advance(), this.interval);
            }

            advance() {
              const carousel = this.carousel;

              if (this.isHovered || !this.isInView || document.hidden || !carousel?.cells?.length) return;

              const nextIndex = carousel.selectedIndex + 1 >= carousel.cells.length ? 0 : carousel.selectedIndex + 1;
              carousel.select(nextIndex);
            }
          });
        }
      </script>
    {%- endif -%}
  </div>

  {%- comment -%}
    IMPLEMENTATION NOTE: under rare circumstances, merchant may want to show selectors to allow variant selection, but hide
    the add to cart button. This is however problematic as product info is changed based on the form, so we create a default
    one if no buy buttons exists
  {%- endcomment -%}

  {%- assign buy_buttons_block = section.blocks | where: 'type', 'buy_buttons' | first -%}

  {%- unless buy_buttons_block != blank or product == blank -%}
    {%- form 'product', product, id: product_form_id, hidden: true -%}
      <input type="hidden" disabled name="id" value="{{ product.selected_or_first_available_variant.id }}">
    {%- endform -%}
  {%- endunless -%}
</safe-sticky>