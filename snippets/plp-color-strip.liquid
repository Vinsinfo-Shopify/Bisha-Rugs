{%- doc -%}
  "Shop by Color" strip shown above the toolbar when enable_new_filters is on.

  @param {object} results - either collection or search drop to extract the colour filter from
  @param {object} [section]
{%- enddoc -%}

{%- liquid
  # Find the colour filter in whatever Search & Discovery returns.
  # Nothing here is hardcoded: the values, labels, counts, URLs and
  # active states all come from results.filters. Only the name of
  # the GROUP is configurable, because Shopify gives no other way to
  # tell one list filter from another.
  assign color_filter = null
  assign wanted = section.settings.color_filter_label | downcase | strip

  for f in results.filters
    if color_filter == null
      assign f_label = f.label | downcase | strip
      assign f_param = f.param_name | downcase

      if f_label == wanted or f_param contains 'color' or f_param contains 'colour'
        assign color_filter = f
      endif
    endif
  endfor
-%}

{%- if color_filter != null and color_filter.values.size > 0 -%}
  <div class="pf-colors">
    <p class="pf-colors__heading">{{ section.settings.color_filter_heading }}</p>

    <div class="pf-colors__track">
      {%- comment -%}
        "All" is not a filter value, it is the cleared state. Shopify
        provides the group's own url_to_remove, which strips every
        selected colour at once, and the pill is active exactly when
        nothing in the group is selected. Nothing is hardcoded.
      {%- endcomment -%}
      {%- capture all_pill -%}
      <a
        class="pf-color {% if color_filter.active_values.size == 0 %}is-active{% endif %}"
        href="{{ color_filter.url_to_remove }}"
        {% if color_filter.active_values.size == 0 %}aria-current="true"{% endif %}
      >
        {%- if section.settings.color_all_image != blank -%}
          {{-
            section.settings.color_all_image
            | image_url: width: 160
            | image_tag: class: 'pf-color__media', loading: 'lazy', widths: '56,112,160', sizes: '56px', alt: ''
          -}}
        {%- else -%}
          <span class="pf-color__media pf-color__media--all"></span>
        {%- endif -%}

        <span class="pf-color__label">{{ section.settings.color_all_label }}</span>
      </a>
      {%- endcapture -%}

      {%- for pass in (1..2) -%}
      {%- if pass == 2 -%}{{ all_pill }}{%- endif -%}
      {%- for value in color_filter.values -%}
        {%- liquid
          # Pass 1 renders the selected colours, pass 2 the others.
          if pass == 1 and value.active == false
            continue
          endif
          if pass == 2 and value.active
            continue
          endif
        -%}
        {%- comment -%}
          url_to_add and url_to_remove are Shopify's own, so the link
          carries the real filter state and a plain navigation applies
          it. active comes from Shopify too, so after the section is
          re-rendered the selected colour is still marked.
        {%- endcomment -%}
        <a
          class="pf-color {% if value.active %}is-active{% endif %}"
          href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
          {% if value.active %}aria-current="true"{% endif %}
        >
          {%- if value.image != blank -%}
            {{-
              value.image
              | image_url: width: 120
              | image_tag: class: 'pf-color__media', loading: 'lazy', widths: '40,80,120', sizes: '40px', alt: ''
            -}}
          {%- elsif value.swatch.image != blank -%}
            {{-
              value.swatch.image
              | image_url: width: 120
              | image_tag: class: 'pf-color__media', loading: 'lazy', widths: '40,80,120', sizes: '40px', alt: ''
            -}}
          {%- elsif value.swatch.color != blank -%}
            <span class="pf-color__media" style="background: {{ value.swatch.color }};"></span>
          {%- endif -%}

          <span class="pf-color__label">{{ value.label }}</span>
        </a>
      {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
