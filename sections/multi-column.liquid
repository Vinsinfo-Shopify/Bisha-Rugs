    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:global.padding.padding_left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
