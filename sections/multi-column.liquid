        {
          "type": "color",
          "id": "number_color",
          "label": "Number color",
          "default": "#B76E45"
        },
        {
          "type": "header",
          "content": "Review card layout"
        },
        {
          "type": "checkbox",
          "id": "review_layout",
          "label": "Use review card layout",
          "info": "Wraps the block in a bordered card and moves the icon/title/subheading below the content, styled as an avatar + name, matching a testimonial layout.",
          "default": false
        }
      ]
    },
    {
      "type": "video_with_text",
      "name": "t:sections.multi_column.blocks.video_with_text.name",
      "settings": [
        { "type": "video", "id": "video", "label": "t:global.video.video" },
        {
          "type": "checkbox",
          "id": "autoplay",
