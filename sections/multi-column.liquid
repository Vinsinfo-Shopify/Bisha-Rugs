          "label": "t:global.text.content",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
        },
        { "type": "url", "id": "link_url", "label": "t:global.text.link_url" },
        { "type": "text", "id": "link_text", "label": "t:global.text.link_text" },
        {
          "type": "header",
          "content": "Review rating"
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show star rating",
          "default": false
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5,
          "visible_if": "{{ block.settings.show_rating }}"
        },
        {
          "type": "color",
          "id": "rating_color",
          "label": "Star color",
          "default": "#E8B923",
          "visible_if": "{{ block.settings.show_rating }}"
        },
                {
          "type": "header",
          "content": "Step number"
        },
        {
          "type": "text",
          "id": "number",
