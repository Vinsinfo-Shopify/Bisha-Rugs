{%- if section.blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      --multi-column-gap: {% if section.settings.spacing == 'xs' %}9px{% elsif section.settings.spacing == 'sm' %}18px{% elsif section.settings.spacing == 'md' %}32px{% else %}48rem{% endif %};
      /* Mobile-first: default to a 2-column grid (matches Figma mobile layout) */
      --multi-column-columns-per-row: 2;
      --multi-column-column-width: calc(100% / var(--multi-column-columns-per-row) - var(--multi-column-gap) * ((var(--multi-column-columns-per-row) - 1) / var(--multi-column-columns-per-row)));
      --multi-column-grid: auto / repeat(var(--multi-column-columns-per-row), var(--multi-column-column-width));
      --multi-column-content-alignment: safe {{ section.settings.content_alignment }};

      /* Mobile section padding (theme setting driven) */
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      padding-left: {{ section.settings.padding_left_mobile }}px;
      padding-right: {{ section.settings.padding_right_mobile }}px;
    }

    @media screen and (max-width: 698px) {
      #shopify-section-{{ section.id }} .multi-column.multi-column--stack-mobile {
        --multi-column-columns-per-row: 1;
        --multi-column-column-width: 100%;
        --multi-column-grid: auto / repeat(auto-fit, var(--multi-column-column-width));
      }
    }

    /* Desktop: use the merchant-configured columns-per-row and padding */
    @media screen and (min-width: 999px) {
      #shopify-section-{{ section.id }} {
        --multi-column-gap: {% if section.settings.spacing == 'xs' %}1rem{% elsif section.settings.spacing == 'sm' %}2rem{% elsif section.settings.spacing == 'md' %}3rem{% else %}4rem{% endif %};
        --multi-column-columns-per-row: {{ section.settings.columns_per_row }};
        --multi-column-column-width: calc(100% / var(--multi-column-columns-per-row) - var(--multi-column-gap) * ((var(--multi-column-columns-per-row) - 1) / var(--multi-column-columns-per-row)));

        padding-top: {{ section.settings.padding_top_desktop }}px;
        padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
        padding-left: {{ section.settings.padding_left_desktop }}px;
        padding-right: {{ section.settings.padding_right_desktop }}px;
      }
    }

    #shopify-section-{{ section.id }} .multi-column {
      display: grid;
      grid-template: var(--multi-column-grid);
      gap: var(--multi-column-gap);
      row-gap : 43.5px;
      align-items: start;
      justify-content: var(--multi-column-content-alignment);
    }

    #shopify-section-{{ section.id }} .multi-column__item {
      display: flex;
      flex-direction: column;
    }

    /* Equal-height media regardless of the source image/video's natural dimensions */
    #shopify-section-{{ section.id }} .multi-column__media {
      width: 100%;
      height: {{ section.settings.media_height | default: '400px' }};
      overflow: hidden;
      border-radius: var(--multi-column-media-radius, 0);
    }
    @media screen and (min-width: 1600px) {
      #shopify-section-{{ section.id }} .multi-column__media {
        height: 700px;
      }
    }
    @media screen and (max-width: 500px) {
      #shopify-section-{{ section.id }} .multi-column__media {
        height: 220px;
      }
    }

    #shopify-section-{{ section.id }} .multi-column__media img,
    #shopify-section-{{ section.id }} .multi-column__media video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* --- Review card layout (opt-in via block setting, does not affect existing blocks) --- */
    #shopify-section-{{ section.id }} .multi-column__item--review {
      border: 1px solid rgba(var(--color-foreground), 0.08);
      border-radius: 12px;
    }

    #shopify-section-{{ section.id }} .multi-column-card_rating {
      display: flex;
      align-items: center;
      gap: 2px;
      margin-bottom: 18px;
    }

    #shopify-section-{{ section.id }} .multi-column-card_star {
      flex-shrink: 0;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .multi-column-card_heading-wrapper--review {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .multi-column-card_icon--avatar {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
        @media screen and (max-width: 768px){
          #shopify-section-{{ section.id }} .multi-column-card_icon--avatar {
                width: 34px;
                height: 34px;
              }
                  #shopify-section-{{ section.id }} .multi-column-card_heading-wrapper--review {
                      gap: 12px;
                      margin-top: 14.5px;
                    }
                        #shopify-section-{{ section.id }} .multi-column-card_rating {
                    margin-bottom: 6px;
                  }
        }
        /* --- Step number: base (safe everywhere) --- */
#shopify-section-{{ section.id }} .multi-column-card_number {
  margin: 0 0 8px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
}

/* --- Scoped to application_process only; other section instances unaffected --- */
#shopify-section-{{ section.id }} .application_process .multi-column-card_heading-group {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  column-gap: 12px;
}

#shopify-section-{{ section.id }} .application_process .multi-column-card_number,
#shopify-section-{{ section.id }} .application_process .multi-column-card_heading-wrapper {
  margin: 0;
}

#shopify-section-{{ section.id }} .application_process .multi-column-card_subheading {
  flex-basis: 100%;
}

#shopify-section-{{ section.id }} .application_process .multi-column__item {
  padding: 20px 0;
  border-top: 1px solid rgba(var(--color-foreground), 0.12);
}

#shopify-section-{{ section.id }} .application_process .multi-column__item:first-child {
  border-top: 0;
  padding-top: 0;
}

@media screen and (min-width: 999px) {
  #shopify-section-{{ section.id }} .application_process .multi-column-card_heading-group {
    display: block;
  }

  #shopify-section-{{ section.id }} .application_process .multi-column__item {
    padding: 0;
    border-top: 0;
    position: relative;
  }

  #shopify-section-{{ section.id }} .application_process .multi-column__item:not(:first-child)::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -24px;
    border-left: 1px dashed rgba(var(--color-foreground), 0.35);
  }
}
  </style>

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="{% unless section.settings.remove_section_spacing %}section-spacing{% endunless %} color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %} {{ section.settings.custom_class }}">
    <div class="container">
      <div class="section-stack">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.title,
          heading_style: section.settings.heading_style,
          content: section.settings.content,
          text_alignment: section.settings.content_alignment
        -%}

        <multi-column class="multi-column {% if section.settings.stack_on_mobile %}multi-column--stack-mobile{% endif %}">
          {%- for block in section.blocks -%}
            <div
              class="multi-column__item {% if section.settings.overlap_image and block.settings.title != blank %}multi-column__item--overlap{% endif %} {% if block.settings.review_layout %}multi-column__item--review{% endif %} group"
              {{ block.shopify_attributes }}
            >
              {%- capture sizes_attribute -%}
                (max-width: 998px) 50vw, calc((100vw - 3rem * 2) / {{ section.settings.columns_per_row }})
              {%- endcapture -%}

              {%- liquid
                capture media_content
                  if block.type == 'image_with_text' and block.settings.image != blank
                    assign loading_strategy = null

                    if forloop.index > 2 or section.location == 'footer'
                      assign loading_strategy = 'lazy'
                    endif

                    echo block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading_strategy, sizes: sizes_attribute, widths: '300,400,500,600,800,1000,1200,1400,1600,1800', class: 'zoom-image group-hover:zoom'
                  elsif block.type == 'video_with_text' and block.settings.video != blank
                    if block.settings.autoplay and block.settings.loop
                      assign show_controls = false
                    else
                      assign show_controls = true
                    endif

                    render 'media', media: block.settings.video, autoplay: block.settings.autoplay, loop: block.settings.loop, controls: show_controls, sizes: sizes_attribute, play_button_background: block.settings.play_button_background
                  endif
                endcapture
              -%}

              {%- if media_content != blank -%}
                {% liquid
                  assign add_link = false

                  if block.type == 'video_with_text' and block.settings.autoplay and block.settings.link_url != blank
                    assign add_link = true
                  elsif block.type == 'image_with_text' and block.settings.link_url != blank
                    assign add_link = true
                  endif
                -%}

                {%- if add_link -%}
                  <a href="{{ block.settings.link_url }}" class="multi-column__media overflow-hidden">
                    {{- media_content -}}
                  </a>
                {%- else -%}
                  <div class="multi-column__media overflow-hidden">
                    {{- media_content -}}
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- if block.settings.title != blank or block.settings.content != blank or block.settings.link_text != blank or block.settings.show_rating -%}
                <div class="prose text-{{ section.settings.text_alignment }}">
                  {%- liquid
                    if block.settings.heading_tag == 'custom'
                      assign heading_class = 'multi-column-card_heading'
                      assign heading_font_size = block.settings.custom_heading_size | default: 24
                    else
                      assign heading_class = block.settings.heading_tag | append: ' multi-column-card_heading'
                      assign heading_font_size = nil
                    endif
                  -%}

                  {%- if block.settings.show_rating -%}
                    <div class="multi-column-card_rating" style="color: {{ block.settings.rating_color }};" role="img" aria-label="Rated {{ block.settings.rating }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        {%- if i <= block.settings.rating -%}
                          <svg class="multi-column-card_star" viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>
                        {%- else -%}
                          <svg class="multi-column-card_star multi-column-card_star--empty" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/></svg>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- unless block.settings.review_layout -%}
                    {%- if block.settings.title != blank -%}
                      <div class="multi-column-card_heading-group">
                        {%- if block.settings.number != blank -%}
                          <p class="multi-column-card_number" style="color: {{ block.settings.number_color }};">{{ block.settings.number }}</p>
                        {%- endif -%}
                        <div class="multi-column-card_heading-wrapper">
                          {%- if block.settings.icon != blank -%}
                            {{ block.settings.icon | image_url: width: 48 | image_tag: class: 'multi-column-card_icon', widths: '24,32,48', loading: 'lazy' }}
                          {%- endif -%}
                          <p
                            class="{{ heading_class }}"
                            {% if heading_font_size %}
                              style="font-size: {{ heading_font_size }}px;"
                            {% endif %}
                          >{{ block.settings.title }}</p>
                        </div>
                        {%- if block.settings.subheading != blank -%}
                          <p class="multi-column-card_subheading">{{ block.settings.subheading }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endunless -%}

                  <div class="multi-column-card_content">
                  {{- block.settings.content -}}
                  </div>

                  {%- if block.settings.review_layout and block.settings.title != blank -%}
                    <div class="multi-column-card_heading-wrapper multi-column-card_heading-wrapper--review">
                      {%- if block.settings.icon != blank -%}
                        {{ block.settings.icon | image_url: width: 96 | image_tag: class: 'multi-column-card_icon multi-column-card_icon--avatar', widths: '48,64,96', loading: 'lazy' }}
                      {%- endif -%}
                      <div class="heading_class_wrapper">
                        <p
                          class="{{ heading_class }}"
                          {% if heading_font_size %}
                            style="font-size: {{ heading_font_size }}px;"
                          {% endif %}
                        >{{ block.settings.title }}</p>
                        {%- if block.settings.subheading != blank -%}
                          <p class="multi-column-card_subheading">{{ block.settings.subheading }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.link_text != blank -%}
                    <a href="{{ block.settings.link_url }}" class="link">{{ block.settings.link_text | escape }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </multi-column>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.multi_column.name",
  "class": "shopify-section--multi-column",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_section_spacing",
      "label": "Remove default section spacing",
      "info": "Turn this on to remove Shopify's built-in top/bottom section spacing and rely only on the padding settings below.",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_per_row",
      "min": 2,
      "max": 6,
