      "label": "Space above (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "info_spacing_desktop",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "paragraph",
