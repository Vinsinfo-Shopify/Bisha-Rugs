      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "ch",
      "default": 46
    },
    {
      "type": "range",
      "id": "description_spacing_mobile",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "description_spacing_desktop",
