    },
    {
      "type": "text",
      "id": "info_2_value",
      "label": "Approval time",
      "default": "48 hrs"
    },
    {
      "type": "text",
      "id": "info_2_label",
      "label": "Approval time label",
      "default": "Average approval"
    },
    {
      "type": "text",
      "id": "info_3_value",
      "label": "Shipping",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "info_3_label",
      "label": "Shipping label",
      "default": "Shipping"
    },
    {
      "type": "color",
      "id": "info_value_color",
      "label": "Value color",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "info_value_font_size_mobile",
      "label": "Value font size (mobile)",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
