{%- liquid
  assign app_block_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_block_count = app_block_count | plus: 1
    endif
  endfor

  assign show_form_column = false
  if app_block_count > 0 or request.design_mode
    assign show_form_column = true
  endif

  assign has_info_items = false
  if section.settings.info_1_value != blank
    assign has_info_items = true
  elsif section.settings.info_2_value != blank
    assign has_info_items = true
  elsif section.settings.info_3_value != blank
    assign has_info_items = true
  endif

  assign form_column_width = 100 | minus: section.settings.content_column_width

  assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5

  assign has_media = false
  if section.settings.image != blank or request.design_mode
    assign has_media = true
  endif

  assign mobile_text_align = 'start'
  assign mobile_media_margin = '0 auto'
  if section.settings.mobile_content_alignment == 'center'
    assign mobile_text_align = 'center'
    assign mobile_media_margin = 'auto'
  endif

  assign desktop_text_align = 'start'
  assign desktop_media_margin = '0 auto'
  if section.settings.content_alignment == 'center'
    assign desktop_text_align = 'center'
    assign desktop_media_margin = 'auto'
  endif

  assign overlay_darken = section.settings.mobile_overlay_darken | divided_by: 100.0
  assign has_image_max_height = false
  if section.settings.image_max_height > 0
    assign has_image_max_height = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    padding-block-start: {{ section.settings.padding_top_mobile }}px;
    padding-block-end: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .trade-program {
    --section-vertical-spacing-override: {{ section.settings.section_vertical_spacing_mobile }}px;
    --trade-program-row-gap: {{ section.settings.row_gap_mobile }}px;
    --trade-program-content-column: {{ section.settings.content_column_width }}fr;
    --trade-program-form-column: {{ form_column_width }}fr;
    --trade-program-grid-padding-inline: {{ section.settings.grid_padding_inline_mobile }}px;

    --trade-program-eyebrow-font-size: {{ section.settings.eyebrow_font_size_mobile }}px;
    --trade-program-eyebrow-letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    --trade-program-eyebrow-text-transform: {{ section.settings.eyebrow_text_transform }};
    --trade-program-heading-font-size: {{ section.settings.heading_font_size_mobile }}px;
    --trade-program-description-font-size: {{ section.settings.description_font_size_mobile }}px;
    --trade-program-info-value-font-size: {{ section.settings.info_value_font_size_mobile }}px;
    --trade-program-info-label-font-size: {{ section.settings.info_label_font_size_mobile }}px;


    --trade-program-heading-spacing: {{ section.settings.heading_spacing_mobile }}px;
    --trade-program-description-spacing: {{ section.settings.description_spacing_mobile }}px;
    --trade-program-media-spacing: {{ section.settings.media_spacing_mobile }}px;
    --trade-program-info-spacing: {{ section.settings.info_spacing_mobile }}px;
    --trade-program-info-column-gap: {{ section.settings.info_column_gap_mobile }}px;

    --trade-program-image-width: {{ section.settings.image_width }}%;
    --trade-program-content-text-align: {{ mobile_text_align }};
    --trade-program-media-margin-inline: {{ mobile_media_margin }};

    /* Mobile image overlay */
    --trade-program-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --trade-program-mobile-overlay-scrim: rgb(0 0 0 / {{ overlay_darken }});

    {%- if section.settings.mobile_overlay_text_color != blank and section.settings.mobile_overlay_text_color != 'rgba(0,0,0,0)' -%}
      --trade-program-mobile-overlay-color: {{ section.settings.mobile_overlay_text_color }};
    {%- endif -%}

    {%- if section.settings.eyebrow_color != blank and section.settings.eyebrow_color != 'rgba(0,0,0,0)' -%}
      --trade-program-eyebrow-color: {{ section.settings.eyebrow_color }};
    {%- endif -%}

    {%- if section.settings.heading_color != blank and section.settings.heading_color != 'rgba(0,0,0,0)' -%}
      --trade-program-heading-color: {{ section.settings.heading_color }};
    {%- endif -%}

    {%- if section.settings.description_color != blank and section.settings.description_color != 'rgba(0,0,0,0)' -%}
      --trade-program-description-color: {{ section.settings.description_color }};
    {%- endif -%}

    {%- if section.settings.info_value_color != blank and section.settings.info_value_color != 'rgba(0,0,0,0)' -%}
      --trade-program-info-value-color: {{ section.settings.info_value_color }};
    {%- endif -%}

    {%- if section.settings.info_label_color != blank and section.settings.info_label_color != 'rgba(0,0,0,0)' -%}
      --trade-program-info-label-color: {{ section.settings.info_label_color }};
      --trade-program-info-label-opacity: 1;
    {%- endif -%}

    {%- if section.settings.image_ratio != 'adapt' -%}
      --trade-program-image-ratio: {{ section.settings.image_ratio }};
    {%- endif -%}
  }
    .container{
      --container-gutter: 90px;
    }
  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      padding-block-start: {{ section.settings.padding_top_desktop }}px;
      padding-block-end: {{ section.settings.padding_bottom_desktop }}px;
    }
    .container{
      --container-max-width: 1300px;
    }

    #shopify-section-{{ section.id }} .trade-program {
      --section-vertical-spacing-override: {{ section.settings.section_vertical_spacing_desktop }}px;
      --trade-program-column-gap: {{ section.settings.column_gap_desktop }}px;
      --trade-program-grid-padding-inline: {{ section.settings.grid_padding_inline_desktop }}px;

      /* Typography — desktop */
      --trade-program-eyebrow-font-size: {{ section.settings.eyebrow_font_size_desktop }}px;
      --trade-program-heading-font-size: {{ section.settings.heading_font_size_desktop }}px;
      --trade-program-description-font-size: {{ section.settings.description_font_size_desktop }}px;
      --trade-program-description-max-width: {{ section.settings.description_max_width }}ch;
      --trade-program-info-value-font-size: {{ section.settings.info_value_font_size_desktop }}px;
      --trade-program-info-label-font-size: {{ section.settings.info_label_font_size_desktop }}px;
      --trade-program-heading-spacing: {{ section.settings.heading_spacing_desktop }}px;
      --trade-program-description-spacing: {{ section.settings.description_spacing_desktop }}px;
      --trade-program-media-spacing: {{ section.settings.media_spacing_desktop }}px;
      --trade-program-info-spacing: {{ section.settings.info_spacing_desktop }}px;
      --trade-program-info-column-gap: {{ section.settings.info_column_gap_desktop }}px;

      --trade-program-content-text-align: {{ desktop_text_align }};
      --trade-program-media-margin-inline: {{ desktop_media_margin }};
    }

    {%- if has_image_max_height -%}
      #shopify-section-{{ section.id }} .trade-program__media :is(img, .placeholder) {
        max-height: {{ section.settings.image_max_height }}px;
      }
    {%- endif -%}
  }
  @media screen and (max-width: 768px){
    .container{
      --container-gutter: 20px;
    }
  }
</style>

<div class="trade-program color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}{% unless section.settings.remove_section_spacing %} section-spacing{% endunless %}{% if section.settings.separate_section_with_border %} bordered-section{% endif %}{% if section.settings.image_ratio != 'adapt' %} trade-program--image-cropped{% endif %}{% if has_media %} trade-program--has-media{% endif %}{% if section.settings.mobile_image_full_width %} trade-program--mobile-bleed{% endif %}{% unless show_form_column %} trade-program--no-form{% endunless %}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}">
  <div class="container ">
    <div class="trade-program__grid">
      {%- comment -%}
        --------------------------------------------------------------------------------------------------------------
        LEFT COLUMN — theme editor managed content
        --------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      <div class="trade-program__content">

        {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
          <div class="trade-program__intro">
            {%- if section.settings.eyebrow != blank -%}
              <p class="trade-program__eyebrow">{{ section.settings.eyebrow }}</p>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="trade-program__heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="trade-program__description">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.image != blank -%}
          <div class="trade-program__media">
            {%- capture image_sizes -%}(max-width: 245px) 100vw, min(200px, 50vw){%- endcapture -%}

            {{-
              section.settings.image
              | image_url: width: section.settings.image.width
              | image_tag:
                loading: 'lazy',
                sizes: image_sizes,
                widths: '300,400,500,600,700,800,900,1000,1200,1400'
            -}}
          </div>
        {%- elsif request.design_mode -%}
          <div class="trade-program__media">
            {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder' -}}
          </div>
        {%- endif -%}

        {%- if has_info_items -%}
          <ul class="trade-program__info" role="list">
            {%- for index in (1..3) -%}
              {%- liquid
                case index
                  when 1
                    assign info_value = section.settings.info_1_value
                    assign info_label = section.settings.info_1_label
                  when 2
                    assign info_value = section.settings.info_2_value
                    assign info_label = section.settings.info_2_label
                  else
                    assign info_value = section.settings.info_3_value
                    assign info_label = section.settings.info_3_label
                endcase
              -%}

              {%- if info_value != blank or info_label != blank -%}
                <li class="trade-program__info-item">
                  {%- if info_value != blank -%}
                    <span class="trade-program__info-value">{{ info_value }}</span>
                  {%- endif -%}

                  {%- if info_label != blank -%}
                    <span class="trade-program__info-label">{{ info_label }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%}
        --------------------------------------------------------------------------------------------------------------
        RIGHT COLUMN — app block container (Powerful Form Builder)

        Only "@app" blocks are rendered, so adding, removing or reordering the block in the theme editor is safe. When
        no app block is present the column collapses on the storefront and the left content takes the full width.
        --------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- if show_form_column -%}
        <div class="trade-program__form">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div class="trade-program__app-block" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if app_block_count == 0 and request.design_mode -%}
            {%- assign app_block_placeholder = 'Use "Add block" to place the Powerful Form Builder app block here.' -%}
            {%- render 'banner', content: app_block_placeholder, text_alignment: 'center' -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trade program",
  "class": "shopify-section--trade-program",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Two-column section: editable content on the left, and an app block (Powerful Form Builder) added through \"Add block\" on the right."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class",
      "info": "Add one or more space-separated classes to target this section with custom CSS."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text alignment (desktop)",
      "options": [
        { "value": "start", "label": "t:global.position.left" },
        { "value": "center", "label": "t:global.position.center" }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Join the trade program"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#b35642"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size_mobile",
      "label": "Font size (mobile)",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "eyebrow_font_size_desktop",
      "label": "Font size (desktop)",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "eyebrow_text_transform",
      "label": "Capitalization",
      "options": [
        { "value": "none", "label": "As typed" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "t:global.text.heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:global.text.heading",
      "default": "Exclusive Rug Rates Your Clients Won't Find Elsewhere"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:global.colors.text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Font size (mobile)",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Font size (desktop)",
      "min": 16,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_spacing_mobile",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_spacing_desktop",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:global.text.content"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:global.text.content",
      "default": "<p>Partner with Bisha Rugs for trade pricing, dedicated support, and rugs made to your project's exact palette and scale.</p>"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "t:global.colors.text",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "description_font_size_mobile",
      "label": "Font size (mobile)",
      "min": 10,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_font_size_desktop",
      "label": "Font size (desktop)",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "description_max_width",
