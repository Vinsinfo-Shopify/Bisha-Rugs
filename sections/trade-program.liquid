      "info": "Minimum height. The image grows if the heading needs more room.",
      "min": 120,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "color",
      "id": "mobile_overlay_text_color",
      "label": "Overlay text color",
      "info": "Used for the eyebrow and heading while they sit over the image.",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "mobile_overlay_darken",
      "label": "Image darkening",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:global.sizes.size"
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
