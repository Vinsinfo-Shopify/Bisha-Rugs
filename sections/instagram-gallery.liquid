{%- doc -%}
  "Follow Us On Instagram" - Bisha section header (SOCIALS eyebrow, heading,
  "Tag us @handle" tagline) wrapping the Instafeed app block.

  The feed is supplied by the Instafeed app (theme app extension), so posts
  update automatically from Instagram. This section only owns the header and
  the spacing around it; the feed's layout, post count and refresh are managed
  in the Instafeed app.

  Previously the section rendered a manual image/video carousel from its own
  blocks. That was replaced in Oct 2026 at the client's request for an
  automatic feed.

  The handle links to the Instagram profile (new tab). If "Instagram profile
  URL" is empty, the link is built from the handle.

  Every selector is prefixed with this section's id, so the section can appear
  more than once on a page without conflict.
{%- enddoc -%}

{%- liquid
  case section.settings.header_alignment
    when 'left'
      assign header_align_items = 'flex-start'
    when 'right'
      assign header_align_items = 'flex-end'
    else
      assign header_align_items = 'center'
  endcase

  # Profile link: the setting wins; otherwise it is built from the handle,
  # so the handle is never a dead, unclickable label.
  assign profile_url = section.settings.handle_url
  if profile_url == blank and section.settings.handle != blank
    assign handle_slug = section.settings.handle | remove: '@' | strip
    assign profile_url = 'https://www.instagram.com/' | append: handle_slug | append: '/'
  endif
-%}

  <style>
    /* Every rule is prefixed with this section's id. */
    #shopify-section-{{ section.id }} .ig {
      background: {{ section.settings.background }};
    }

    #shopify-section-{{ section.id }} .ig__inner {
      padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .ig__header {
      margin-block-end: {{ section.settings.header_gap }}px;
      text-align: {{ section.settings.header_alignment }};
      display: flex;
      justify-content: center;
      flex-direction: column;
      align-items: {{ header_align_items }};
    }

    /* section-header.liquid always emits <div class="section_header_content">,
       even with no content, and theme.css gives every prose sibling
       margin-block-start: 1rem. That empty div is therefore a 16px spacer
       sitting between the heading and the tagline. Taking it out of layout
       removes the gap at source; no compensating margin is used anywhere.
       :empty means a div that DOES carry content is untouched. */
    #shopify-section-{{ section.id }} .ig__header .section_header_content:empty {
      display: none;
    }

    /* Line heights are ratios so they hold if a size is changed:
       14 x 1.43 = 20, 28 x 1.214 = 34, 16 x 1.375 = 22. */
    #shopify-section-{{ section.id }} .ig__header .section_header_subheading {
      margin-block: 0 {{ section.settings.eyebrow_gap }}px;
      font-size: {{ section.settings.eyebrow_size }}px;
      line-height: 1.43;
      font-weight: {{ section.settings.eyebrow_weight }};
    }

    #shopify-section-{{ section.id }} .ig__header .section_header_heading {
      font-size: {{ section.settings.heading_size }}px;
      line-height: 1.214;
      font-weight: {{ section.settings.heading_weight }};
      margin-block: 0;
    }

    #shopify-section-{{ section.id }} .ig__tagline {
      margin-block: 10px 0;
      font-size: {{ section.settings.tagline_size_desktop }}px;
      line-height: 22px;
      font-weight: 400;
    }

    #shopify-section-{{ section.id }} .ig__handle {
      color: inherit;
      font-style: italic;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    #shopify-section-{{ section.id }} a.ig__handle:hover {
      text-decoration-thickness: 2px;
    }


    #shopify-section-{{ section.id }} .ig__empty {
      text-align: center;
      opacity: 0.7;
    }

    /* ---------- Mobile ---------- */
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .ig__inner {
        padding-block: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
      }

      #shopify-section-{{ section.id }} .ig__header {
        margin-block-end: 26px;
      }

      /* 24 x 1.208 = 29, 14 x 1.571 = 22. The eyebrow is unchanged at 14/20. */
      #shopify-section-{{ section.id }} .ig__header .section_header_heading {
        font-size: {{ section.settings.heading_size_mobile }}px;
        line-height: 1.208;
      }

      #shopify-section-{{ section.id }} .ig__tagline {
        font-size: {{ section.settings.tagline_size_mobile }}px;
        line-height: 1.571;
        margin-block: 2px 0;
      }
    }
  </style>

  <div class="ig color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="ig__inner container container--xl">
      <div class="ig__header">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.title,
          heading_style: section.settings.heading_style
        -%}

        {%- if section.settings.tagline_before != blank or section.settings.handle != blank -%}
          <p class="ig__tagline">
            {{- section.settings.tagline_before }}
            {% if section.settings.handle != blank -%}
                <a class="ig__handle" href="{{ profile_url }}" target="_blank" rel="noopener">{{ section.settings.handle }}</a>
            {%- endif %}
            {{ section.settings.tagline_after -}}
          </p>
        {%- endif -%}
      </div>

      <div class="ig__feed">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {%- render block -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if section.blocks.size == 0 and request.design_mode -%}
          <p class="ig__empty">Add the Instafeed app block: Add block &gt; Apps &gt; Instafeed.</p>
        {%- endif -%}
      </div>
    </div>
  </div>

{% schema %}
{
  "name": "Instagram gallery",
  "class": "shopify-section--instagram-gallery",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The feed itself comes from the Instafeed app. Add it with \"Add block\" > Apps > Instafeed, then manage posts, layout and refresh in the Instafeed app."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "SOCIALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Follow Us On Instagram"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h3",
          "label": "Small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Eyebrow weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "eyebrow_gap",
      "label": "Eyebrow to heading gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Tagline"
    },
    {
      "type": "text",
      "id": "tagline_before",
      "label": "Tagline, before the handle",
      "default": "Tag us"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle",
      "default": "@bisharugs"
    },
    {
      "type": "url",
      "id": "handle_url",
      "label": "Instagram profile URL",
      "info": "Opens in a new tab. Leave empty to build the link from the handle, e.g. https://www.instagram.com/bisharugs/"
    },
    {
      "type": "text",
      "id": "tagline_after",
      "label": "Tagline, after the handle",
      "default": "to get featured"
    },
    {
      "type": "range",
      "id": "tagline_size_desktop",
      "label": "Tagline size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "tagline_size_mobile",
      "label": "Tagline size (mobile)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout and colours"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Header to gallery gap",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#fffbf3"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Instagram gallery"
    }
  ]
}
{% endschema %}
