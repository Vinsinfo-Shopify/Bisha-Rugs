{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  LIQUID
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}
{%- if section.settings.layout == 'carousel' -%}
{%- liquid
  assign carousel_id = 'blog-carousel-' | append: section.id
  assign articles_list = section.settings.blog.articles
-%}

{%- comment -%}
  CAROUSEL VARIANT.

  Entirely inside this branch, so an instance left on the default "grid" layout
  renders exactly the markup it always has and emits none of this CSS. That is
  what keeps article.json and page.about-us.json untouched: neither has a
  "layout" key saved, so both inherit the grid default.

  The card markup is local rather than blog-post-card.liquid because that shared
  snippet has no reading time and always offers the category badge, and it must
  not be modified. Everything else - article data, image handling, the section
  header, the button - is the theme's own.
{%- endcomment -%}
<style>
  /* Every rule is prefixed with this section's id. */

  /* The clip lives on the full-width wrapper, NOT on .blogc__inner. That inner
     element is the .container the track deliberately bleeds out of, so clipping
     there cut the track straight back to the container box - leaving the same
     inset visible on both sides at every scroll position, including the last.
     Here it still stops the bleed from giving the page horizontal scroll. */
  #shopify-section-{{ section.id }} .blogc {
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .blogc__inner {
    padding-block: {{ section.settings.space_top }}px {{ section.settings.space_bottom }}px;
  }

  #shopify-section-{{ section.id }} .blogc__header {
    margin-block-end: {{ section.settings.header_gap }}px;
    text-align: center;
  }

  /* section-header.liquid always emits <div class="section_header_content">,
     even when empty, and theme.css gives every prose sibling
     margin-block-start: 1rem. That empty div is a 16px spacer under the
     heading. Taking it out of layout removes the gap at source. */
  #shopify-section-{{ section.id }} .blogc__header .section_header_content:empty {
    display: none;
  }

  /* Line heights are ratios so they survive a size change:
     14 x 1.43 = 20, 28 x 1.214 = 34, 12 x 1.417 = 17. */
  #shopify-section-{{ section.id }} .blogc__header .section_header_subheading {
    margin-block: 0 {{ section.settings.eyebrow_gap }}px;
    font-size: {{ section.settings.eyebrow_size }}px;
    line-height: 1.43;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .blogc__header .section_header_heading {
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.214;
    font-weight: 400;
    margin-block: 0;
  }

  /* ---------- Carousel ----------
     group-cells is omitted, so ScrollCarousel's groupCells getter returns 1:
     one card per arrow click. cell-selector pins the cells to the cards.

     The track spans the FULL viewport and the two boundaries are held as
     CONTENT, not as edges of the container:

       start inset = padding-inline-start on the track
       end inset   = margin-inline-end on the last card

     so scrollWidth = start inset + cards + gaps + end inset, and
     maxScroll = scrollWidth - viewport. At scrollLeft 0 the start inset is the
     left space; at maxScroll the end inset is all that sits right of the final
     card and everything left of it is content covering the left edge.

     The end inset is a margin on the last card rather than padding on the
     track: several engines drop padding-inline-end from scrollWidth, which
     silently shortens maxScroll and clips the final card.

     scroll-padding-inline-start matches the start inset so the theme's own
     calculateLeftScroll resolves card 1 to offsetLeft - scrollPadding = 0. */
  #shopify-section-{{ section.id }} .blogc__carousel {
    position: relative;
  }

  #shopify-section-{{ section.id }} .blogc__track {
    --blogc-gap: {{ section.settings.card_gap }}px;
    /* Fixed, not a fraction of the track: the design specifies a rendered image
       size, so the card is that size at every viewport and the carousel scrolls
       when they stop fitting. */
    --blogc-card: {{ section.settings.card_width }}px;
    --blogc-media: {{ section.settings.image_height }}px;
    /* The inset is the container's OWN inline margin, not --container-gutter.
       .container--lg caps at 1260px, so its margin is max(gutter, 50% - 630) -
       90px at 1440, not 48px. Using the gutter left the track 42px short of the
       viewport on each side, and that band was unreachable at any scroll
       position: the leftover gap on the left at the final position. */
    --blogc-inset: var(--distance-to-bleed);
    display: flex;
    align-items: stretch;
    gap: var(--blogc-gap);
    overflow: auto hidden;
    /* The cards are position: relative, so without this their offsetParent
       would be an ancestor of the scroller and every computed scroll target
       would carry a constant offset. */
    position: relative;
    /* Lazy-loaded images inside a mandatory-snap scroller make the browser
       nudge scrollLeft as they arrive, which reveals a sliver of the previous
       card. Anchoring off keeps the resting position at exactly 0. */
    overflow-anchor: none;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--blogc-inset));
    padding-inline-start: var(--blogc-inset);
    padding-inline-end: 0;
    scroll-padding-inline-start: var(--blogc-inset);
    scroll-padding-inline-end: 0;
  }

  #shopify-section-{{ section.id }} .blogc__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .blogc__card {
    flex: 0 0 var(--blogc-card);
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: {{ section.settings.card_background }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    scroll-snap-align: start;
    /* One swipe moves one card. Without this a momentum flick sails past
       several snap points. */
    scroll-snap-stop: always;
  }

  #shopify-section-{{ section.id }} .blogc__card:last-child {
    margin-inline-end: calc(var(--blogc-inset) + {{ section.settings.end_gap }}px);
  }

  /* A fixed box, not an aspect ratio: the rendered height is specified, so the
     source image's proportions must not decide it. cover crops without
     distorting. */
  #shopify-section-{{ section.id }} .blogc__media {
    height: var(--blogc-media);
    background: rgb(var(--text-color) / 0.06);
    flex: none;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .blogc__media :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .blogc__body {
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* 12 x 1.417 = 17px */
  #shopify-section-{{ section.id }} .blogc__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: {{ section.settings.meta_size }}px;
    line-height: 1.417;
    font-weight: 400;
    color: rgb(var(--text-color) / 0.7);
  }

  #shopify-section-{{ section.id }} .blogc__title {
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.4;
    font-weight: 700;
    margin: 0;
    /* Two lines keeps every card the same height whatever the headline length,
       and wrapping stays between words. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    overflow-wrap: break-word;
  }

  /* Hover underlines the title only - not the card, excerpt, meta or image.
     Inside pointer: fine so a touch device never gets a stuck hover state. */
  @media screen and (pointer: fine) {
    #shopify-section-{{ section.id }} .blogc__card:hover .blogc__title {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  #shopify-section-{{ section.id }} .blogc__excerpt {
    font-size: {{ section.settings.excerpt_size }}px;
    line-height: 1.4;
    font-weight: 400;
    margin: 0;
    color: rgb(var(--text-color) / 0.8);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: {{ section.settings.excerpt_lines }};
    overflow: hidden;
    overflow-wrap: break-word;
  }

  #shopify-section-{{ section.id }} .blogc__cta {
    display: flex;
    justify-content: center;
    margin-block-start: {{ section.settings.cta_gap }}px;
  }

  /* No button rules here on purpose. theme.css drives .button's hover with a
     gradient wipe (--initial-gradient / --hover-gradient plus a background-size
     transition). Setting the background shorthand on :hover wipes out
     background-image and background-size and kills that animation, which is
     what made this CTA behave unlike the other sections. The colours are passed
     into the button snippet instead, exactly as the completed sections do. */

  /* ---------- Arrows ----------
     Row 08's treatment under this section's id. Size, inset, hover and
     disabled behaviour come from theme.css; only colours are restated. */
  #shopify-section-{{ section.id }} .floating-controls-container__control {
    z-index: 3;
    inset-block-start: {{ section.settings.arrow_offset }}%;
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .floating-controls-container__control .circle-button {
    --circle-button-size: {{ section.settings.arrow_size }}px;
    --circle-button-background: 43 39 36;
    --circle-button-text-color: 255 255 255;
    box-sizing: border-box;
    background: {{ section.settings.arrow_background }};
    color: {{ section.settings.arrow_color }};
    border: 2px solid {{ section.settings.arrow_border }};
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .floating-controls-container__control .circle-button > svg {
    width: {{ section.settings.arrow_size | times: 0.42 | round }}px;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Desktop has no arrow: the carousel is swipe/drag only above the mobile
     breakpoint. Keyed to min-width, so the mobile rules below - which position
     and show the control - are untouched. Nothing about scrolling, dragging or
     snapping changes; only the control is taken out of the layout. */
  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .floating-controls-container__control {
      display: none;
    }
  }

  @media screen and (pointer: fine) {
    #shopify-section-{{ section.id }} .floating-controls-container--on-hover > .floating-controls-container__control,
    #shopify-section-{{ section.id }} .floating-controls-container--on-hover:hover > .floating-controls-container__control:not(:has([disabled])) {
      opacity: 1;
      transform: translateY(-50%);
    }
  }

  /* ---------- Mobile ---------- */
  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .blogc__inner {
      padding-block: {{ section.settings.space_top | divided_by: 2 }}px {{ section.settings.space_bottom | divided_by: 2 }}px;
    }

    #shopify-section-{{ section.id }} .blogc__track {
      --blogc-gap: {{ section.settings.card_gap_mobile }}px;
      --blogc-card: {{ section.settings.card_width_mobile }}px;
      --blogc-media: {{ section.settings.image_height_mobile }}px;
    }

    /* 24 x 1.625 = 39px */
    #shopify-section-{{ section.id }} .blogc__header .section_header_heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      line-height: 1.625;
    }

    #shopify-section-{{ section.id }} .blogc__title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .blogc__excerpt {
      font-size: {{ section.settings.excerpt_size_mobile }}px;
    }

    /* theme.css only positions these controls under (pointer: fine), so on a
       touch device they would fall into normal flow. Restated here; nothing is
       hidden with display, visibility or opacity. */
    #shopify-section-{{ section.id }} .floating-controls-container__control {
      position: absolute;
      display: grid;
      place-items: center;
    }

    #shopify-section-{{ section.id }} carousel-prev-button.floating-controls-container__control {
      inset-inline-start: {{ section.settings.arrow_inset_mobile }}px;
      inset-inline-end: auto;
    }

    #shopify-section-{{ section.id }} carousel-next-button.floating-controls-container__control {
      inset-inline-end: {{ section.settings.arrow_inset_mobile }}px;
      inset-inline-start: auto;
    }
  }
</style>

<div class="blogc color-scheme color-scheme--{{ section.settings.color_scheme.id }}"{% if section.settings.background != blank %} style="background: {{ section.settings.background }};"{% endif %}>
  <div class="blogc__inner container container--lg">
    <div class="blogc__header">
      {%- render 'section-header',
        subheading: section.settings.subheading,
        heading: section.settings.title,
        heading_style: section.settings.heading_style,
        text_alignment: 'center'
      -%}
    </div>

    <div class="blogc__carousel floating-controls-container floating-controls-container--inside floating-controls-container--on-hover">
      <carousel-prev-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
        <button type="button" class="prev-next-button prev-next-button--prev circle-button circle-button--lg hover:animate-icon-inline" disabled>
          <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
          {%- render 'icon' with 'arrow-left', direction_aware: true -%}
        </button>
      </carousel-prev-button>

      <scroll-carousel id="{{ carousel_id }}" allow-drag class="blogc__track" cell-selector=".blogc__card">
        {%- for article in articles_list limit: section.settings.posts_count -%}
          {%- liquid
            # Reading time from the real article. Integer division floors, so the
            # remainder is checked and a partial minute rounds up; the floor of 1
            # keeps a very short post from reading "0 min read".
            assign word_count = article.content | strip_html | split: ' ' | size
            assign read_minutes = word_count | divided_by: section.settings.words_per_minute
            assign remainder = word_count | modulo: section.settings.words_per_minute
            if remainder > 0
              assign read_minutes = read_minutes | plus: 1
            endif
            assign read_minutes = read_minutes | at_least: 1
          -%}

          {%- capture card_sizes -%}
            (max-width: 699px) {{ section.settings.card_width_mobile }}px, {{ section.settings.card_width }}px
          {%- endcapture -%}

          <a class="blogc__card" href="{{ article.url }}">
            <div class="blogc__media">
              {%- if article.image != blank -%}
                {{-
                  article.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '200,300,400,600,800,1000,1200',
                    sizes: card_sizes,
                    alt: article.image.alt | default: article.title
                -}}
              {%- else -%}
                {{- 'blog-apparel-' | append: forloop.index | placeholder_svg_tag: 'placeholder' -}}
              {%- endif -%}
            </div>

            <div class="blogc__body">
              <p class="blogc__meta">
                <span>{{ read_minutes }} {{ section.settings.read_time_label }}</span>
                <span aria-hidden="true">{{ section.settings.meta_separator }}</span>
                <span>{{ article.published_at | date: section.settings.date_format }}</span>
              </p>

              <p class="blogc__title">{{ article.title }}</p>

              {%- assign excerpt = article.excerpt_or_content | strip_html | strip -%}
              {%- if excerpt != blank -%}
                <p class="blogc__excerpt">{{ excerpt | truncatewords: section.settings.excerpt_words }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </scroll-carousel>

      <carousel-next-button class="floating-controls-container__control" aria-controls="{{ carousel_id }}">
        <button type="button" class="prev-next-button prev-next-button--next circle-button circle-button--lg hover:animate-icon-inline">
          <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
          {%- render 'icon' with 'arrow-right', direction_aware: true -%}
        </button>
      </carousel-next-button>
    </div>

    {%- if section.settings.button_text != blank -%}
      <div class="blogc__cta">
        {%- assign button_link = section.settings.button_link | default: section.settings.blog.url -%}
        {%- render 'button',
          href: button_link,
          content: section.settings.button_text,
          background: section.settings.cta_background,
          text_color: section.settings.cta_text_color
        -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- else -%}
{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container container--lg">
    <div class="section-stack">
      {%- render 'section-header',
        subheading: section.settings.subheading,
        heading: section.settings.title,
        heading_style: section.settings.heading_style,
        content: section.settings.content,
        text_alignment: 'center'
      -%}

      <blog-posts
        class="blog-post-list justify-center {% unless section.settings.stack_on_mobile %}blog-post-list--carousel scroll-area snap-x bleed md:unbleed{% endunless %}"
        {% if settings.stagger_blog_posts_apparition %}
          reveal-on-scroll="true"
        {% endif %}
      >
        {%- capture sizes -%}(max-width: 699px) 95vw, (max-width: 1149px) calc(100vw / 2), calc((80rem - (5rem * ({{ section.settings.blog.articles_count | default: 3 | at_most: 3 }} - 1) / 3){%- endcapture -%}

        {%- for article in section.settings.blog.articles limit: section.settings.posts_count -%}
          {%- render 'blog-post-card',
            article: article,
            blog: section.settings.blog,
            show_category: section.settings.show_category,
            show_date: section.settings.show_date,
            show_excerpt: section.settings.show_excerpt,
            show_read_more: section.settings.show_read_more,
            sizes: sizes,
            position: forloop.index
          -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            {%- render 'blog-post-card', show_category: section.settings.show_category, show_excerpt: section.settings.show_excerpt -%}
          {%- endfor -%}
        {%- endfor -%}
      </blog-posts>

      {%- if section.settings.button_text != blank -%}
        <div class="justify-self-center">
          {%- assign button_link = section.settings.button_link | default: section.settings.blog.url -%}
          {%- render 'button', href: button_link, content: section.settings.button_text -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- endif -%}

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "class": "shopify-section--blog-posts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Grid is the original layout. Carousel adds the horizontal blog carousel with reading time.",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_posts.blocks.blog.blog"
    },
    {
      "type": "range",
      "id": "posts_count",
      "min": 2,
      "max": 12,
      "label": "t:sections.blog_posts.blocks.blog.posts_count",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:sections.blog_posts.stack_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:global.blog.show_category",
      "info": "t:global.blog.show_category_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:global.blog.show_date",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:global.blog.show_excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "t:global.blog.show_read_more",
      "default": true
    },
    {
      "type": "header",
      "content": "t:global.section.header_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Blog posts"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "t:global.text.style",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:global.text.button_link",
      "info": "t:sections.blog_posts.button_link_info"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:global.text.button_text",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Carousel layout"
    },
    {
      "type": "paragraph",
      "content": "These apply only when Layout is set to Carousel."
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (desktop)",
      "info": "Also the image width. 313 matches the design.",
      "min": 263,
      "max": 363,
      "step": 1,
      "unit": "px",
      "default": 313
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height (desktop)",
      "min": 273,
      "max": 373,
      "step": 1,
      "unit": "px",
      "default": 323
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card width (mobile)",
      "info": "Also the image width. 219 matches the design.",
      "min": 169,
      "max": 269,
      "step": 1,
      "unit": "px",
      "default": 219
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image height (mobile)",
      "min": 192,
      "max": 292,
      "step": 1,
      "unit": "px",
      "default": 242
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap (desktop)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Card gap (mobile)",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "end_gap",
      "label": "Extra space after the last card",
      "info": "Added to the section gutter at the final scroll position.",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
