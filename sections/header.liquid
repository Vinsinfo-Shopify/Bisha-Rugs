<style>
  :root {
    --header-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
    --header-padding-block: 1rem;
    --header-transparent-header-text-color: {{ section.settings.transparent_header_text_color.rgb }};
    --header-separation-border-color: {% if section.settings.show_separation_border %}{{ section.settings.color_scheme.settings.text_color.rgb }} / 0.15{% else %}0 0 0 / 0{% endif %};

    position: relative;
    z-index: 4;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --header-padding-block: {% if section.settings.reduce_padding %}1.2rem{% else %}1.6rem{% endif %};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- case section.settings.layout -%}
        {%- when 'logo_left_navigation_inline' -%}
          --header-grid: "logo primary-nav secondary-nav" / auto minmax(0, 1fr) auto;

        {%- when 'logo_left_navigation_center' -%}
          --header-grid: "logo primary-nav secondary-nav" / minmax(max-content, 1fr) auto minmax(max-content, 1fr);

        {%- when 'logo_center_navigation_below' -%}
          --header-grid: ". logo secondary-nav" "primary-nav primary-nav primary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
      {%- endcase -%}
    }
  }

  {%- if section.settings.enable_sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- if section.settings.logo != blank -%}
    #shopify-section-{{ section.id }} {
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
      }
    }
  {%- endif -%}
</style>

<height-observer variable="header">
  <x-header
    {% if section.settings.hide_on_scroll and section.settings.enable_sticky %}
      hide-on-scroll
    {% endif %}
    class="header color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  >
    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      LOGO AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- capture logo_content -%}
      {%- if section.settings.logo -%}
        {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}

        <span class="sr-only">{{ shop.name }}</span>
        {%- assign alt_text = section.settings.logo.alt | default: shop.name -%}
        {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, alt: alt_text, widths: widths, class: 'header__logo-image' -}}

        {%- if section.settings.transparent_logo -%}
          {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image header__logo-image--transparent' -}}
        {%- endif -%}
      {%- else -%}
        <span class="header__logo-text h5">{{ shop.name }}</span>
      {%- endif -%}
    {%- endcapture -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
        <a href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {% else %}
      <a href="{{ routes.root_url }}" class="header__logo">{{ logo_content }}</a>
    {% endif %}

    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      PRIMARY NAVIGATION AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign menu = section.settings.menu -%}
    {%- assign sidebar_menu = section.settings.sidebar_menu -%}

    {%- if menu.links.size > 0 or sidebar_menu.links.size > 0 -%}
      <nav
        class="header__primary-nav {% if section.settings.layout == 'logo_center_navigation_below' or section.settings.layout == 'logo_left_navigation_center' %}header__primary-nav--center{% endif %}"
        aria-label="{{ 'header.general.primary_navigation' | t | escape }}"
      >
        <button
          type="button"
          aria-controls="sidebar-menu"
          {% unless section.settings.layout == 'drawer' %}
            class="md:hidden"
          {% endunless %}
        >
          <span class="sr-only">{{ 'header.general.menu' | t }}</span>
          {%- render 'icon' with 'hamburger', class: 'header__nav-icon' -%}
        </button>

        {%- if menu.links.size > 0 and section.settings.layout != 'drawer' -%}
          <ul class="contents unstyled-list md-max:hidden">
            {%- for link in menu.links -%}
              {% liquid
                assign link_title_downcase = link.title | strip | downcase
                assign mega_menu_block = ''

                for block in section.blocks
                  assign menu_item_downcase = block.settings.menu_item | strip | downcase

                  if menu_item_downcase == link_title_downcase
                    assign mega_menu_block = block
                    break
                  endif
                endfor
              %}

              <li class="header__primary-nav-item">
                {%- if link.levels == 0 and mega_menu_block == '' -%}
                  <a
                    href="{{ link.url }}"
                    data-title="{{ link.title | escape }}"
                    class="block {% if section.settings.menu_text_font == 'heading' %}h6{% endif %}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title -}}
                  </a>
                {%- else -%}
                  {%- capture disclosure_content -%}
                    <details class="header__menu-disclosure">
                      <summary data-follow-link="{{ link.url }}" {% if section.settings.menu_text_font == 'heading' %}class="h6"{% endif %} data-title="{{ link.title | escape }}" {% if link.current or link.child_active %}aria-current="page"{% endif %}>
                        {{- link.title -}}
                        <svg class="header__menu-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                          <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </summary>

                      {%- if mega_menu_block != '' -%}
                        {%- render 'mega-menu', link: link, block: mega_menu_block -%}
                      {%- else -%}
                        <ul class="header__dropdown-menu {% if link.levels <= 1 %}header__dropdown-menu--restrictable{% endif %} unstyled-list" role="list">
                          {%- for sub_link in link.links -%}
                            <li>
                              {%- if sub_link.levels == 0 -%}
                                <a href="{{ sub_link.url }}" class="link-faded-reverse" {% if sub_link.current %}aria-current="page"{% endif %}>{{ sub_link.title }}</a>
                              {%- else -%}
                                <dropdown-menu-disclosure follow-summary-link trigger="{{ section.settings.menu_open_trigger }}" class="contents">
                                  <details class="header__menu-disclosure">
                                    <summary data-follow-link="{{ sub_link.url }}" class="link-faded-reverse">
                                      <div class="h-stack gap-4 justify-between">
                                        {{- sub_link.title -}}
                                        {%- render 'icon' with 'arrow-right', width: 8, direction_aware: true -%}
                                      </div>
                                    </summary>

                                    <ul class="header__dropdown-menu unstyled-list" role="list">
                                      {%- for sub_sub_link in sub_link.links -%}
                                        <li>
                                          <a href="{{ sub_sub_link.url }}" class="link-faded-reverse" {% if sub_sub_link.current %}aria-current="page"{% endif %}>{{ sub_sub_link.title }}</a>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </details>
                                </dropdown-menu-disclosure>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </details>
                  {%- endcapture -%}

                  {% if mega_menu_block != '' %}
                    <mega-menu-disclosure follow-summary-link trigger="{{ section.settings.menu_open_trigger }}" class="contents">
                      {{- disclosure_content -}}
                    </mega-menu-disclosure>
                  {%- else -%}
                    <dropdown-menu-disclosure follow-summary-link trigger="{{ section.settings.menu_open_trigger }}">
                      {{- disclosure_content -}}
                    </dropdown-menu-disclosure>
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      SECONDARY NAVIGATION AREA

      The search, account and cart icons are the Figma exports, cleaned for
      inline use: width and height attributes removed so CSS controls the
      size, and every colour swapped to currentColor so they flip to white on
      the transparent header. Path data and stroke widths are Figma's own.

      To go back to the Prestige defaults, swap any icon variable below for
      its original tag, for example:
        render 'icon' with 'search', class: 'header__nav-icon'
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <nav class="header__secondary-nav" aria-label="{{ 'header.general.secondary_navigation' | t | escape }}">
      {%- liquid
        if section.settings.show_country_selector and localization.available_countries.size > 1
          assign show_country_selector = true
        endif

        if section.settings.show_locale_selector and localization.available_languages.size > 1
          assign show_locale_selector = true
        endif
      -%}

      {%- capture icon_search -%}
        <svg class="header__nav-icon" viewBox="0 0 21 21" fill="none" aria-hidden="true" focusable="false">
          <g transform="translate(2.0308 2.0308)">
            <path d="M7.57736 14.5644C11.4365 14.5644 14.5649 11.436 14.5649 7.57688C14.5649 3.71777 11.4365 0.589355 7.57736 0.589355C3.71826 0.589355 0.589844 3.71777 0.589844 7.57688C0.589844 11.436 3.71826 14.5644 7.57736 14.5644Z" stroke="currentColor" stroke-width="1.17914" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
          <path d="M14.55 14.55 20.37 20.37" stroke="currentColor" stroke-width="1.17914" stroke-linecap="round"/>
        </svg>
      {%- endcapture -%}

      {%- capture icon_account -%}
        <svg class="header__nav-icon" viewBox="0 0 18 17" fill="none" aria-hidden="true" focusable="false">
          <path d="M17.3474 16.2092C15.9328 13.7635 13.6651 12.0936 11.0379 11.4916C15.1859 9.79213 15.9387 4.23958 12.3929 1.49701C8.84712 -1.24556 3.66208 0.87876 3.05984 5.3208C2.7035 7.94905 4.16824 10.486 6.62255 11.4916C3.9987 12.091 1.72767 13.7635 0.312981 16.2092C0.190761 16.4429 0.367305 16.7212 0.630763 16.7102C0.742782 16.7055 0.845425 16.6464 0.905569 16.5517C2.57888 13.6564 5.54355 11.9275 8.83021 11.9275C12.1169 11.9275 15.0815 13.6564 16.7548 16.5517C16.816 16.6576 16.9289 16.7229 17.0511 16.723C17.1113 16.7232 17.1705 16.7072 17.2224 16.6768C17.3859 16.5821 17.4418 16.3729 17.3474 16.2092ZM3.69212 6.1043C3.69212 2.149 7.97386 -0.323059 11.3993 1.65459C14.8246 3.63224 14.8246 8.57637 11.3993 10.554C10.6182 11.005 9.73213 11.2424 8.83021 11.2424C5.9939 11.2391 3.69543 8.94062 3.69212 6.1043Z" fill="currentColor" stroke="currentColor" stroke-width="0.5459"/>
        </svg>
      {%- endcapture -%}

      {%- capture icon_cart -%}
        <svg class="header__nav-icon" viewBox="0 0 16 19" fill="none" aria-hidden="true" focusable="false">
          <path d="M4.22161 5.35692C4.22161 5.35692 3.81808 0.589355 7.85337 0.589355C11.8887 0.589355 11.4851 5.35692 11.4851 5.35692M0.589844 17.2758L1.33795 4.90168C1.37107 4.35392 1.82495 3.92665 2.37371 3.92665H13.3376C13.8845 3.92665 14.3373 4.34892 14.3727 4.89468C14.6545 9.25047 15.1169 16.5686 15.1169 17.2758C15.1169 18.0386 14.5789 18.2294 14.3098 18.2294C10.2745 18.2294 2.04255 18.2294 1.3969 18.2294C0.751255 18.2294 0.589844 17.5937 0.589844 17.2758Z" stroke="currentColor" stroke-width="1.17914" stroke-linecap="round"/>
        </svg>
      {%- endcapture -%}

      <ul class="contents unstyled-list">
        {%- if show_country_selector or show_locale_selector -%}
          <li class="localization-selectors md-max:hidden">
            {%- if show_country_selector -%}
              {%- render 'localization-selector',
                type: 'country',
                placement: 'bottom-end',
                show_country_name: section.settings.show_country_name,
                show_country_flag: section.settings.show_country_flag,
                id_prefix: 'header-nav'
              -%}
            {%- endif -%}

            {%- if show_locale_selector -%}
              {%- render 'localization-selector', type: 'locale', placement: 'bottom-end', id_prefix: 'header-nav' -%}
            {%- endif -%}
          </li>
        {%- endif -%}

        {%- comment -%}Offer a hook for apps to integrate into the header to add their own icon, for instance{%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <li>
              {%- render block -%}
            </li>
          {%- endif -%}
        {%- endfor -%}

        {%- if section.settings.enable_search -%}
          <li class="header__search-link">
            <a href="{{ routes.search_url }}" aria-controls="header-search-{{ section.id }}">
              <span class="sr-only">{{ 'header.general.search' | t }}</span>

              {%- if section.settings.show_icons -%}
                {{- icon_search -}}
              {%- else -%}
                <span class="md:hidden">{{- icon_search -}}</span>
                <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden" aria-hidden="true">
                  {{- 'header.general.search' | t -}}
                </span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <li class="header__account-link sm-max:hidden">
            <shopify-account menu="{{ section.settings.customer_account_menu }}">
              <div slot="signed-out-avatar">
                {%- if section.settings.show_icons -%}
                  {{- icon_account -}}
                {%- else -%}
                  <span class="md:hidden">{{- icon_account -}}</span>

                  <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden" aria-hidden="true">
                    {{- 'header.general.login' | t -}}
                  </span>
                {%- endif -%}
              </div>
            </shopify-account>
          </li>
        {%- endif -%}

        <li class="relative header__cart-link">
          <a
            href="{{ routes.cart_url }}"
            {% if settings.cart_type != 'page' and request.page_type != 'cart' %}
              aria-controls="cart-drawer"
            {% endif %}
            data-no-instant
          >
            <span class="sr-only">{{ 'header.general.cart' | t }}</span>

            {%- if section.settings.show_icons -%}
              {{- icon_cart -}}
            {%- else -%}
              <span class="md:hidden">{{- icon_cart -}}</span>
              <span class="{% if section.settings.menu_text_font == 'heading' %}h6{% endif %} link-faded md-max:hidden">
                {{- 'header.general.cart' | t }} (<cart-count>{{ cart.item_count }}</cart-count>)</span
              >
            {%- endif -%}

            <cart-dot class="header__cart-dot {% unless cart.empty? %}is-visible{% endunless %} {% unless section.settings.show_icons %}md:hidden{% endunless %}"></cart-dot>
          </a>
        </li>
      </ul>
    </nav>

    {%- if section.settings.enable_search -%}
      {%- render 'header-search' -%}
    {%- endif -%}

    {%- assign sidebar_menu = section.settings.sidebar_menu | default: section.settings.menu -%}

    {%- if sidebar_menu.links.size > 0 -%}
      {%- render 'header-sidebar',
        menu: sidebar_menu,
        color_scheme: section.settings.sidebar_color_scheme,
        show_dividers: section.settings.sidebar_show_dividers,
        open_second_level_menus: section.settings.sidebar_open_second_level_menus
      -%}
    {%- endif -%}
  </x-header>
</height-observer>

<script>
  document.documentElement.style.setProperty('--header-height', `${document.getElementById('shopify-section-{{ section.id }}').clientHeight.toFixed(2)}px`);
</script>

{% style %}
  /* ==========================================================================
     BISHA RUGS — header styling

     0. Page gutter
     1. Header bar — every width
     2. Below the desktop breakpoint
     3. Desktop header bar (>= 1000px)
     4. Mega menu
     5. Sidebar drawer (mobile, 375px spec)
     ========================================================================== */

  /* ---------- 0. Page gutter ---------- */
  /* One expression, no breakpoints. Largest of the three wins, and which one
     wins changes on its own as the viewport moves:

       375px   16px floor
       768px   3vw  = 23px
       1200px  3vw  = 36px
       1440px  calc = 70px   <- the Figma number, hit exactly
       1920px  calc = 310px  <- 1300px row, centred

     Any section that must line up with the header uses this same expression. */

  .header {
    padding-inline: max(16px, 3vw, calc((100% - 1300px) / 2));
  }

  /* ---------- 1. Header bar — every width ---------- */
  /* Outside any media query on purpose. Scoping these to the desktop
     breakpoint is what made the row jump from 78px to ~86px at 999px, when
     they snapped back to theme defaults. */

  #shopify-section-{{ section.id }} {
    /* 17 + 44 + 17 = 78px row, held at every width */
    --header-padding-block: 17px;

    /* Figma logo block: 153 x 44 */
    --header-logo-width: 153px;
  }

  .header {
    align-items: center;
    border-block-end: 0.5px solid #e2e2e2;
  }

  /* -- Logo -- */

  .header__logo {
    display: flex;
    align-items: center;
  }

  /* max-height is what holds the row at 78px. The logo file is taller than
     44px at 153 wide, so without it the image renders at its own ratio and
     drags the header taller. contain letterboxes rather than crops; swap to
     cover for the exact Figma crop if the client wants the tagline trimmed. */
  .header__logo-image {
    width: var(--header-logo-width);
    height: auto;
    max-height: 44px;
    object-fit: contain;
    object-position: left center;
  }

  /* Fallback for when no logo image is uploaded and the shop name renders as
     text. Upload the logo and this rule stops mattering. */
  .header__logo-text {
    font-size: 22px;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* -- Secondary navigation (search · account · cart) -- */

  .header__secondary-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 26px; /* Figma: 25.75px */
  }

  /* Each icon sits in an identical 22px box, centred, so all three share one
     optical centre line with the nav text. */
  .header__secondary-nav > ul > li {
    display: flex;
    align-items: center;
    height: 22px;
  }

  .header__secondary-nav > ul > li > a,
  .header__secondary-nav shopify-account,
  .header__secondary-nav shopify-account > [slot] {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: inherit;
    line-height: 0;
  }

  /* display:block is what kills the baseline gap under an inline SVG. */
  .header__secondary-nav .header__nav-icon {
    display: block;
  }

  /* Rendered at the Figma sizes. Each viewBox carries half a stroke width of
     padding, which is why these are a shade larger than the glyph
     measurements in the inspector (20.96 / 17.12 x 16.45 / 14.53 x 17.64).

     Do NOT add a stroke-width rule here. The widths come from the SVGs, and
     an override would flatten the account icon's 0.5459 and make it heavy. */
  .header__search-link .header__nav-icon {
    width: 21px;
    height: 21px;
  }

  .header__account-link .header__nav-icon {
    width: 18px;
    height: 17px;
  }

  .header__cart-link .header__nav-icon {
    width: 16px;
    height: 19px;
  }

  /* The Figma header has three icons only. Delete this if you switch the
     country/region selector back on. */
  .header__secondary-nav .localization-selectors {
    display: none;
  }

  /* ---------- 2. Below the desktop breakpoint ---------- */
  /* Prestige swaps the menu for the hamburger at exactly 1000px — that is its
     md breakpoint, set on the md-max:hidden and md:hidden classes in the
     markup above. The gutter and the 78px row carry through the switch on
     their own now, so only the small-screen logo and icon spacing need
     adjusting. Provisional until the mobile Figma arrives. */

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} {
      --header-logo-width: 120px;
    }

    .header__secondary-nav {
      gap: 18px;
    }
  }

  /* ---------- 3. Desktop header bar (>= 1000px) ---------- */
  /* Figma: nav bar 1440 x 78 · inner row 1300 x 44 · gutter 70 */

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      /* Logo left · nav centred · icons right. Both outer columns take an
         equal 1fr share of the leftover space, which is what pins the nav to
         the true centre of the row. */
      --header-grid:
        'logo primary-nav secondary-nav' /
        minmax(max-content, 1fr) auto minmax(max-content, 1fr);
    }

    .header {
      column-gap: 0;
    }

    .header__primary-nav {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .header__primary-nav-item > a,
    .header__primary-nav-item > * > details > summary {
      display: inline-flex;
      align-items: center;
      gap: 2px; /* label -> chevron */

      font-family: var(--text-font-family);
      font-size: 16px;
      font-weight: 400;
      font-style: normal;
      line-height: 1.4; /* 140% */
      letter-spacing: 0;
      text-transform: none;
      white-space: nowrap;
      text-decoration: none;
      opacity: 1;
    }

    /* Chevron on "Shop All" — 20 x 20 box, 1.2px stroke */
    .header__menu-chevron {
      width: 20px;
      height: 20px;
      flex: none;
      transition: transform 0.2s ease;
    }

    .header__primary-nav-item > * > details[open] > summary .header__menu-chevron {
      transform: rotate(180deg);
    }

    /* Current page: SemiBold + underline.
       Weight deliberately stays 400 on hover — bolding on hover re-measures
       the text and shoves the neighbouring links sideways. */
    .header__primary-nav-item > a[aria-current='page'],
    .header__primary-nav-item > * > details > summary[aria-current='page'] {
      font-weight: 600;
    }

    .header__primary-nav-item > a[aria-current='page'],
    .header__primary-nav-item > a:hover,
    .header__primary-nav-item > * > details > summary[aria-current='page'],
    .header__primary-nav-item > * > details > summary:hover,
    .header__primary-nav-item > * > details[open] > summary {
      text-decoration: underline;
      text-decoration-thickness: 1.5px; 
      text-underline-offset: 4px; 
      text-decoration-skip-ink: auto;
    }

    /* Harmless if there is no SALE item in the menu. */
    .header__primary-nav-item > a[data-title='sale' i],
    .header__primary-nav-item > * > details > summary[data-title='sale' i] {
      color: #c0392b;
    }
  }

  /* Prestige slides its own bar along the bottom edge of the header on hover.
     Figma uses a text underline instead, so switch the bar off. */
  .header__primary-nav-item::before,
  .header__primary-nav-item::after,
  .header__primary-nav-item > a::before,
  .header__primary-nav-item > a::after,
  .header__primary-nav-item > * > details > summary::before,
  .header__primary-nav-item > * > details > summary::after {
    content: none !important;
    display: none !important;
  }

  .header__primary-nav-item > a,
  .header__primary-nav-item > * > details > summary {
    border-block-end: 0;
    background-image: none;
  }

  /* -- Nav gap per width tier. The Figma 50px lands at 1440; below that the
        nav will not fit alongside the logo and icons, so it tightens. -- */

  @media screen and (min-width: 1000px) {
    .header__primary-nav {
      gap: 22px;
    }
  }

  @media screen and (min-width: 1200px) {
    .header__primary-nav {
      gap: 34px;
    }
  }

  @media screen and (min-width: 1440px) {
    .header__primary-nav {
      gap: 50px;
    }
  }

  /* ---------- 4. Mega menu ---------- */

  .mega-menu {
    padding-block: 44px;
    padding-inline: max(16px, 3vw, calc((100% - 1300px) / 2));
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: 34px;
    width: 100%;
    box-sizing: border-box;
    overflow-x: auto;
  }

  @media screen and (min-width: 1350px) {
    .mega-menu {
      overflow-x: visible;
    }
  }

  .mega-menu .mega-menu__linklist {
    display: flex;
    flex: 1 1 auto;
    align-items: flex-start;
    gap: 34px;
    min-width: 0;
  }

  .mega-menu__column {
    flex: 0 0 140px;
    width: 140px;
    gap: 24px !important;
    min-width: 0;
  }

  .mega-menu__column--colors {
    flex: 0 0 254px;
    width: 254px;
    min-width: 254px;
  }

  .mega-menu__column > .h6 {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    margin-bottom: 0;
  }

  .mega-menu__column .v-stack,
  .mega-menu__linklist .v-stack.gap-2\.5 {
    gap: 12px !important;
  }

  .mega-menu__linklist a.link-faded {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    opacity: 1;
  }

  .mega-menu a[aria-current='page'] {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    text-decoration-skip-ink: auto;
  }

  .mega-menu__swatch-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 12px;
    row-gap: 12px;
    width: 100%;
  }

  .mega-menu__swatch-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
  }

  .mega-menu__swatch {
    display: inline-block;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--swatch, transparent);
    border: 1px solid rgba(0, 0, 0, 0.12);
    flex: none;
  }

  .mega-menu__swatch-item--full {
    grid-column: 1 / -1;
    margin-top: 2px;
  }

  .mega-menu .mega-menu__promo {
    flex: 0 0 313px;
    width: 313px;
    max-width: none;
    margin-left: 0;
  }

  .mega-menu__promo-card {
    position: relative;
    display: block;
    border-radius: 0;
    overflow: hidden;
    aspect-ratio: 313 / 391;
  }

  .mega-menu__promo-media,
  .mega-menu__promo-media img {
    width: 100%;
    height: 100%;
  }

  .mega-menu__promo-media img {
    object-fit: cover;
    display: block;
  }

  .mega-menu__promo-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 15px 16px;
    color: #fff;
  }

  .mega-menu__promo-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.1) 31%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .mega-menu__promo-text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mega-menu__promo-title {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .mega-menu__promo-count {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    opacity: 1;
  }

  .mega-menu__promo-arrow {
    position: relative;
    flex: none;
    width: 33px;
    height: 33px;
    border-radius: 50%;
    background: #fff;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .mega-menu__promo-arrow svg {
    width: 16px;
    height: 16px;
  }

  .mega-menu__promo-card:hover .mega-menu__promo-arrow {
    transform: translateX(3px);
  }

  /* The gutter comes from the shared expression now, so only the column and
     promo widths need to shrink on narrower desktops. */
  @media screen and (min-width: 1000px) and (max-width: 1199px) {
    .mega-menu,
    .mega-menu .mega-menu__linklist {
      gap: 20px;
    }
    .mega-menu__column {
      flex-basis: 120px;
      width: 120px;
    }
    .mega-menu .mega-menu__promo {
      flex-basis: 240px;
      width: 240px;
    }
  }

  @media screen and (min-width: 1200px) and (max-width: 1439px) {
    .mega-menu,
    .mega-menu .mega-menu__linklist {
      gap: 24px;
    }
    .mega-menu__column {
      flex-basis: 130px;
      width: 130px;
    }
    .mega-menu .mega-menu__promo {
      flex-basis: 280px;
      width: 280px;
    }
  }

  @media screen and (max-width: 999px) {
    .header__account-link {
      display: none !important;
    }
  }

  /* ---------- 5. Sidebar drawer ---------- */

  .header-sidebar::part(content) {
    width: 338px;
    max-width: 90vw;
  }

  .header-sidebar::part(header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 54px;
    padding: 5px 16px 5px 0px;
    gap: 1rem;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.06);
    position: relative;
    z-index: 1;
  }

  .header-sidebar::part(sidebar-logo) {
    display: inline-flex;
    align-items: center;
    flex: 0 1 auto;
    min-width: 0;
  }

  .header-sidebar::part(sidebar-logo-image) {
    max-width: 153px;
    width: 153px;
    height: auto;
  }

  .header-sidebar::part(close-button) {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header-sidebar__scroller {
    padding-left: 12px;
    padding-right: 16px;
  }

  .header-sidebar__linklist {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 4px;
  }

  .header-sidebar__linklist > li {
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.15);
  }

  .header-sidebar__linklist > li:last-child {
    border-bottom-color: rgba(0, 0, 0, 0.6);
  }

  .header-sidebar__linklist.divide-y > * + * {
    border-top: 0;
  }

  .header-sidebar__linklist-button,
  .header-sidebar__back-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 11px 12px 11px 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
  }

  .header-sidebar__back-button {
    justify-content: flex-start;
  }

  .header-sidebar__linklist-button svg,
  .header-sidebar__chevron svg {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .header-sidebar__linklist-button[href*='/sale' i],
  .header-sidebar a[href*='/sale' i] {
    color: #c0392b;
  }

  .header-sidebar__nested-linklist {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    margin: 0;
    border-left: 0;
  }

  .header-sidebar__nested-linklist > a:last-child {
    border-bottom: 0;
  }

  .header-sidebar__nested-link {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 9px 0;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    border-bottom: 1px solid rgba(0, 0, 0, 0.09);
  }

  .header-sidebar__nested-linklist--colors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 16px;
    padding-top: 16px;
  }

  .header-sidebar__nested-linklist--colors .header-sidebar__nested-link {
    min-height: 28px;
    padding: 0;
    border-bottom: 0;
  }

  .header-sidebar__nested-link.has-swatch {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .header-sidebar__swatch {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--swatch, transparent);
    border: 1px solid rgba(0, 0, 0, 0.12);
    flex: none;
  }

  .header-sidebar__footer {
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .header-sidebar__footer .text-with-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: auto;
    background: #b35642;
    color: #ffffff;
    padding: 12px 28px;
    border-radius: 0;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .header-sidebar__footer .text-with-icon svg {
    color: #ffffff;
    width: 17px;
    height: 17px;
    flex: none;
    opacity: 1;
  }

  .header-sidebar__footer .text-with-icon svg path {
    stroke-width: 1;
  }

  .header-sidebar__chevron {
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .group.accordion__disclosure[open] .header-sidebar__chevron,
  details[open] .header-sidebar__chevron {
    transform: rotate(180deg);
  }

  .header-sidebar__linklist-button,
  .header-sidebar__linklist a,
  .header-sidebar a.link-faded,
  .header-sidebar a.link-faded-reverse {
    opacity: 1 !important;
    color: inherit !important;
  }

  .header-sidebar__footer > * {
    padding-inline-start: 12px;
  }
{% endstyle %}

