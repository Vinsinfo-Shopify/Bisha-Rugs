{%- if section.blocks.size > 0 -%}
  <style>
    :root {
      --announcement-bar-is-sticky: {% if section.settings.enable_sticky %}1{% else %}0{% endif %};

      {%- if section.index == 1 and section.settings.enable_sticky == false -%}
        --header-scroll-tracker-offset: var(--announcement-bar-height);
      {%- endif -%}
    }

    {%- if section.settings.enable_sticky -%}
      #shopify-section-{{ section.id }} {
        position: sticky;
        top: 0;
        z-index: 5;
      }

      .shopify-section--header ~ #shopify-section-{{ section.id }} {
        top: calc(var(--header-is-sticky, 0) * var(--header-height, 0px));
        z-index: 4; /* We have to lower the z-index in case the announcement bar is displayed after the header */
      }
    {%- endif -%}

    #shopify-section-{{ section.id }} {
      --announcement-bar-font-size: {{ section.settings.mobile_font_size | divided_by: 16.0 }}rem;
    }

    @media screen and (min-width: 999px) {
      #shopify-section-{{ section.id }} {
        --announcement-bar-font-size: {{ section.settings.desktop_font_size | divided_by: 16.0 }}rem;
      }
    }

    @media screen and (max-width: 1200px) {
      #shopify-section-{{ section.id }} .announcement-bar__carousel { max-width: 25rem;}
    }

    @media screen and (max-width: 991px) {
      #shopify-section-{{ section.id }} .announcement-bar__carousel { max-width: 21rem;}
    }

    @media screen and (max-width: 768px) {
      .ann-side--desktop {
        display: none !important;
      }
      #shopify-section-{{ section.id }} .announcement-bar__carousel { max-width: 35rem;}
      #shopify-section-{{ section.id }} .announcement-bar {
        padding-inline-start: var(--container-gutter) !important;
        padding-inline-end: var(--container-gutter) !important;
      }
    }
    /* CSS for Left & right announcement bar items */
    #shopify-section-{{ section.id }} .announcement-bar,
    #shopify-section-{{ section.id }} .announcement-bar__inner,
    #shopify-section-{{ section.id }} announcement-bar {
      position: relative;
    }

    #shopify-section-{{ section.id }} .ann-side {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: inherit;
      text-decoration: none;
      white-space: nowrap;
      font-size: var(--announcement-bar-font-size);
      z-index: 1;
    }

    #shopify-section-{{ section.id }} .announcement-bar__message,
    #shopify-section-{{ section.id }} [class*="announcement"] .message, .#shopify-section-{{ section.id }} announcement-bar__carousel .heading {
      text-transform: capitalize;
    }

    #shopify-section-{{ section.id }} .ann-side--left  { left: var(--container-gutter, 20px); }
    #shopify-section-{{ section.id }} .ann-side--right { right: var(--container-gutter, 20px); }

    #shopify-section-{{ section.id }} .announcement-bar__carousel { max-width: 25rem;}

  </style>

  <height-observer variable="announcement-bar">
    <div class="announcement-bar color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      {%- if section.settings.show_left_item and section.settings.left_text != blank -%}
        {%- if section.settings.left_link != blank -%}
          <a href="{{ section.settings.left_link }}" class="ann-side ann-side--left{% if section.settings.hide_sides_mobile %} ann-side--desktop{% endif %}">
            {%- if section.settings.left_icon_img -%}
              <img class="ann-icon" src="{{ section.settings.left_icon_img | image_url: width: 64 }}" alt="{{ section.settings.left_text | escape }}" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" loading="lazy">
            {%- endif -%}
            {{- section.settings.left_text -}}
          </a>
        {%- else -%}
          <span class="ann-side ann-side--left{% if section.settings.hide_sides_mobile %} ann-side--desktop{% endif %}">
            {%- if section.settings.left_icon_img -%}
              <img class="ann-icon" src="{{ section.settings.left_icon_img | image_url: width: 64 }}" alt="{{ section.settings.left_text | escape }}" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" loading="lazy">
            {%- endif -%}
            {{- section.settings.left_text -}}
          </span>
        {%- endif -%}
      {%- endif -%}

      {%- assign carousel_id = 'carousel-' | append: section.id -%}

      {%- if section.blocks.size > 1 -%}
        <carousel-prev-button aria-controls="{{ carousel_id }}" class="contents">
          <button type="button" class="tap-area">
            <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
            {%- render 'icon' with 'arrow-left', width: 12, direction_aware: true -%}
          </button>
        </carousel-prev-button>
      {%- endif -%}

      <announcement-bar-carousel
        allow-swipe
        {% if section.settings.autoplay %}
          autoplay="{{ section.settings.cycle_speed }}"
        {% endif %}
        id="{{ carousel_id }}"
        class="announcement-bar__carousel"
      >
        {%- for block in section.blocks -%}
          <p class="prose heading {% if forloop.first %}is-selected{% endif %}" {{ block.shopify_attributes }}>
            {{- block.settings.text -}}
          </p>
        {%- endfor -%}
      </announcement-bar-carousel>

      {%- if section.blocks.size > 1 -%}
        <carousel-next-button aria-controls="{{ carousel_id }}" class="contents">
          <button type="button" class="tap-area">
            <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
            {%- render 'icon' with 'arrow-right', width: 12, direction_aware: true -%}
          </button>
        </carousel-next-button>
      {%- endif -%}
      {%- if section.settings.show_phone and section.settings.phone_number != blank -%}
        {%- if section.settings.phone_clickable -%}
          {%- assign tel = section.settings.phone_number | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
          <a href="tel:{{ tel }}" class="ann-side ann-side--right{% if section.settings.hide_sides_mobile %} ann-side--desktop{% endif %}">
            {%- if section.settings.right_icon_img -%}
              <img class="ann-icon" src="{{ section.settings.right_icon_img | image_url: width: 64 }}" alt="{{ section.settings.phone_number | escape }}" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" loading="lazy">
            {%- endif -%}
            {{- section.settings.phone_number -}}
          </a>
        {%- else -%}
          <span class="ann-side ann-side--right{% if section.settings.hide_sides_mobile %} ann-side--desktop{% endif %}">
            {%- if section.settings.right_icon_img -%}
              <img class="ann-icon" src="{{ section.settings.right_icon_img | image_url: width: 64 }}" alt="{{ section.settings.phone_number | escape }}" width="{{ section.settings.icon_size }}" height="{{ section.settings.icon_size }}" loading="lazy">
            {%- endif -%}
            {{- section.settings.phone_number -}}
          </span>
        {%- endif -%}
      {%- endif -%}
    </div>
  </height-observer>

  <script>
    document.documentElement.style.setProperty(
      '--announcement-bar-height',
      `${document.getElementById('shopify-section-{{ section.id }}').clientHeight.toFixed(2)}px`
    );
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "shopify-section--announcement-bar",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "tag": "aside",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement_bar.blocks.message.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.message.text",
          "default": "Announce something here"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "t:sections.announcement_bar.enable_sticky_bar"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.announcement_bar.auto_rotate_between_messages",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "sec",
      "label": "t:sections.announcement_bar.cycle_speed",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 9,
      "max": 15,
      "unit": "px",
      "label": "t:sections.announcement_bar.desktop_text_size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 9,
      "max": 15,
      "unit": "px",
      "label": "t:sections.announcement_bar.mobile_text_size",
      "default": 10
    },
    {
      "type": "header",
      "content": "Left item — Virtual Appointment"
    },
    {
      "type": "checkbox",
      "id": "show_left_item",
      "label": "Show left item",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "left_icon_img",
      "label": "Left icon"
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Left text",
      "default": "Virtual Appointment"
    },
    {
      "type": "url",
      "id": "left_link",
      "label": "Left link (optional)"
    },
    {
      "type": "header",
      "content": "Right item — Phone"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone number",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "right_icon_img",
      "label": "Right icon"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "+1 (415) 980-7774"
    },
    {
      "type": "checkbox",
      "id": "phone_clickable",
      "label": "Tap to call",
      "info": "On mobile, tapping starts a call.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_sides_mobile",
      "label": "Hide left & right items on mobile",
      "info": "Recommended — prevents overlap with the rotating text on small screens.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Announce something here"
          }
        }
      ]
    }
  ]
}
{% endschema %}
