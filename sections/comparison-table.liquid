            "value_2": "Plush, soft & cushioned"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Maintenance",
            "value_1": "Professional cleaning recommended",
            "value_2": "Spot clean & easy day-to-day maintenance"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Pile Height",
            "value_1": "Medium pile",
            "value_2": "Medium to high pile"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Perfect For",
            "value_1": "Living room, Dining room, Bedroom, Statement Spaces",
            "value_2": "Family room, Bedroom, Kid's room"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Customization",
            "value_1": "Custom sizes & colors available",
            "value_2": "Custom sizes & colors available"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Production Time",
            "value_1": "5 - 8 Weeks",
            "value_2": "5 - 8 Weeks"
          }
        }
      ]
    }
  ]
}
{% endschema %}
