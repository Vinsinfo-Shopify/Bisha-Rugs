      "min": 40,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "card_margin_mobile_px",
      "label": "Product card side margin (mobile)",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gutter_mobile",
      "label": "Mobile side spacing",
      "info": "Space between the section content and the screen edges. The carousel still reaches the edges.",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Product card corner radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Product card border",
      "default": "#e6e6e6"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "SEE ALL INSPIRATION"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#4f5b3f"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_gap",
      "label": "Gallery to button gap",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 22
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Image shape",
          "info": "Sets how tall this image is relative to its column.",
          "options": [
            { "value": "3 / 4", "label": "Tall portrait" },
            { "value": "4 / 5", "label": "Portrait" },
            { "value": "1 / 1", "label": "Square" },
            { "value": "5 / 4", "label": "Landscape" }
          ],
          "default": "4 / 5"
        },
        {
          "type": "header",
          "content": "Hotspot 1"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product",
          "info": "Leave empty to hide this hotspot."
        },
        {
          "type": "range",
          "id": "product_1_horizontal_position",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 30
        },
        {
          "type": "range",
          "id": "product_1_vertical_position",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 70
        },
        {
          "type": "header",
          "content": "Hotspot 2"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product",
          "info": "Leave empty to hide this hotspot."
        },
        {
          "type": "range",
          "id": "product_2_horizontal_position",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 65
        },
        {
          "type": "range",
          "id": "product_2_vertical_position",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 45
        },
        {
          "type": "header",
          "content": "Hotspot 3"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product",
          "info": "Leave empty to hide this hotspot."
        },
        {
          "type": "range",
          "id": "product_3_horizontal_position",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 45
        },
        {
          "type": "range",
          "id": "product_3_vertical_position",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Find the perfect look",
      "blocks": [
        { "type": "image", "settings": { "ratio": "4 / 5" } },
        { "type": "image", "settings": { "ratio": "4 / 5" } },
        { "type": "image", "settings": { "ratio": "4 / 5" } },
        { "type": "image", "settings": { "ratio": "1 / 1" } },
        { "type": "image", "settings": { "ratio": "1 / 1" } },
        { "type": "image", "settings": { "ratio": "1 / 1" } }
      ]
    }
  ]
}
{% endschema %}
