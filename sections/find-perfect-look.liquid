      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 78
    },
    {
      "type": "range",
      "id": "card_min_width",
      "label": "Product card minimum width",
      "min": 180,
      "max": 320,
      "step": 2,
      "unit": "px",
      "default": 260
    },
    {
      "type": "range",
      "id": "card_width_mobile_px",
      "label": "Product card width (mobile)",
      "min": 200,
      "max": 400,
      "step": 2,
      "unit": "px",
      "default": 344
    },
    {
      "type": "range",
      "id": "card_opacity_pct",
