      "info": "The pressable area stays at 44px whatever this is set to, so the dot can be small without being hard to tap.",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Hotspot colour",
      "info": "The dot and its pulse ripple.",
      "default": "#ffffff"
    },
