{%- if section.blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }} {
      --product-list-items-per-row: {{ section.settings.products_per_row_mobile | times: 1 }};
      --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
      --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
      }
    }
  </style>

  {%- comment -%}
    Homepage Row 06 - "Bestselling Oushak Rugs".
    Every rule is guarded by custom_class and prefixed with the section id,
    so no other instance of this section and no other template is affected.

    Values sampled from the supplied 1440 Figma frame (delivered at 2x):
      column 1300 | 4 cards x 313 with 16 gaps | image 313 x 380
      BEST SELLER badge 109 x 38  bg #F3EEE4  text #000
      NEW badge          59 x 27  bg #B08D4C  text #FFF
      Hand Knotted pill 117 x 30  bg #F1ECE2  text #000
      carousel arrow    33 x 33   bg #2B2724  chevron #FFF, ~25px outside the column
      CTA              232 x 31   bg #55583C  text #FFF
      rhythm: 65 / eyebrow / 16 / heading / 26 / image / 14 / pill / 18 /
              title / 12 / rating / 15 / price / 48 / CTA / 65

    Mobile values follow the written 375px specification; the mobile frame
    was not available, so type sizes are proportional and flagged for QA.
  {%- endcomment -%}
  {%- if section.settings.custom_class contains 'home_bestselling_rugs' -%}
    <style>
      /* ---------- Section frame ---------- */
      #shopify-section-{{ section.id }} {
        --container-max-width: 81.25rem; /* 1300px - same column as the locked sections above */
        --section-vertical-spacing-override: 46px; /* + 19px gutter from locked Row 05 = 65px */
        --section-stack-gap: 24px;
      }

      /* ---------- Header ---------- */
      #shopify-section-{{ section.id }} .section-stack > .v-stack {
        gap: 4px;
      }

      #shopify-section-{{ section.id }} .section-stack > .v-stack > .h6 {
        font-family: var(--text-font-family);
        font-size: 14px;
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: 0;
        text-transform: uppercase;
        margin: 0;
      }

      #shopify-section-{{ section.id }} .section-stack > .v-stack > h2 {
        font-family: 'Forum', serif;
        font-size: 28px;
        font-weight: 400;
        line-height: 1.3;
        margin: 0;
      }

      /* ---------- Product image ---------- */
      #shopify-section-{{ section.id }} .product-card__image {
        aspect-ratio: 313 / 380;
      }

      #shopify-section-{{ section.id }} .product-card__figure > .badge-list {
        inset-block-start: 3px;
        inset-inline-start: 3px;
        gap: 3px;
      }

      #shopify-section-{{ section.id }} .product-card__figure .badge-list .badge--custom {
        border-radius: 2px;
        font-size: 12px;
        line-height: 140%;
        font-weight: 500;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      #shopify-section-{{ section.id }} .product-card__figure .badge-list .badge--best-seller {
        background: #f3eee4;
        color: #000000;
        padding: 10.5px 15px;
      }

      #shopify-section-{{ section.id }} .product-card__figure .badge-list .badge--new {
        background: #b08d4c;
        color: #ffffff;
        padding: 5px 14px;
      }

      /* ---------- Hand Knotted pill ---------- */
      #shopify-section-{{ section.id }} .product-card__tag-wrapper {
        background: #f1ece2;
        border-radius: 100px;
        padding: 5px 14px;
      }

      #shopify-section-{{ section.id }} .product-card__tag {
        color: #000000;
        font-size: 14px;
        line-height: 140%;
        font-weight: 500;
      }

      /* ---------- Per-product image carousel (opt-in via image_carousel) ----------
         Cells are full-width and paged only by the small controls; the element is
         not drag-enabled and does not scroll on touch, so it cannot steal gestures
         from the outer product carousel. */
      #shopify-section-{{ section.id }} .product-card__media-carousel {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 100%;
        overflow: hidden;
        scroll-snap-type: x mandatory;
      }

      #shopify-section-{{ section.id }} .product-card__media-cell {
        scroll-snap-align: start;
        width: 100%;
      }

      #shopify-section-{{ section.id }} .product-card__media-control {
        z-index: 2;
        position: absolute;
        inset-block-start: 50%;
        transform: translateY(-50%);
      }

      #shopify-section-{{ section.id }} .product-card__media-control--prev {
        inset-inline-start: 26px;
      }

      #shopify-section-{{ section.id }} .product-card__media-control--next {
        inset-inline-end: 26px;
      }

      #shopify-section-{{ section.id }} .product-card__media-control .circle-button {
        --circle-button-size: 1.75rem; /* 28px */
        --circle-button-background: 255 255 255;
        --circle-button-text-color: 43 39 36; /* #2B2724 */
        box-shadow: 0 1px 4px rgb(0 0 0 / 0.12);
      }

      #shopify-section-{{ section.id }} .product-card__media-control .circle-button > svg {
        width: 0.625rem;
      }

      /* Disabled at the first/last image rather than hidden, so the control
         positions stay stable. */
      #shopify-section-{{ section.id }} .product-card__media-control button[disabled] {
        opacity: 0.35;
        pointer-events: none;
      }

      /* Figma keeps the image clean until hover. Pointer-events follow opacity so
         an invisible control can never be clicked. */
      @media screen and (pointer: fine) {
        #shopify-section-{{ section.id }} .product-card__media-control {
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.2s ease-in-out;
        }

        #shopify-section-{{ section.id }} .product-card:hover .product-card__media-control,
        #shopify-section-{{ section.id }} .product-card:focus-within .product-card__media-control {
          opacity: 1;
          pointer-events: auto;
        }
      }

      /* The image-position indicator is mobile-only */
      #shopify-section-{{ section.id }} .product-card__media-pagination {
        display: none;
      }

      /* Belt and braces: the inner carousel must never expose a native scrollbar */
      #shopify-section-{{ section.id }} .product-card__media-carousel {
        scrollbar-width: none;
      }

      #shopify-section-{{ section.id }} .product-card__media-carousel::-webkit-scrollbar {
        display: none;
      }

      /* ---------- Quick buy (enabled per-render for this section only) ---------- */
      #shopify-section-{{ section.id }} .product-card__quick-add-button {
        background: #2b2724;
        color: #ffffff;
        border-radius: var(--rounded-full);
        padding: 8px;
        inset-block-end: 16px;
        inset-inline-end: 16px;
        box-shadow: 0 1px 4px rgb(0 0 0 / 0.12);
      }

      /* Figma shows it permanently visible; Prestige reveals it on card hover. */
      @media screen and (pointer: fine) {
        #shopify-section-{{ section.id }} .product-card__quick-add-button {
          opacity: 1;
          transform: none;
        }

        /* The 90deg spin is designed for the plus glyph, not a bag. */
        #shopify-section-{{ section.id }} .product-card__quick-add-button:is(:hover, :focus) svg {
          transform: none;
        }
      }

      /* ---------- Card information rhythm ---------- */
      #shopify-section-{{ section.id }} .product-card__info {
        gap: 12px;
        padding-top: 14px;
      }

      #shopify-section-{{ section.id }} .product-card__info .gap-1 {
        gap: 8px;
      }

      /* .rating-badge ships with 4px/8px margins that double up on the stack gap */
      #shopify-section-{{ section.id }} .rating-badge {
        margin-top: 0;
        margin-bottom: 0;
        column-gap: 6px;
      }

      /* Title uses the body font in the Figma and is clamped to two lines so
         card heights stay level. product_title_max_lines is 0 site-wide, so
         the clamp lives here rather than in the global setting. */
      #shopify-section-{{ section.id }} .product-card-title {
        font-family: var(--text-font-family);
        font-size: 16px;
        line-height: 25px;
        font-weight: 600;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
      }

      /* ---------- CTA ---------- */
      #shopify-section-{{ section.id }} .featured-collections-carousel__item > .justify-self-center {
        margin-block-start: 48px;
      }

      #shopify-section-{{ section.id }} .featured-collections-carousel__item > .justify-self-center .button {
        --button-background: 85 88 60; /* #55583C */
        --button-outline-color: 85 88 60;
        --button-text-color: 255 255 255;
        min-width: 232px;
        padding-block: 7px;
      }

      /* ---------- Carousel arrows ----------
         Charcoal disc with a white chevron, compact, always visible, and
         vertically centred on the product image rather than the whole card. */
      #shopify-section-{{ section.id }} .floating-controls-container__control .circle-button {
        --circle-button-size: 2.0625rem; /* 33px */
        --circle-button-background: 43 39 36; /* #2B2724 */
        --circle-button-text-color: 255 255 255;
        box-shadow: none;
      }

      #shopify-section-{{ section.id }} .floating-controls-container__control .circle-button > svg {
        width: 0.6875rem; /* 11px chevron */
      }

      @media screen and (pointer: fine) {
        /* Prestige only reveals a control that contains no disabled button
           (.floating-controls-container--on-hover:hover > ...:not(:has([disabled]))),
           which makes an arrow vanish the moment it reaches an edge. The Figma
           shows both arrows permanently, so both the base and the hover rule are
           overridden here and a disabled arrow is merely dimmed. */
        #shopify-section-{{ section.id }} .floating-controls-container--on-hover > .floating-controls-container__control,
        #shopify-section-{{ section.id }} .floating-controls-container--on-hover:hover > .floating-controls-container__control:not(:has([disabled])) {
          opacity: 1;
          transform: none;
        }

        #shopify-section-{{ section.id }} .floating-controls-container__control:has(button[disabled]) {
          opacity: 0.35;
        }

        /* Sit on the column edge by default so nothing can overflow at
           mid-size desktop widths, where there is no spare gutter. */
        #shopify-section-{{ section.id }} .floating-controls-container--inside {
          --floating-controls-inset-inline: 0rem;
        }

        #shopify-section-{{ section.id }} .floating-controls-container__control {
          inset-block-start: 173px; /* fallback */
          inset-block-start: calc(((min(81.25rem, 100vw - 2.4rem) - 48px) / 4 * 380 / 313) / 2 - 1.03125rem);
        }
      }

      /* Only once the viewport is wide enough to hold them can the arrows sit
         fully outside the 1300px column, as the Figma shows. */
      @media screen and (pointer: fine) and (min-width: 1400px) {
        #shopify-section-{{ section.id }} .floating-controls-container--inside {
          --floating-controls-inset-inline: -2.625rem; /* 42px: 25px clear + half the disc */
        }
      }

      /* ---------- 375px mobile ---------- */
      @media screen and (max-width: 699px) {
        #shopify-section-{{ section.id }} {
          --container-gutter: 0.75rem; /* 12px each side -> 351px content at 375px */
          --section-vertical-spacing-override: 32px;
          --section-stack-gap: 16px;
        }

        /* Prestige forces --product-list-card-width to min(300px, 65%) for
           carousels below 700px (theme.css), which overrides
           products_per_row_mobile and leaves the second card clipped.
           Restore a true two-up width for this section only. */
        #shopify-section-{{ section.id }} .product-list--carousel {
          --product-list-default-column-gap: 0.625rem; /* 10px */
          --product-list-card-width: calc((100% - var(--product-list-calculated-column-gap)) / 2);
        }

        /* Header is left-aligned on mobile; the section setting stays centred
           so desktop is unaffected. */
        #shopify-section-{{ section.id }} .section-stack > .v-stack {
          justify-self: start;
          justify-items: start;
          text-align: start;
          gap: 2px;
        }

        #shopify-section-{{ section.id }} .section-stack > .v-stack > .h6 {
          text-align: start;
          font-size: 12px;
        }

        #shopify-section-{{ section.id }} .section-stack > .v-stack > h2 {
          text-align: start;
          font-size: 22px;
          line-height: 1.25;
        }

        #shopify-section-{{ section.id }} .product-card__figure > .badge-list {
          inset-block-start: 2px;
          inset-inline-start: 2px;
        }

        #shopify-section-{{ section.id }} .product-card__figure .badge-list .badge--custom {
          font-size: 10px;
        }

        #shopify-section-{{ section.id }} .product-card__figure .badge-list .badge--best-seller {
          padding: 5px 8px;
        }

        #shopify-section-{{ section.id }} .product-card__figure .badge-list .badge--new {
          padding: 3px 8px;
        }

        #shopify-section-{{ section.id }} .product-card__tag-wrapper {
          padding: 3px 10px;
        }

        #shopify-section-{{ section.id }} .product-card__tag {
          font-size: 11px;
        }

        #shopify-section-{{ section.id }} .product-card__info {
          gap: 8px;
          padding-top: 10px;
        }

        #shopify-section-{{ section.id }} .product-card__info .gap-1 {
          gap: 6px;
        }

        #shopify-section-{{ section.id }} .product-card-title {
          font-size: 13px;
          line-height: 18px;
        }

        #shopify-section-{{ section.id }} .rating-badge {
          column-gap: 4px;
          flex-wrap: nowrap;
        }

        #shopify-section-{{ section.id }} .rating-badge__stars > svg {
          width: 11px;
        }

        #shopify-section-{{ section.id }} .rating-badge .text-xxs {
          font-size: 11px;
        }

        #shopify-section-{{ section.id }} .price-list {
          font-size: 14px;
          column-gap: 6px;
        }

        #shopify-section-{{ section.id }} .price-list .text-on-sale {
          font-size: 14px;
        }

        #shopify-section-{{ section.id }} .price-list :is(s, .text-subdued) {
          font-size: 12px;
        }

        #shopify-section-{{ section.id }} .product-card__quick-add-button {
          padding: 6px;
          inset-block-end: 8px;
          inset-inline-end: 8px;
        }

        #shopify-section-{{ section.id }} .featured-collections-carousel__item > .justify-self-center {
          margin-block-start: 28px;
        }

        #shopify-section-{{ section.id }} .featured-collections-carousel__item > .justify-self-center .button {
          min-width: 180px;
          padding-block: 6px;
        }

        /* The Figma mobile design has no carousel arrows at all. Prestige already
           hides the outer controls on touch, so nothing is re-enabled here, and the
           per-product arrows are hidden too. */
        #shopify-section-{{ section.id }} .product-card__media-control {
          display: none;
        }

        /* Image-position indicator, sitting on the bottom edge of the image.
           Absolutely positioned so it adds no height to the card, and its
           segments are also the touch target for changing image. */
        #shopify-section-{{ section.id }} .product-card__media-pagination {
          z-index: 2;
          display: flex;
          position: absolute;
          inset-inline: 0;
          inset-block-end: 10px;
          justify-content: center;
          gap: 3px;
        }

        #shopify-section-{{ section.id }} .product-card__media-pagination > button {
          width: 18px;
          height: 12px;
          display: grid;
          place-items: center;
          padding: 0;
          border: 0;
          background: none;
        }

        /* .tap-area already uses ::before to widen the hit area, so the visible
           bar is drawn with ::after. */
        #shopify-section-{{ section.id }} .product-card__media-pagination > button::after {
          content: '';
          width: 100%;
          height: 3px;
          border-radius: 2px;
          background: rgb(43 39 36 / 0.3);
          transition: background 0.2s ease-in-out;
        }

        #shopify-section-{{ section.id }} .product-card__media-pagination > button[aria-current='true']::after {
          background: #2b2724;
        }
      }

      /* Below 375px stay fluid rather than overflowing */
      @media screen and (max-width: 374px) {
        #shopify-section-{{ section.id }} {
          --container-gutter: 0.5rem;
        }

        #shopify-section-{{ section.id }} .product-card-title {
          font-size: 12px;
          line-height: 17px;
        }
      }
    </style>
  {%- endif -%}

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %} {{ section.settings.custom_class }}">
    <div class="container">
      {%- assign wrapper_carousel_id = 'featured-collections-carousel-' | append: section.id -%}

      <div class="section-stack">
        {%- liquid
          assign hide_section_header = false

          if section.blocks.size <= 1 and section.settings.hide_collection_title and section.settings.subheading == blank
            assign hide_section_header = true
          endif
        -%}

        {%- unless hide_section_header -%}
          <div class="v-stack justify-self-{{ section.settings.header_alignment | replace: 'left', 'start' | replace: 'right', 'end' }} gap-4 text-center sm:gap-5">
            {%- if section.settings.subheading != blank -%}
              <p class="h6 text-center">{{- section.settings.subheading -}}</p>
            {%- endif -%}

            {%- if section.blocks.size > 1 -%}
              <carousel-navigation align-selected class="featured-collections-navigation scroll-area bleed" aria-controls="{{ wrapper_carousel_id }}">
                {%- for block in section.blocks -%}
                  <button class="{{ section.settings.heading_style }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                    {{- block.settings.title | default: block.settings.collection.title | default: 'Collection' -}}
                  </button>
                {%- endfor -%}
              </carousel-navigation>
            {%- elsif section.settings.hide_collection_title != true -%}
              <h2 class="{{ section.settings.heading_style }}">
                {{ section.blocks.first.settings.title | default: section.blocks.first.settings.collection.title | default: 'Collection' }}
              </h2>
            {%- endif -%}
          </div>
        {%- endunless -%}

        <featured-collections-carousel id="{{ wrapper_carousel_id }}" class="featured-collections-carousel">
          {%- for block in section.blocks -%}
            <div class="featured-collections-carousel__item {% if forloop.first %}is-selected{% endif %}" {{ block.shopify_attributes }}>
              {%- capture product_list -%}
                {%- assign should_reveal = false -%}

                {%- if settings.stagger_products_apparition and forloop.first -%}
                  {%- assign should_reveal = true -%}
                {%- endif -%}

                {%- comment -%}
                  Row 06 only. Outside the home_bestselling_rugs guard these stay nil/false,
                  so this render behaves exactly as before for every other instance.
                {%- endcomment -%}
                {%- liquid
                  assign row06_image_carousel = false
                  assign row06_show_quick_buy = null
                  assign row06_quick_buy_icon = null
                  assign row06_show_swatches = null

                  if section.settings.custom_class contains 'home_bestselling_rugs'
                    assign row06_image_carousel = true
                    assign row06_show_quick_buy = true
                    assign row06_quick_buy_icon = 'picto-bag-handle'
                    assign row06_show_swatches = false
                  endif
                -%}

                {%- for product in block.settings.collection.products limit: block.settings.products_count -%}
                  {%- render 'product-card',
                    product: product,
                    reveal: should_reveal,
                    position: forloop.index,
                    hide_product_information: section.settings.hide_product_information,
                    block: block,
                    image_carousel: row06_image_carousel,
                    show_quick_buy: row06_show_quick_buy,
                    quick_buy_icon: row06_quick_buy_icon,
                    show_swatches: row06_show_swatches
                  -%}
                {%- else -%}
                  {%- for i in (1..block.settings.products_count) -%}
                    {%- render 'product-card-placeholder', reveal: should_reveal, loop_index: forloop.index0, hide_product_information: section.settings.hide_product_information -%}
                  {%- endfor -%}
                {%- endfor -%}
              {%- endcapture -%}

              {%- if section.settings.stack_products -%}
                <product-list class="product-list {% if section.settings.hide_product_information %}product-list--compact{% endif %} justify-center">
                  {{- product_list -}}
                </product-list>
              {%- else -%}
                {%- assign product_carousel_id = 'featured-collections-product-list-carousel-' | append: block.id -%}

                <product-list class="floating-controls-container floating-controls-container--inside floating-controls-container--on-hover">
                  <carousel-prev-button class="floating-controls-container__control" aria-controls="{{ product_carousel_id }}">
                    <button type="button" class="prev-next-button prev-next-button--prev circle-button hover:animate-icon-inline" disabled>
                      <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
                      {%- render 'icon' with 'arrow-left', direction_aware: true -%}
                    </button>
                  </carousel-prev-button>

                  <scroll-carousel
                    id="{{ product_carousel_id }}"
                    group-cells
                    allow-drag
                    class="product-list {% if section.settings.hide_product_information %}product-list--compact{% endif %} product-list--carousel scroll-area bleed md:unbleed"
                  >
                    {{- product_list -}}
                  </scroll-carousel>

                  <carousel-next-button class="floating-controls-container__control" aria-controls="{{ product_carousel_id }}">
                    <button type="button" class="prev-next-button prev-next-button--next circle-button hover:animate-icon-inline">
                      <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
                      {%- render 'icon' with 'arrow-right', direction_aware: true -%}
                    </button>
                  </carousel-next-button>
                </product-list>
              {%- endif -%}

              {%- if block.settings.link_text != blank -%}
                {%- assign button_link = block.settings.link_url | default: block.settings.collection.url | default: '#' -%}

                <div class="justify-self-center">
                  {%- render 'button', href: button_link, content: block.settings.link_text -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </featured-collections-carousel>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.featured_collections.name",
  "class": "shopify-section--featured-collections",
  "tag": "section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class",
      "info": "Optional. Adds a class to this section so instance-specific CSS can be scoped to it."
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "t:global.product_list.hide_product_information",
      "info": "t:global.product_list.hide_product_information_info"
    },
    {
      "type": "header",
      "content": "t:global.product_list.product_list_category"
    },
    {
      "type": "checkbox",
      "id": "stack_products",
      "label": "t:global.product_list.stack_products",
      "default": false
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "t:global.product_list.products_per_row_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2",
