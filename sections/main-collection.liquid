{%- liquid
  # Production protection.
  #
  # Resolved here rather than further down because Liquid runs in order and the
  # count below needs it. The same variable is then read by the facets and
  # active-facets render calls later in this file, so there is one list feeding
  # all four surfaces: sidebar, drawer, chips and this count.
  assign production_filters = ''

  unless section.settings.enable_new_filters
    assign production_filters = section.settings.production_filters
  endunless

  assign count_allow_list = ''

  if production_filters != blank
    assign count_allow_list = production_filters | downcase | replace: ', ', ',' | strip | split: ','
  endif

  assign active_values_count = 0

  for filter in collection.filters
    # A filter that is not rendered must not be counted either, or the mobile
    # button would read "Filter (3)" with nothing in the drawer accounting for
    # it. Same matching as the snippets: label or param_name, case insensitive.
    assign count_filter = true

    if count_allow_list != ''
      assign count_filter = false
      assign count_label = filter.label | downcase | strip
      assign count_param = filter.param_name | downcase | strip

      for allowed in count_allow_list
        assign allowed_key = allowed | strip

        if count_label == allowed_key or count_param == allowed_key
          assign count_filter = true
          break
        endif
      endfor
    endif

    if count_filter
      if filter.type == 'price_range'
        if filter.max_value.value != blank or filter.min_value.value != blank
          assign active_values_count = active_values_count | plus: 1
        endif
      else
        assign active_values_count = active_values_count | plus: filter.active_values.size
      endif
    endif
  endfor

  if section.settings.quick_links_menu.links.size > 0 or section.settings.show_filters and collection.filters.size > 0
    assign show_filters = true
  else
    assign show_filters = false
  endif

  # First, we retrieve, based on the merchant settings, the user preferences and the available space the most appropriate size
  assign products_mobile_grid_mode = cart.attributes.products_mobile_grid_mode

  if request.design_mode
    # In the theme editor we do not use the choice selected manually, to reduce confusion when changing the theme editor values
    assign products_desktop_grid_mode = section.settings.products_size_desktop
  elsif section.settings.show_grid_mode_selector
    assign products_desktop_grid_mode = cart.attributes.products_desktop_grid_mode | default: section.settings.products_size_desktop
  else
    assign products_desktop_grid_mode = section.settings.products_size_desktop
  endif

  if products_mobile_grid_mode == blank or request.design_mode
    if section.settings.products_per_row_mobile == '1'
      assign products_mobile_grid_mode = 'large'
    else
      assign products_mobile_grid_mode = 'medium'
    endif
  endif
-%}

{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  CSS
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
    --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};

    {% comment %}On mobile, it's simple! No sidebar or whatever{% endcomment %}
    --collection-items-per-row-medium: 2;
    --collection-items-per-row-large: 1;
  }

  #shopify-section-{{ section.id }} .product-list {
    --product-list-max-items-per-row-allowed: 99 !important; {% comment %}On collection page, we explicitly set a number of items so we don't want this{% endcomment %}
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      {% comment %}On tablet, we do not have any sidebar, so we can fix it{% endcomment %}
      --collection-items-per-row-compact: 4;
      --collection-items-per-row-medium: 3;
      --collection-items-per-row-large: 2;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- comment -%}Starting from 1000px it starts to get funky, as we can have or not the sidebar{%- endcomment -%}

      {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
        --collection-items-per-row-compact: 4;
        --collection-items-per-row-medium: 3;
        --collection-items-per-row-large: 2;
      {%- else -%}
        --collection-items-per-row-compact: 6;
        --collection-items-per-row-medium: 4;
        --collection-items-per-row-large: 3;
      {%- endif -%}
    }

    #shopify-section-{{ section.id }} .collection {
      {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
        --collection-grid-template: var(--collection-sidebar-width, 0) minmax(0,1fr);
      {%- endif -%}
    }
  }

  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} {
      {%- comment -%}Starting from 1400px we can afford having more content even in sidebar mode{%- endcomment -%}

      {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
        --collection-items-per-row-compact: 6;
        --collection-items-per-row-medium: 4;
        --collection-items-per-row-large: 3;
      {%- endif -%}
    }
  }

  {%- if section.settings.enable_new_filters -%}
    /* ---------- Shop by Color (Phase 1) ----------
       Only emitted while the development gate is on. */
    #shopify-section-{{ section.id }} .pf-colors {
      display: flex;
      align-items: baseline;
      gap: 16px;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .pf-colors__heading {
      flex: none;
      margin: 0;
      font-size: 16px;
      line-height: 22px;
      font-weight: 600;
      color: #000000;
    }

    /* Horizontal overflow is on the track, so the row can scroll without the
       page ever gaining a scrollbar. */
    #shopify-section-{{ section.id }} .pf-colors__track {
      display: flex;
      align-items: flex-start;
      gap: 20px;
      min-width: 0;
      overflow: auto hidden;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .pf-colors__track::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .pf-color {
      flex: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      /* Inactive */
      font-size: 13px;
      line-height: 28px;
      font-weight: 400;
      color: #696969;
    }

    #shopify-section-{{ section.id }} .pf-color.is-active {
      font-size: 13px;
      line-height: 15px;
      font-weight: 600;
      color: #000000;
    }

    /* One box whether it holds a metaobject image, a swatch image or a plain
       colour, so the row keeps its rhythm regardless of what Shopify returns. */
    #shopify-section-{{ section.id }} .pf-color__media {
      display: block;
      width: {{ section.settings.color_swatch_size }}px;
      height: {{ section.settings.color_swatch_size }}px;
      border-radius: var(--rounded-full);
      object-fit: cover;
      background-size: cover;
      background-position: center;
      box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
    }

    #shopify-section-{{ section.id }} .pf-color.is-active .pf-color__media {
      box-shadow:
        inset 0 0 0 1px rgb(0 0 0 / 0.08),
        0 0 0 2px #ffffff,
        0 0 0 3.5px #000000;
    }

    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .pf-colors {
        display: block;
      }

      #shopify-section-{{ section.id }} .pf-colors__heading {
        margin-block-end: 10px;
      }

      #shopify-section-{{ section.id }} .pf-color {
        font-size: 12px;
        line-height: 17px;
        font-weight: 500;
        color: #7D7D7D;
      }

      #shopify-section-{{ section.id }} .pf-color.is-active {
        font-size: 12px;
        line-height: 17px;
        font-weight: 600;
        color: #000000;
      }
    }
  {%- endif -%}
</style>

{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  LIQUID
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- comment -%}
  production_filters is resolved in the liquid block at the top of this file, so
  that the filter count there uses the same list as the render calls below.
{%- endcomment -%}
<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container">
    <div class="v-stack gap-6 sm:gap-12">
      {%- comment -%}
        ------------------------------------------------------------------
        NEW PLP FILTERS - development gate
        ------------------------------------------------------------------
        enable_new_filters is off by default. While it is off nothing below
        is rendered at all, so the published theme keeps today's production
        filter untouched and no unfinished markup reaches a customer. This
        is a Liquid gate, not display:none: the HTML is never produced.

        Phase 1 is Shop by Color only. The remaining phases will be added
        inside the same gate.
      {%- endcomment -%}
      {%- if section.settings.enable_new_filters -%}
        {%- liquid
          # Find the colour filter in whatever Search & Discovery returns.
          # Nothing here is hardcoded: the values, labels, counts, URLs and
          # active states all come from collection.filters. Only the name of
          # the GROUP is configurable, because Shopify gives no other way to
          # tell one list filter from another.
          assign color_filter = null
          assign wanted = section.settings.color_filter_label | downcase | strip

          for f in collection.filters
            if color_filter == null
              assign f_label = f.label | downcase | strip
              assign f_param = f.param_name | downcase

              if f_label == wanted or f_param contains 'color' or f_param contains 'colour'
                assign color_filter = f
              endif
            endif
          endfor
        -%}

        {%- if color_filter != null and color_filter.values.size > 0 -%}
          <div class="pf-colors">
            <p class="pf-colors__heading">{{ section.settings.color_filter_heading }}</p>

            <div class="pf-colors__track">
              {%- for value in color_filter.values -%}
                {%- comment -%}
                  url_to_add and url_to_remove are Shopify's own, so the link
                  carries the real filter state and a plain navigation applies
                  it. active comes from Shopify too, so after the section is
                  re-rendered the selected colour is still marked.
                {%- endcomment -%}
                <a
                  class="pf-color {% if value.active %}is-active{% endif %}"
                  href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                  {% if value.active %}aria-current="true"{% endif %}
                >
                  {%- if value.image != blank -%}
                    {{-
                      value.image
                      | image_url: width: 120
                      | image_tag: class: 'pf-color__media', loading: 'lazy', widths: '40,80,120', sizes: '40px', alt: ''
                    -}}
                  {%- elsif value.swatch.image != blank -%}
                    {{-
                      value.swatch.image
                      | image_url: width: 120
                      | image_tag: class: 'pf-color__media', loading: 'lazy', widths: '40,80,120', sizes: '40px', alt: ''
                    -}}
                  {%- elsif value.swatch.color != blank -%}
                    <span class="pf-color__media" style="background: {{ value.swatch.color }};"></span>
                  {%- endif -%}

                  <span class="pf-color__label">{{ value.label }}</span>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if collection.all_products_count == 0 -%}
        <div class="empty-state">
          <div class="prose">
            <h1 class="h4">{{ collection.title }}</h1>
            <p>{{ 'collection.general.empty_collection' | t }}</p>

            {%- assign button_content = 'collection.general.continue_shopping' | t -%}
            {%- render 'button', href: routes.all_products_collection_url, size: 'xl', content: button_content -%}
          </div>
        </div>
      {%- else -%}
        {%- if show_filters or section.settings.show_sort_by or section.settings.show_grid_mode_selector or section.settings.show_results_count -%}
          <height-observer variable="collection-toolbar" class="collection-toolbar full-bleed">
            <div class="collection-toolbar__button-list">
              {%- if show_filters -%}
                <div class="collection-toolbar__button-container {% if section.settings.filter_layout == 'sidebar' %}md:hidden{% endif %}">
                  <button type="button" aria-controls="facets-drawer" class="collection-toolbar__button heading text-xxs w-full">
                    {{- 'collection.faceting.filter_button' | t }}
                    {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
                  </button>
                </div>
              {%- endif -%}

              {%- if section.settings.show_sort_by -%}
                {%- assign selected_sort_by_value = collection.sort_by | default: collection.default_sort_by -%}

                <div class="collection-toolbar__button-container">
                  <button type="button" aria-controls="sort-by-popover" class="collection-toolbar__button heading text-xxs w-full">
                    <span class="text-with-icon justify-center">
                      {{- 'collection.faceting.sort_by' | t -}}
                      {%- render 'icon' with 'chevron-down' -%}
                    </span>
                  </button>

                  <facets-sort-popover
                    id="sort-by-popover"
                    section-id="{{ section.id }}"
                    class="popover popover--bottom-end color-scheme color-scheme--dialog"
                    close-on-listbox-select
                  >
                    <p class="h4" slot="header">{{ 'collection.faceting.sort_by' | t }}</p>

                    <x-listbox class="popover__value-list">
                      {%- for sort_option in collection.sort_options -%}
                        {%- if sort_option.name != blank -%}
                          <button
                            type="button"
                            class="popover__value-option group"
                            role="option"
                            value="{{ sort_option.value }}"
                            {% if sort_option.value == selected_sort_by_value %}
                              aria-selected="true"
                            {% endif %}
                          >
                            <span class="reversed-link">{{ sort_option.name }}</span>
                          </button>
                        {%- endif -%}
                      {%- endfor -%}
                    </x-listbox>
                  </facets-sort-popover>
                </div>
              {%- endif -%}
            </div>

            {%- if section.settings.show_results_count -%}
              <p class="collection-toolbar__products-count h6 text-subdued md-max:hidden">
                {{ 'collection.products_count' | t: count: collection.products_count }}
              </p>
            {%- endif -%}

            {%- if section.settings.show_grid_mode_selector -%}
              <collection-layout-switch device="mobile" class="collection-toolbar__layout-switch-list sm:hidden" aria-controls="product-list-{{ section.id }}">
                <button
                  type="button"
                  value="large"
                  class="collection-toolbar__button {% if products_mobile_grid_mode == 'large' %}is-active{% endif %}"
                  aria-label="Switch to larger product images"
                >
                  {%- render 'icon' with 'collection-layout-1' -%}
                </button>
                <button
                  type="button"
                  value="medium"
                  class="collection-toolbar__button {% if products_mobile_grid_mode == 'medium' %}is-active{% endif %}"
                  aria-label="Switch to smaller product images"
                >
                  {%- render 'icon' with 'collection-layout-2' -%}
                </button>
              </collection-layout-switch>

              <collection-layout-switch device="desktop" class="collection-toolbar__layout-switch-list sm-max:hidden" aria-controls="product-list-{{ section.id }}">
                <button
                  type="button"
                  value="large"
                  class="collection-toolbar__button {% if products_desktop_grid_mode == 'large' %}is-active{% endif %}"
                  aria-label="Switch to larger product images"
                >
                  {%- render 'icon' with 'collection-layout-2' -%}
                </button>
                <button
                  type="button"
                  value="medium"
                  class="collection-toolbar__button {% if products_desktop_grid_mode == 'medium' %}is-active{% endif %}"
                  aria-label="Switch to smaller product images"
                >
                  {%- render 'icon' with 'collection-layout-3' -%}
                </button>
                <button
                  type="button"
                  value="compact"
                  class="collection-toolbar__button {% if products_desktop_grid_mode == 'compact' %}is-active{% endif %}"
                  aria-label="Switch to compact product images"
                >
                  {%- render 'icon' with 'collection-layout-4' -%}
                </button>
              </collection-layout-switch>
            {%- endif -%}
          </height-observer>
        {%- endif -%}

        <div class="collection">
          {%- paginate collection.products by section.settings.products_per_page -%}
            {%- if show_filters -%}
              <facets-drawer
                id="facets-drawer"
                class="facets-drawer drawer drawer--sm color-scheme color-scheme--dialog {% if section.settings.filter_layout == 'sidebar' %}md:hidden{% endif %}"
              >
                <p class="h4" slot="header">{{ 'collection.faceting.filters' | t }}</p>

                {%- render 'facets',
                  results: collection,
                  show_filters: section.settings.show_filters,
                  open_filters_by_default: section.settings.open_filters_by_default,
                  update_on_change: false,
                  quick_links_menu: section.settings.quick_links_menu,
                  allowed_filters: production_filters,
                  context: 'drawer'
                -%}

                <div slot="footer">
                  {%- assign button_content = 'collection.faceting.apply_filters' | t -%}

                  <dialog-close-button class="contents">
                    {%- render 'button', type: 'button', content: button_content, stretch: true -%}
                  </dialog-close-button>
                </div>
              </facets-drawer>

              {%- if section.settings.filter_layout == 'sidebar' -%}
                <safe-sticky class="facets-sidebar md-max:hidden">
                  {%- render 'facets',
                    results: collection,
                    show_filters: section.settings.show_filters,
                    open_filters_by_default: section.settings.open_filters_by_default,
                    update_on_change: true,
                    quick_links_menu: section.settings.quick_links_menu,
                    allowed_filters: production_filters,
                    context: 'sidebar'
                  -%}
                </safe-sticky>
              {%- endif -%}
            {%- endif -%}

            {%- if collection.products_count == 0 -%}
              <div class="empty-state">
                <div class="v-stack gap-4">
                  <p>{{ 'collection.faceting.no_results' | t }}</p>

                  {%- assign button_content = 'collection.faceting.clear_filters' | t -%}

                  <facet-link>
                    {%- render 'button', href: collection.url, content: button_content -%}
                  </facet-link>
                </div>
              </div>
            {%- else -%}
              <div class="collection__main">
                {%- comment -%}
                  The chips get the same list, otherwise a hidden filter arriving
                  through a pasted URL would still appear as a removable chip in
                  production.
                {%- endcomment -%}
                {%- render 'active-facets', results: collection, allowed_filters: production_filters -%}

                <product-list
                  id="product-list-{{ section.id }}"
                  class="product-list"
                  collection-mobile-layout="{{ products_mobile_grid_mode }}"
                  collection-desktop-layout="{{ products_desktop_grid_mode }}"
                >
                  {% liquid
                    for product in collection.products
                      for block in section.blocks
                        if forloop.parentloop.index == block.settings.position
                          render 'collection-promo-block', block: block, reveal: true
                        endif
                      endfor

                      render 'product-card', product: product, reveal: settings.stagger_products_apparition, position: forloop.index, hide_product_information: section.settings.hide_product_information, stacked: true
                    endfor
                  %}
                </product-list>

                {%- render 'pagination', paginate: paginate, facet: true -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "class": "shopify-section--main-collection",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "t:global.product_list.hide_product_information",
      "info": "t:global.product_list.hide_product_information_collection_info"
    },
    {
      "type": "header",
      "content": "t:global.product_list.product_list_category"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:global.faceting.products_per_page",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 48
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "t:global.product_list.products_per_row_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "products_size_desktop",
      "label": "t:global.product_list.products_size_desktop",
      "info": "t:global.product_list.products_size_desktop_info",
      "options": [
        {
          "value": "compact",
          "label": "t:global.product_list.products_size_desktop_options.compact"
        },
        {
          "value": "medium",
          "label": "t:global.product_list.products_size_desktop_options.medium"
        },
        {
          "value": "large",
          "label": "t:global.product_list.products_size_desktop_options.large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_grid_mode_selector",
      "label": "t:global.product_list.show_grid_mode_selector",
      "info": "t:global.product_list.show_grid_mode_selector_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:global.product_list.spacing_category",
      "info": "t:global.product_list.spacing_category_info"
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "horizontal_spacing_factor",
      "label": "t:global.product_list.horizontal_spacing_factor",
      "default": 1
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "vertical_spacing_factor",
      "label": "t:global.product_list.vertical_spacing_factor",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:global.faceting.filters_and_sorting_category"
    },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "t:global.faceting.desktop_layout",
      "options": [
        {
          "value": "sidebar",
          "label": "t:global.faceting.desktop_layout_options.sidebar"
        },
        {
          "value": "drawer",
          "label": "t:global.faceting.desktop_layout_options.drawer"
        }
      ],
      "default": "sidebar"
    },
    {
      "type": "link_list",
      "id": "quick_links_menu",
      "label": "t:sections.main_collection.quick_links_menu",
      "info": "t:sections.main_collection.quick_links_menu_info"
    },
    {
      "type": "checkbox",
      "id": "show_sort_by",
      "label": "t:global.faceting.show_sort_by",
      "default": true
    },
    {
      "type": "header",
      "content": "New filters (development)"
    },
    {
      "type": "checkbox",
      "id": "enable_new_filters",
      "label": "Enable the new filter experience",
      "info": "Off renders the existing production filter. Turn this on only in a development or draft theme: the new implementation is still being built, and while this is off none of its markup is rendered at all.",
      "default": false
    },
    {
      "type": "text",
      "id": "production_filters",
      "label": "Production filters (allow-list)",
      "info": "Only these filters render while the new implementation is off. Comma separated, matched on the filter label or its param_name. Any filter added in Search & Discovery that is not listed here stays hidden from the production sidebar automatically.",
      "default": "Availability, Price"
    },
    {
      "type": "text",
      "id": "color_filter_heading",
      "label": "Shop by Color heading",
      "default": "Shop by Color:"
    },
    {
      "type": "text",
      "id": "color_filter_label",
      "label": "Colour filter name",
      "info": "The exact label of the colour filter in Search & Discovery. Values, counts and links always come from Shopify; this only identifies which filter group is the colour one.",
      "default": "Color"
    },
    {
      "type": "range",
      "id": "color_swatch_size",
      "label": "Colour swatch size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:global.faceting.show_filters",
      "info": "t:global.faceting.show_filters_info",
      "default": true
    },
