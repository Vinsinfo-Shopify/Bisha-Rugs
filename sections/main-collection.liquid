{%- liquid
  # Production protection.
  #
  # Resolved first because Liquid runs in order. The same list is then passed to
  # the facets, toolbar and active-facets render calls later in this file, so
  # there is one list feeding all four surfaces: sidebar, drawer, chips and the
  # filter count. It is built by plp-filter-allowlist so search can share it.
  capture production_filters
    render 'plp-filter-allowlist', results: collection
  endcapture

  if section.settings.quick_links_menu.links.size > 0 or section.settings.show_filters and collection.filters.size > 0
    assign show_filters = true
  else
    assign show_filters = false
  endif

  # First, we retrieve, based on the merchant settings, the user preferences and the available space the most appropriate size
  assign products_mobile_grid_mode = cart.attributes.products_mobile_grid_mode

  if request.design_mode
    # In the theme editor we do not use the choice selected manually, to reduce confusion when changing the theme editor values
    assign products_desktop_grid_mode = section.settings.products_size_desktop
  elsif section.settings.show_grid_mode_selector
    assign products_desktop_grid_mode = cart.attributes.products_desktop_grid_mode | default: section.settings.products_size_desktop
  else
    assign products_desktop_grid_mode = section.settings.products_size_desktop
  endif

  if products_mobile_grid_mode == blank or request.design_mode
    if section.settings.products_per_row_mobile == '1'
      assign products_mobile_grid_mode = 'large'
    else
      assign products_mobile_grid_mode = 'medium'
    endif
  endif
-%}

{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  CSS
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'plp-styles', show_filters: show_filters -%}

{%- comment -%}
  ------------------------------------------------------------------------------------------------------------------------
  LIQUID
  ------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- comment -%}
  The markup of the listing layout lives in the plp-* snippets, shared with the
  search section. production_filters is resolved in the liquid block at the top
  of this file and passed to each of them.
{%- endcomment -%}
<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container">
    <div class="v-stack gap-6 sm:gap-12">
      {%- comment -%}
        ------------------------------------------------------------------
        NEW PLP FILTERS - development gate
        ------------------------------------------------------------------
        enable_new_filters is off by default. While it is off nothing below
        is rendered at all, so the published theme keeps today's production
        filter untouched and no unfinished markup reaches a customer. This
        is a Liquid gate, not display:none: the HTML is never produced.

        Phase 1 is Shop by Color only. The remaining phases will be added
        inside the same gate.
      {%- endcomment -%}
      {%- if section.settings.enable_new_filters -%}
        {%- render 'plp-color-strip', results: collection -%}
      {%- endif -%}

      {%- if collection.all_products_count == 0 -%}
        <div class="empty-state">
          <div class="prose">
            <h1 class="h4">{{ collection.title }}</h1>
            <p>{{ 'collection.general.empty_collection' | t }}</p>

            {%- assign button_content = 'collection.general.continue_shopping' | t -%}
            {%- render 'button', href: routes.all_products_collection_url, size: 'xl', content: button_content -%}
          </div>
        </div>
      {%- else -%}
        <div class="collection">
          {%- paginate collection.products by section.settings.products_per_page -%}
            {%- render 'plp-facets',
              results: collection,
              show_filters: show_filters,
              production_filters: production_filters
            -%}

            {%- if collection.products_count == 0 -%}
              <div class="empty-state">
                <div class="v-stack gap-4">
                  <p>{{ 'collection.faceting.no_results' | t }}</p>

                  {%- assign button_content = 'collection.faceting.clear_filters' | t -%}

                  <facet-link>
                    {%- render 'button', href: collection.url, content: button_content -%}
                  </facet-link>
                </div>
              </div>
            {%- else -%}
              <div class="collection__main">
                {%- render 'plp-toolbar',
                  results: collection,
                  show_filters: show_filters,
                  production_filters: production_filters,
                  products_count: collection.products_count,
                  products_mobile_grid_mode: products_mobile_grid_mode,
                  products_desktop_grid_mode: products_desktop_grid_mode
                -%}

                {%- comment -%}
                  The chips get the same list, otherwise a hidden filter arriving
                  through a pasted URL would still appear as a removable chip in
                  production.
                {%- endcomment -%}
                {%- render 'active-facets',
                  results: collection,
                  allowed_filters: production_filters,
                  scroll_indicator: section.settings.enable_new_filters
                -%}

                <product-list
                  id="product-list-{{ section.id }}"
                  class="product-list"
                  collection-mobile-layout="{{ products_mobile_grid_mode }}"
                  collection-desktop-layout="{{ products_desktop_grid_mode }}"
                >
                  {% liquid
                    for product in collection.products
                      for block in section.blocks
                        if forloop.parentloop.index == block.settings.position
                          render 'collection-promo-block', block: block, reveal: true
                        endif
                      endfor

                      render 'product-card', product: product, reveal: settings.stagger_products_apparition, position: forloop.index, hide_product_information: section.settings.hide_product_information, stacked: true
                    endfor
                  %}
                </product-list>

                {%- render 'pagination', paginate: paginate, facet: true -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.enable_new_filters -%}
  <script src="{{ 'plp-filters.js' | asset_url }}" defer></script>
{%- endif -%}

