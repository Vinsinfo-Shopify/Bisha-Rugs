{%- if section.blocks.size > 0 -%}
  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %} {{ section.settings.custom_class }}">
<style>
  #shopify-section-{{ section.id }} .faq-breadcrumb {
    justify-content: center;
    column-gap: 8px;
    margin-block-end: 20px;
  }
  #shopify-section-{{ section.id }} .faq-breadcrumb .breadcrumb__list-item {
    align-items: center;
    column-gap: 8px;
    display: flex;
  }
  #shopify-section-{{ section.id }} .faq-breadcrumb a {
    color: rgb(var(--text-color));
    text-decoration: none;
  }
    #shopify-section-{{ section.id }} .faq-breadcrumb a:hover{
      color: #b35642;
    }
  #shopify-section-{{ section.id }} .faq-breadcrumb .breadcrumb__list-item:last-child span {
    color: rgb(var(--text-color) / .55);
  }

  #shopify-section-{{ section.id }} .faq-layout--with-sidebar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 40px;
  }
  #shopify-section-{{ section.id }} .faq-layout--with-sidebar .section-header {
    text-align: start;
    justify-items: start;
  }
  #shopify-section-{{ section.id }} .faq-layout--with-sidebar .section-header > * {
    margin-inline: 0;
  }

  #shopify-section-{{ section.id }} .faq-sidebar {
     background: #F5F5F5;
    border-radius: 9px;
    padding: 40px 30px;
    align-self: start;
    color:rgb(var(--text-color)) ;
  }
  /* Pill-shaped buttons, matching reference */
  #shopify-section-{{ section.id }} .faq-sidebar-btn1,
  #shopify-section-{{ section.id }} .faq-sidebar-btn2 {
    transition: background-color .2s ease-in-out, color .2s ease-in-out, border-color .2s ease-in-out;
    font-weight: 700;
    line-height: 140%;
    vertical-align: middle;
    font-size: 16px;
  }

  /* Outline "Contact Us" button — black border/text normally,
     hover uses the section's scheme button color as background */
  #shopify-section-{{ section.id }} .faq-sidebar-btn1 {
    background-color: transparent;
    color: #000000;
    border-color: #000000;
  }
  #shopify-section-{{ section.id }} .faq-sidebar-btn1:hover {
    background-color: rgb(var(--button-background));
    color: rgb(var(--button-text-color));
    border-color: #000000;
  }

  /* Solid "About Us" button — black bg / white text normally,
     hover flips to white bg / black text */
  #shopify-section-{{ section.id }} .faq-sidebar-btn2 {
    background-color: #000000;
    color: #FFFFFF;
    border-color: #000000;
  }
  #shopify-section-{{ section.id }} .faq-sidebar-btn2:hover {
    color: #ffffff;
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .faq-layout--with-sidebar {
      grid-template-columns: 26.625rem minmax(0, 1fr);
      column-gap: 60px;
      row-gap: 0;
      align-items: start;
    }
  }
</style>

    <div class="container container--md">
      <div class="section-stack">
        {%- if section.settings.show_breadcrumb -%}
          <nav class="faq-breadcrumb breadcrumb__list text-sm" aria-label="breadcrumb">
            <span class="breadcrumb__list-item">
              <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_label }}</a>
              <span aria-hidden="true">/</span>
            </span>
            <span class="breadcrumb__list-item">
              <span>{{ section.settings.breadcrumb_current_label }}</span>
            </span>
          </nav>
        {%- endif -%}

        <div class="faq_section_header">
          {%- render 'section-header',
            subheading: section.settings.subheading,
            heading: section.settings.title,
            heading_style: section.settings.heading_style,
            content: section.settings.content
          -%}
        </div>

        <div class="faq-layout {% if section.settings.show_sidebar %}faq-layout--with-sidebar{% endif %}">
          {%- if section.settings.show_sidebar -%}
            <div class="faq-sidebar v-stack gap-6 {{ section.settings.sidebar_custom_class }}">
              {%- if section.settings.sidebar_heading != blank -%}
                <h2 class="h2 faq-sidebar_header">{{ section.settings.sidebar_heading }}</h2>
              {%- endif -%}

              {%- if section.settings.sidebar_text != blank -%}
                <div class="prose">
                  {{ section.settings.sidebar_text }}
                </div>
              {%- endif -%}

              {%- if section.settings.sidebar_button_1_label != blank or section.settings.sidebar_button_2_label != blank -%}
                <div class="v-stack gap-3">
                  {%- if section.settings.sidebar_button_1_label != blank -%}
                    <a
                      {% if section.settings.sidebar_button_1_link != blank %}
                        href="{{ section.settings.sidebar_button_1_link }}"
                      {% endif %}
                      class="button button--outline w-full faq-sidebar-btn1"
                    >
                      {{ section.settings.sidebar_button_1_label }}
                    </a>
                  {%- endif -%}

                  {%- if section.settings.sidebar_button_2_label != blank -%}
                    <a
                      {% if section.settings.sidebar_button_2_link != blank %}
                        href="{{ section.settings.sidebar_button_2_link }}"
                      {% endif %}
                      class="button w-full faq-sidebar-btn2"
                    >
                      {{ section.settings.sidebar_button_2_label }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="faq-main section-stack {{ section.settings.faq_custom_class }}">
            <div class="faq">
              {%- assign categories_blocks = section.blocks | where: 'type', 'category' -%}

              {%- if section.settings.show_categories and categories_blocks.size > 0 -%}
                <faq-toc class="faq__toc hidden md:grid">
                  {%- for block in categories_blocks -%}
                    <a class="faq__toc-item {% if forloop.first %}is-active{% endif %}" href="#block-{{ block.id }}">{{ block.settings.title }}</a>
                  {%- endfor -%}
                </faq-toc>
              {%- endif -%}

              <div class="faq__content">
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when 'category' -%}
                      {%- if block.settings.title != blank -%}
                        <p id="block-{{ block.id }}" class="faq__category h2 {{ block.settings.custom_class }}" {{ block.shopify_attributes }}>
                          {%- if block.settings.custom_icon != blank -%}
                            {%- capture sizes -%}{{ block.settings.icon_width }}px{%- endcapture -%}
                            {%- capture widths -%}{{ block.settings.icon_width }}, {{ block.settings.icon_width | times: 2 | at_most: block.settings.custom_icon.width }}{%- endcapture -%}
                            {%- capture style -%}--image-max-width: {{ block.settings.icon_width }}px{%- endcapture -%}

                            {{-
                              block.settings.custom_icon
                              | image_url: width: block.settings.custom_icon.width
                              | image_tag: sizes: sizes, widths: widths, class: 'constrained-image', style: style
                            -}}
                          {%- elsif block.settings.icon != 'none' -%}
                            {%- render 'icon' with block.settings.icon, width: block.settings.icon_width -%}
                          {%- endif -%}

                          {{- block.settings.title -}}
                        </p>
                      {%- endif -%}

                    {%- when 'question' -%}
                      {%- if block.settings.question != blank and block.settings.answer != blank -%}
                        {%- capture answer -%}
                          <div class="prose">
                            {{- block.settings.answer -}}
                          </div>
                        {%- endcapture -%}

                        {%- render 'accordion', title: block.settings.question, content: answer, show_title_as_text: true, block: block, class: block.settings.custom_class -%}
                      {%- endif -%}
                  {%- endcase -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%}We also output the content with JSON microdata for SEO{%- endcomment -%}

  <script type="application/ld+json">
    {%- assign question_blocks = section.blocks | where: 'type', 'question' -%}

    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in question_blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

