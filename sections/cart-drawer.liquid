{%- liquid
  assign tier_1_amount = 0
  assign tier_2_amount = 0

  if section.settings.promo_tier_1_threshold > 0
    assign tier_1_amount = section.settings.promo_tier_1_threshold | times: 100
  endif

  if section.settings.promo_tier_2_threshold > 0
    assign tier_2_amount = section.settings.promo_tier_2_threshold | times: 100
  endif

  assign tier_1_reached = false
  if tier_1_amount > 0 and cart.total_price >= tier_1_amount
    assign tier_1_reached = true
  endif

  assign compare_at_savings = 0
  for item in cart.items
    if item.variant.compare_at_price > item.variant.price
      assign line_compare_at = item.variant.compare_at_price | times: item.quantity
      assign line_saving = line_compare_at | minus: item.original_line_price
      assign compare_at_savings = compare_at_savings | plus: line_saving
    endif
  endfor

  assign discount_savings = cart.original_total_price | minus: cart.total_price
  assign total_savings = compare_at_savings | plus: discount_savings

  assign standard_shipping = 0
  if section.settings.shipping_standard_amount > 0
    assign standard_shipping = section.settings.shipping_standard_amount | times: 100
  endif

  if section.settings.shipping_percentage > 0
    assign standard_shipping = cart.items_subtotal_price | times: section.settings.shipping_percentage | divided_by: 10000.0 | round | times: 100
  endif

  assign sticky_style = section.settings.sticky_cta_style
  assign summary_in_footer = false
  if sticky_style == 'total' or sticky_style == 'shipping_total'
    assign summary_in_footer = true
  endif

  assign cart_form_id = 'cart-drawer-form-' | append: section.id

  assign item_word = section.settings.item_label_plural
  if cart.item_count == 1
    assign item_word = section.settings.item_label_singular
  endif

  assign drawer_heading = section.settings.heading_text
  if drawer_heading == blank
    assign drawer_heading = 'cart.general.title' | t
  endif
-%}

{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

{%- capture cart_drawer_tokens -%}
  --cart-drawer-accent-rgb: {{ section.settings.accent_color.rgb }};
  --cart-drawer-accent-text-rgb: {{ section.settings.accent_text_color.rgb }};
  --cart-drawer-surface: {{ section.settings.surface_color }};
  --cart-drawer-badge: {{ section.settings.sale_badge_color }};
  --cart-drawer-savings-background: {{ section.settings.savings_background_color }};
  --cart-drawer-savings-text: {{ section.settings.savings_text_color }};
  --cart-drawer-promo-accent: {{ section.settings.promo_accent_color }};
  --cart-drawer-promo-unlocked-background: {{ section.settings.promo_unlocked_background }};
  --cart-drawer-promo-icon-size: {{ section.settings.promo_icon_size }}px;
  --cart-drawer-strip-background: {{ section.settings.service_strip_background }};
  --cart-drawer-strip-text: {{ section.settings.service_strip_text_color }};
  --cart-drawer-strip-font-size: {{ section.settings.service_strip_text_size_desktop }}px;
  --cart-drawer-strip-font-size-mobile: {{ section.settings.service_strip_text_size_mobile }}px;
  --cart-drawer-strip-icon-size: {{ section.settings.service_strip_icon_size_desktop }}px;
  --cart-drawer-strip-icon-size-mobile: {{ section.settings.service_strip_icon_size_mobile }}px;
  --cart-drawer-service-font-size: {{ section.settings.service_list_text_size_desktop }}px;
  --cart-drawer-service-font-size-mobile: {{ section.settings.service_list_text_size_mobile }}px;
  --cart-drawer-service-icon-size: {{ section.settings.service_list_icon_size_desktop }}px;
  --cart-drawer-service-icon-size-mobile: {{ section.settings.service_list_icon_size_mobile }}px;
  --cart-drawer-card-width: {{ section.settings.cross_sell_card_width }}px;
{%- endcapture -%}

<cart-drawer
  id="cart-drawer"
  aria-label="{{ 'cart.general.title' | t | escape_once }}"
  class="cart-drawer drawer {% if cart.empty? %}drawer--center-body{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  initial-focus="false"
  handle-editor-events
  style="{{ cart_drawer_tokens | strip_newlines | strip }}"
>
  <p class="cart-drawer__heading" slot="header">
    {{- drawer_heading }}
    {%- unless cart.empty? %} <span class="cart-drawer__heading-count">({{ cart.item_count }} {{ item_word }})</span>{% endunless -%}
  </p>

  {%- if cart.empty? -%}
    <div class="cart-drawer__empty">
      <p class="h5 text-center">{{ 'cart.general.empty' | t }}</p>
      {%- assign continue_shopping = 'cart.general.continue_shopping' | t -%}
      {%- render 'button', content: continue_shopping, href: settings.cart_empty_cart_link -%}
    </div>
  {%- else -%}
    {%- render 'cart-drawer-service-strip', section: section -%}

    {%- render 'cart-drawer-promo',
      section: section,
      tier_1_amount: tier_1_amount,
      tier_2_amount: tier_2_amount,
      tier_1_reached: tier_1_reached
    -%}

    <div class="cart-drawer__items">
      {%- for line_item in cart.items -%}
        {%- render 'line-item', line_item: line_item, section: section -%}
      {%- endfor -%}
    </div>

    {%- render 'cart-drawer-customers-also-bought', section: section -%}

    {%- render 'cart-drawer-contact', section: section -%}

    {%- render 'cart-drawer-discount', section: section, cart_form_id: cart_form_id -%}

    {%- capture summary_markup -%}
      {%- render 'cart-drawer-summary',
        section: section,
        item_word: item_word,
        standard_shipping: standard_shipping,
        tier_1_reached: tier_1_reached,
        rows: 'all'
      -%}
    {%- endcapture -%}

    {%- unless summary_in_footer -%}
      {{ summary_markup }}
    {%- endunless -%}

    <div slot="footer">
      <form action="{{ routes.cart_url }}" id="{{ cart_form_id }}" class="cart-drawer__footer" method="POST">
        <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
        <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

        {%- if section.settings.show_cart_note -%}
          {%- assign cart_note_dialog_id = 'cart-note-' | append: section.id -%}

          <button type="button" class="cart-drawer__note-toggle" aria-controls="{{ cart_note_dialog_id }}">
            {{- 'cart.general.add_order_note' | t -}}
          </button>

          <cart-note-dialog id="{{ cart_note_dialog_id }}" class="cart-drawer__order-note">
            <div class="form">
              <cart-note class="form-control">
                {%- assign order_note = 'cart.general.order_note' | t -%}
                {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                {%- render 'input',
                  name: 'note',
                  multiline: 3,
                  label: order_note,
                  value: cart.note,
                  placeholder: placeholder,
                  show_label_as_block: true
                -%}
              </cart-note>

              <dialog-close-button class="contents">
                <button type="button" class="button">{{ 'cart.general.save_note' | t }}</button>
              </dialog-close-button>
            </div>
          </cart-note-dialog>
        {%- endif -%}

        {%- if summary_in_footer -%}
          {%- assign footer_rows = 'total' -%}
          {%- if sticky_style == 'shipping_total' -%}
            {%- assign footer_rows = 'shipping_total' -%}
          {%- endif -%}

          {%- render 'cart-drawer-summary',
            section: section,
            item_word: item_word,
            standard_shipping: standard_shipping,
            tier_1_reached: tier_1_reached,
            rows: footer_rows
          -%}
        {%- endif -%}

        {%- if section.settings.show_savings and total_savings > 0 -%}
          {%- capture savings_amount_html -%}<strong>{%- render 'money-round', amount: total_savings -%}</strong>{%- endcapture -%}
          <p class="cart-drawer__savings">
            {{- section.settings.savings_text | replace: '[amount]', savings_amount_html -}}
          </p>
        {%- endif -%}

        <div class="button-group cart-drawer__actions">
          {%- if section.settings.show_view_cart_button or section.settings.show_checkout_button == false -%}
            {%- assign view_cart = 'cart.general.view_cart' | t -%}
            {%- render 'button', href: routes.cart_url, content: view_cart, style: 'outline', stretch: true -%}
          {%- endif -%}

          {%- if section.settings.show_checkout_button -%}
            {%- liquid
              assign show_price_in_button = section.settings.show_price_in_checkout_button
              if sticky_style == 'savings_price'
                assign show_price_in_button = true
              endif
            -%}

            {%- capture checkout_button -%}
              {{- 'cart.general.checkout' | t -}}
              {%- if show_price_in_button -%}
                <span class="cart-drawer__button-price">{%- render 'money-round', amount: cart.total_price -%}</span>
              {%- endif -%}
            {%- endcapture -%}

            {%- render 'button', type: 'submit', content: checkout_button, name: 'checkout', stretch: true -%}
          {%- endif -%}
        </div>

        {%- if sticky_style == 'full' -%}
          {%- render 'cart-drawer-service-list', section: section -%}
        {%- endif -%}

      </form>
    </div>
  {%- endif -%}
</cart-drawer>

