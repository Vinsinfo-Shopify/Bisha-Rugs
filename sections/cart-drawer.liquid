    },
    {
      "type": "select",
      "id": "usp_1_icon",
      "label": "Item 1 icon",
      "options": [
        { "value": "picto-delivery-truck", "label": "Delivery truck" },
        { "value": "picto-return", "label": "Return" },
        { "value": "picto-shield", "label": "Shield" },
