{%- if section.blocks.size > 0 -%}
  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  {%- comment -%}
    Grid layout is opt-in via desktop_layout = "grid". Existing sections
    default to "carousel" and render through the original, untouched
    carousel/stack markup further down — nothing already using this
    section changes.

    IMPORTANT: "stack_on_mobile" is now the single source of truth for
    mobile, in BOTH layout modes. If it's checked, mobile always renders
    as a single column — even when desktop_layout = grid. The grid's own
    "items_per_row" only takes effect at the desktop breakpoint (700px+).
  {%- endcomment -%}
  {%- assign is_grid = false -%}
  {%- if section.settings.desktop_layout == 'grid' -%}
    {%- assign is_grid = true -%}
  {%- endif -%}

  {%- comment -%} Effective mobile column count: stack_on_mobile always wins. {%- endcomment -%}
  {%- assign mobile_cols = section.settings.mobile_columns -%}
  {%- if section.settings.stack_on_mobile -%}
    {%- assign mobile_cols = 1 -%}
  {%- endif -%}

  {%- assign desktop_cols = section.settings.items_per_row | at_most: section.blocks.size -%}

  {%- if is_grid -%}
    {%- comment -%}
      Self-namespaced class + !important guards: this does not reuse
      "text-with-icons" / "text-with-icons--stacked", so it can't be
      overridden or partially overridden by the theme's existing compiled
      CSS for those classes.
    {%- endcomment -%}
    <style>
      #shopify-section-{{ section.id }} .twi-grid {
        display: grid !important;
        grid-template-columns: repeat({{ mobile_cols }}, minmax(0, 1fr)) !important;
        column-gap: 76px;
        row-gap: 46px;
      }

      #shopify-section-{{ section.id }} .twi-grid .text-with-icons__item {
        width: 100% !important;
        flex: none !important;
      }
      @media screen and (max-width: 768px){
          #shopify-section-{{ section.id }} .twi-grid {
            column-gap: 30px;
            row-gap: 48px;
        }
      }
      @media screen and (min-width: 700px) {
        #shopify-section-{{ section.id }} .twi-grid {
          grid-template-columns: repeat({{ desktop_cols }}, minmax(0, 1fr)) !important;
        }
      }
    </style>
  {%- endif -%}

  <div class="section-spacing section-spacing--tight color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %} {{ section.settings.custom_class | escape }}">
    <div class="container">
      <div class="v-stack gap-6 inner_container">

        {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
          {%- render 'section-header',
            subheading: section.settings.subheading,
            heading: section.settings.heading,
            heading_style: section.settings.heading_style,
            text_alignment: 'center'
          -%}
        {%- endif -%}

        {%- capture section_content -%}
          {%- for block in section.blocks -%}
            <div class="text-with-icons__item {% if forloop.first %}is-selected{% endif %} {% unless section.settings.stack_on_mobile or is_grid %}snap-center{% endunless %}" role="group" aria-label="{{ 'general.accessibility.item_nth_of_count' | t: index: forloop.index, count: section.blocks.size }}" {{ block.shopify_attributes }}>
              <div class="v-stack gap-8 icon_with_text_container justify-items-center sm:justify-items-{{ section.settings.text_alignment }}">
                {%- liquid
                  assign loading_strategy = nil

                  if section.index <= 3 and forloop.position <= 3
                    assign loading_strategy = 'eager'
                  endif
                -%}

                {%- if block.settings.custom_icon != blank -%}
                  {%- capture sizes -%}{{ block.settings.icon_width }}px{%- endcapture -%}
                  {%- capture widths -%}{{ block.settings.icon_width }}, {{ block.settings.icon_width | times: 2 | at_most: block.settings.custom_icon.width }}{%- endcapture -%}
                  {%- capture style -%}--image-mobile-max-width: {{ block.settings.mobile_icon_width }}px; --image-max-width: {{ block.settings.icon_width }}px{%- endcapture -%}
                  {{- block.settings.custom_icon | image_url: width: block.settings.custom_icon.width | image_tag: loading: loading_strategy, sizes: sizes, widths: widths, class: 'constrained-image', style: style -}}
                {%- else -%}
                  <div style="{% render 'surface', text_color: section.settings.icon_color %}">
                    {%- render 'icon' with block.settings.icon, width: block.settings.mobile_icon_width, class: 'sm:hidden' -%}
                    {%- render 'icon' with block.settings.icon, width: block.settings.icon_width, class: 'hidden sm:block' -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank or block.settings.content != blank -%}
                  <div class="v-stack gap-2 icon_with_text_inner_container text-center sm:text-{{ section.settings.text_alignment }}">
                    {%- if block.settings.title != blank -%}
                      <p class="h6 icon_with_text_title">{{ block.settings.title }}</p>
                    {%- endif -%}

                    {%- if block.settings.content != blank -%}
                      <div class="prose">
                        {{- block.settings.content -}}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endcapture -%}

        {%- if is_grid -%}
          <div class="twi-grid" role="region" style="{% render 'surface', text_color: section.settings.text_color %}">
            {{- section_content -}}
          </div>
        {%- elsif section.settings.stack_on_mobile -%}
          <div class="text-with-icons text-with-icons--stacked" role="region" style="{% render 'surface', text_color: section.settings.text_color %}">
            {{- section_content -}}
          </div>
        {%- else -%}
          {%- assign carousel_id = 'text-with-icons-' | append: section.id -%}

          <text-with-icons-carousel
            disabled-on="sm"
            allow-swipe
            id="{{ carousel_id }}"
            class="text-with-icons full-bleed sm:unbleed"
            role="region"
            style="{% render 'surface', text_color: section.settings.text_color %}"
          >
            {{- section_content -}}
          </text-with-icons-carousel>

          {%- if section.blocks.size > 1 -%}
            <carousel-navigation aria-controls="{{ carousel_id }}" class="page-dots sm:hidden">
              {%- for i in (1..section.blocks.size) -%}
                <button class="tap-area" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                </button>
              {%- endfor -%}
            </carousel-navigation>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
